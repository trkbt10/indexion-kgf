kgf 0.6
language: css
sources: .css

=== lex
SKIP           /(\s+|\/\*[^*]*\*+([^\/*][^*]*\*+)*\/)+/
TOKEN AT_IMPORT   /@import\b/
TOKEN AT_MEDIA    /@media\b/
TOKEN AT_SUPPORTS /@supports\b/
TOKEN AT_KEYFRAMES /@keyframes\b/
TOKEN IMPORTANT   /!important\b/
TOKEN URLFN       /url(?=\()/
TOKEN LPAREN      /\(/
TOKEN RPAREN      /\)/
TOKEN SEMI        /;/
TOKEN COLON       /:/
TOKEN DOT         /\./
TOKEN HEXCOLOR    /#[0-9A-Fa-f]{3,8}\b/
TOKEN HASH        /#/
TOKEN FUNCTION    /[A-Za-z_-][A-Za-z0-9_-]*(?=\()/
TOKEN Ident       /[A-Za-z_-][A-Za-z0-9_-]*/
TOKEN StringLit   /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/
TOKEN NumberLit   /(?:0|[1-9][0-9]*)(?:\.[0-9]+)?/
TOKEN LBRACE      /\{/
TOKEN RBRACE      /\}/
TOKEN COMMA       /,/
TOKEN LBRACKET    /\[/
TOKEN RBRACKET    /\]/
# Selector combinators and attribute-selector operators (`a[href^="http"]`,
# `ul > li`, `h1 + p`, `a ~ b`), the `/` that separates values in shorthand
# properties (`font: 12px/1.5`), and the `*` universal selector. Without
# these the lexer dropped the characters silently and the parse saw a
# different stylesheet than the one on disk.
TOKEN MATCHOP     /[~^|$*]=/
TOKEN COMBINATOR  /[>+~]/
TOKEN SLASH       /\//
TOKEN STAR        /\*/
TOKEN AMP         /&/

=== grammar
# Every top-level construct, ending in `Other` so the stylesheet rule
# consumes any token the structural rules cannot classify and the parse
# never stops part-way through a file.
Stylesheet    -> ( ImportRule / Rule / AtBlock / Other )*

# Any single token kind declared in `=== lex`. `Other` used to be a *run* of
# tokens that included RBRACE, which meant a rule body could swallow its own
# closing brace; it is one token at a time here, and the block rules below
# own their braces.
Other         -> AT_IMPORT / AT_MEDIA / AT_SUPPORTS / AT_KEYFRAMES
               / IMPORTANT / URLFN / LPAREN / RPAREN / SEMI / COLON / DOT
               / HEXCOLOR / HASH / FUNCTION / Ident / StringLit / NumberLit
               / LBRACE / RBRACE / COMMA / LBRACKET / RBRACKET
               / MATCHOP / COMBINATOR / SLASH / STAR / AMP

# `@import "a.css";` / `@import url(a.css);` / `@import url("a.css") screen;`
# The path is captured on ImportRule itself: labels bound inside a child rule
# (the old `String -> path:StringLit`) never reach the parent, so the import
# edge resolved an empty path and pointed at the bare fallback prefix.
ImportRule    -> AT_IMPORT ( URLFN LPAREN path:UrlInner RPAREN / path:StringLit ) MediaQuery? SEMI?
UrlInner      -> StringLit / Ident
MediaQuery    -> ( !SEMI !LBRACE !RBRACE Other )+

# A style rule: selectors, then a brace-delimited body. The body is any run
# of tokens that is not a brace, plus whole nested blocks, so a declaration
# (`font-family: sans-serif;`, which contains COLON) and nesting both fit.
Rule          -> SelectorList Block
Block         -> LBRACE BlockBody RBRACE
BlockBody     -> ( Block / !LBRACE !RBRACE Other )*

# An at-rule that takes a block (`@media`, `@supports`, `@keyframes`): its
# prelude runs up to the opening brace, and the block may contain whole
# style rules.
AtBlock       -> ( AT_MEDIA / AT_SUPPORTS / AT_KEYFRAMES ) Prelude Block
Prelude       -> ( !LBRACE !SEMI !RBRACE Other )*

SelectorList  -> Selector ( COMMA Selector )*
# A selector is a run of simple selectors, combinators, pseudo-classes
# (`:hover`, `::after`) and attribute selectors (`[href^="http"]`).
Selector      -> ( ClassSel / IdSel / AttrSel / PseudoSel / Ident / STAR
                 / COMBINATOR / AMP )+
AttrSel       -> LBRACKET ( !RBRACKET Other )* RBRACKET
PseudoSel     -> COLON COLON? ( FUNCTION LPAREN ( !RPAREN Other )* RPAREN / Ident )
ClassSel      -> DOT name:Ident
IdSel         -> HASH name:Ident

=== attrs
on ImportRule:  import module=path
on ClassSel:    def name kind=Class ns=value
on IdSel:       def name kind=Id ns=value

=== semantics
on ImportRule {
  edge moduleDependsOn from $file to $resolve($path) attrs obj("via", $path, "dep_kind", "import")
}

=== resolver
relative_prefixes: ./, ../, /
module_path_style: slash
resolve:
  - index: /index.css
  - ext: .css
  - fallback: url:
