kgf 0.6
language: gitlab-wiki
sources: .md
extends: github-wiki

# A GitLab wiki page is a GitHub wiki page with different conventions for its
# special files: the two hosts agree on the markup (`[[WikiLink]]`,
# `[md](link)`, `<!-- indexion: -->` metadata) and disagree only on which
# filenames are the sidebar and the home page, and on their casing. The lex,
# grammar, attrs, semantics and ignore sections are therefore inherited from
# `github-wiki` unchanged; only the two sections that carry those filenames
# are declared here.
#
# GitLab has no footer page, so `footer_file` is simply absent from this
# spec's `=== features` — a derived section replaces the base's whole, so
# leaving the key out is what drops it.

=== features
content_type: document
section_token: HEADING
heading_text_tokens: TEXT, INLINE_CODE
reference_token_kinds: INLINE_CODE
coverage_token_kinds: INLINE_CODE, TEXT
vocabulary_token_kinds: TEXT, INLINE_CODE
embedded_code_fence: CODE_FENCE
embedded_content_token: TEXT
nav_file: _sidebar.md
home_file: home.md
special_files: _sidebar.md

=== resolver
relative_prefixes: ./, ../, /
exts: .md, .markdown
indexes: /home.md
bare_prefix: url:
module_path_style: slash
