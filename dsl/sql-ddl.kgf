kgf 0.6
language: sql-ddl
sources: .sql

=== lex
SKIP /[ \t\r\n]+/

# Comments - skip them
SKIP /--[^\r\n]*/
SKIP /\/\*[\s\S]*?\*\//

# String literals
TOKEN StringLit /'(?:[^'\\]|\\.)*'/

# Numeric literals
TOKEN NumberLit /[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/

# DDL Keywords
KEYWORD KW_CREATE /\bCREATE\b/i
KEYWORD KW_TABLE /\bTABLE\b/i
KEYWORD KW_CONSTRAINT /\bCONSTRAINT\b/i
KEYWORD KW_PRIMARY /\bPRIMARY\b/i
KEYWORD KW_FOREIGN /\bFOREIGN\b/i
KEYWORD KW_KEY /\bKEY\b/i
KEYWORD KW_REFERENCES /\bREFERENCES\b/i
KEYWORD KW_UNIQUE /\bUNIQUE\b/i
KEYWORD KW_NOT /\bNOT\b/i
KEYWORD KW_NULL /\bNULL\b/i
KEYWORD KW_DEFAULT /\bDEFAULT\b/i
KEYWORD KW_ON /\bON\b/i
KEYWORD KW_DELETE /\bDELETE\b/i
KEYWORD KW_UPDATE /\bUPDATE\b/i
KEYWORD KW_CASCADE /\bCASCADE\b/i
KEYWORD KW_RESTRICT /\bRESTRICT\b/i
KEYWORD KW_SET /\bSET\b/i
KEYWORD KW_NO /\bNO\b/i
KEYWORD KW_ACTION /\bACTION\b/i

# Type Keywords
TOKEN KeywordType /\b(?:INT|INTEGER|BIGINT|SMALLINT|TINYINT|DECIMAL|NUMERIC|FLOAT|REAL|DOUBLE|PRECISION|CHAR|VARCHAR|TEXT|NCHAR|NVARCHAR|NTEXT|BINARY|VARBINARY|BLOB|CLOB|DATE|TIME|TIMESTAMP|DATETIME|INTERVAL|BOOLEAN|BOOL|BIT|UUID|JSON|JSONB|XML|ARRAY|SERIAL|BIGSERIAL)\b/i

# Quoted identifiers
TOKEN QuotedIdent /"[^"]+"/
TOKEN BacktickIdent /`[^`]+`/
TOKEN BracketIdent /\[[^\]]+\]/

# Regular identifiers (must come after keywords)
TOKEN Ident /[a-zA-Z_][a-zA-Z0-9_]*/

# Punctuation. DOT is a token of its own because SQL qualifies names with it
# (`schema.table`, `t.col`, `u.*`); without it the lexer dropped every `.` in
# a query as unrecognized input and the parse silently saw a different
# statement than the one on disk.
TOKEN LPAREN /\(/
TOKEN RPAREN /\)/
TOKEN COMMA /,/
TOKEN SEMICOLON /;/
TOKEN DOT /\./

# Operators (for default values, etc.)
TOKEN Operator /[+\-*\/%=<>!&|^~:]+/

=== grammar
Doc -> Statement*
Statement -> CreateTableStmt / OtherStmt

# The header is a rule of its own so its event fires BEFORE the constraints
# inside the body: events fire bottom-up (children first), so a foreign key
# nested in the body would otherwise have no way to learn which table it
# belongs to. The header binds the table name into scope; the FK rule reads
# it back.
CreateTableStmt -> CreateTableHeader LPAREN ColumnDefList RPAREN SEMICOLON?
CreateTableHeader -> KW_CREATE KW_TABLE tableName:TableName

TableName -> QuotedIdent / BacktickIdent / BracketIdent / Ident

ColumnDefList -> ColumnDef ( COMMA ColumnDef )*

ColumnDef -> InlineConstraint / ColumnWithType

# Every label the semantics read is bound HERE, on the rule whose event the
# semantics handle. A label bound inside a child rule (`ColType`,
# `PrimaryKeyInline`, ...) never reaches the parent event, so the column's
# type, its PK / NOT NULL / UNIQUE flags and its inline REFERENCES target
# were all silently absent from every hasColumn edge.
# The column's type and its inline constraints are spelled out here rather
# than delegated to sub-rules, because a label bound inside a child rule
# never reaches the parent's event: with `colType:ColType` and
# `PrimaryKeyInline -> isPK:KW_PRIMARY ...` the semantics below saw no type,
# no flags and no inline REFERENCES target at all, and every hasColumn edge
# carried none of them.
# The constraint alternatives are written inline rather than behind a
# `ColumnConstraint` rule so their labels are bound on ColumnWithType, whose
# event the semantics handle.
ColumnWithType -> colName:ColName colTypeName:KeywordType TypeArgs?
                  ( isPK:KW_PRIMARY KW_KEY
                  / isNotNull:KW_NOT KW_NULL
                  / isUnique:KW_UNIQUE
                  / DefaultInline
                  / KW_REFERENCES inlineRefTable:TableName LPAREN inlineRefCol:ColName RPAREN OnDeleteClause? OnUpdateClause?
                  )*

TypeArgs -> LPAREN TypeParams RPAREN
TypeParams -> NumberLit ( COMMA NumberLit )*

ColName -> QuotedIdent / Ident

DefaultInline -> KW_DEFAULT DefaultValue
DefaultValue -> StringLit / NumberLit / Ident / LPAREN DefaultExpr RPAREN
DefaultExpr -> ( Ident / StringLit / NumberLit / Operator / COMMA )*

# Table-level constraints
InlineConstraint -> KW_CONSTRAINT constraintName:ConstraintName ConstraintBody

ConstraintName -> QuotedIdent / Ident

ConstraintBody -> PrimaryKeyConstraint / ForeignKeyConstraint / UniqueConstraint

PrimaryKeyConstraint -> KW_PRIMARY KW_KEY LPAREN pkCol:ColName ( COMMA ColName )* RPAREN

ForeignKeyConstraint -> KW_FOREIGN KW_KEY LPAREN fkCol:ColName ( COMMA ColName )* RPAREN KW_REFERENCES refTable:TableName LPAREN refCol:ColName ( COMMA ColName )* RPAREN OnDeleteClause? OnUpdateClause?

UniqueConstraint -> KW_UNIQUE LPAREN uniqueCol:ColName ( COMMA ColName )* RPAREN

OnDeleteClause -> KW_ON KW_DELETE FKAction
OnUpdateClause -> KW_ON KW_UPDATE FKAction
FKAction -> KW_CASCADE / KW_RESTRICT / KW_SET KW_NULL / KW_NO KW_ACTION

# Other statements (skip processing). The terminating semicolon is optional:
# the last statement of a script often has none, and requiring it stopped the
# parse at the start of that statement, dropping it and everything the
# semantics would have read from it. A lone semicolon is a statement too, so
# `Doc -> Statement*` always makes progress and never loops.
OtherStmt -> ( Token )+ SEMICOLON? / SEMICOLON
Token -> StringLit / NumberLit / QuotedIdent / BacktickIdent / BracketIdent / KeywordType / Ident / LPAREN / RPAREN / COMMA / DOT / Operator / KW_CREATE / KW_TABLE / KW_CONSTRAINT / KW_PRIMARY / KW_FOREIGN / KW_KEY / KW_REFERENCES / KW_UNIQUE / KW_NOT / KW_NULL / KW_DEFAULT / KW_ON / KW_DELETE / KW_UPDATE / KW_CASCADE / KW_RESTRICT / KW_SET / KW_NO / KW_ACTION

=== attrs
on CreateTableHeader: def id=tableName kind=Table
on ColumnWithType: def id=colName kind=Column

=== semantics
# Fires before anything in the table body, so the table name is in scope for
# the foreign keys declared inside it.
on CreateTableHeader {
  let tbl = stripQuotes($tableName)
  module tbl file file
  bind ns "table" name "current" to tbl
}

# A table-level foreign key. Its own rule declares the edge, because a table
# may declare several of them and a label bound once on the enclosing
# statement could only carry the last one.
on ForeignKeyConstraint {
  let tbl = $scope("table", "current")
  let fk = stripQuotes($fkCol)
  let ref = stripQuotes($refTable)
  let refC = stripQuotes($refCol)
  edge tableReferences from tbl to ref attrs obj("fkColumn", fk, "refColumn", refC)
}

on ColumnWithType {
  let col = stripQuotes($colName)
  let typ = $colTypeName
  let pk = $isPK
  let nn = $isNotNull
  let uq = $isUnique
  let inRef = $inlineRefTable
  let inRefC = $inlineRefCol
  edge hasColumn from file to col attrs obj("type", typ, "isPK", pk, "isNotNull", nn, "isUnique", uq, "refTable", inRef, "refCol", inRefC)
}

=== resolver
relative_prefixes: ./
exts: .sql
indexes:
bare_prefix:
module_path_style: slash
