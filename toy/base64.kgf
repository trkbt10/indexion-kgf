kgf 0.6
language: base64

=== features
# Toy specs are format-specific experiments (a PNG hex dump, a base64 JPEG,
# a law text), not general readers for an extension. Every one of them shared
# its extension with a sibling — `.b64` with five others, `.hex` with one,
# `.txt` with seven — so auto-detection picked a winner by registration order
# and decoded every matching file with it: `logo.png.hex` was read by the
# JPEG spec and yielded nothing at all.
#
# No toy spec is the sole owner of an extension, so none of them claims one:
# `sources:` is absent and `detection_scope: overlay` marks the spec as
# selected explicitly (`--spec=<name>`). Dropping the claim is what makes the
# choice deterministic — an overlay that is the only claimant of a pattern
# would still be assigned it, and the winner would still depend on load
# order.
detection_scope: overlay

=== lex
# Tolerate whitespace in encoded blobs.
SKIP /\\s+/

# Base64 alphabet (user-requested): a-zA-Z0-9_/
TOKEN B64_CHAR /[A-Za-z0-9_\/]/

# Padding (standard base64 uses '='). Keep as a separate token for highlighting.
TOKEN PAD /=/

=== grammar
Doc -> Item*
Item -> Quad / Tail / Other

# Common structure: 4 base64 chars form a quartet.
Quad -> B64_CHAR B64_CHAR B64_CHAR B64_CHAR

# Tail with padding.
Tail -> B64_CHAR B64_CHAR PAD PAD / B64_CHAR B64_CHAR B64_CHAR PAD

# Fallback to keep progress.
Other -> B64_CHAR / PAD

=== attrs
# none

=== resolver
relative_prefixes:
exts: .b64, .base64, .txt
indexes:
bare_prefix:
module_path_style: slash

