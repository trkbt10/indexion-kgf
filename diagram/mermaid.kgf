kgf 0.6
language: mermaid
sources: .mmd, .mermaid

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments
SKIP /%%[^\r\n]*/

# Diagram type keywords (case-insensitive)
KEYWORD KW_flowchart /\b(?:flowchart|graph)\b/i
KEYWORD KW_sequenceDiagram /\bsequenceDiagram\b/
KEYWORD KW_classDiagram /\bclassDiagram(?:-v2)?\b/
KEYWORD KW_stateDiagram /\bstateDiagram(?:-v2)?\b/
KEYWORD KW_erDiagram /\berDiagram\b/
KEYWORD KW_gantt /\bgantt\b/
KEYWORD KW_pie /\bpie\b/
KEYWORD KW_mindmap /\bmindmap\b/
KEYWORD KW_gitGraph /\bgitGraph\b/
KEYWORD KW_journey /\bjourney\b/
KEYWORD KW_timeline /\btimeline\b/
KEYWORD KW_quadrantChart /\bquadrantChart\b/
KEYWORD KW_requirementDiagram /\brequirementDiagram\b/
KEYWORD KW_C4Context /\bC4Context\b/
KEYWORD KW_block /\bblock-beta\b/

# Structural keywords
KEYWORD KW_subgraph /\bsubgraph\b/
KEYWORD KW_end /\bend\b/
KEYWORD KW_direction /\bdirection\b/
KEYWORD KW_participant /\bparticipant\b/
KEYWORD KW_actor /\bactor\b/
KEYWORD KW_class /\bclass\b/
KEYWORD KW_state /\bstate\b/
KEYWORD KW_note /\bnote\b/
KEYWORD KW_section /\bsection\b/
KEYWORD KW_title /\btitle\b/
KEYWORD KW_click /\bclick\b/
KEYWORD KW_style /\bstyle\b/
KEYWORD KW_classDef /\bclassDef\b/
KEYWORD KW_linkStyle /\blinkStyle\b/

# Sequence diagram keywords
KEYWORD KW_activate /\bactivate\b/
KEYWORD KW_deactivate /\bdeactivate\b/
KEYWORD KW_loop /\bloop\b/
KEYWORD KW_alt /\balt\b/
KEYWORD KW_else /\belse\b/
KEYWORD KW_opt /\bopt\b/
KEYWORD KW_par /\bpar\b/
KEYWORD KW_and /\band\b/
KEYWORD KW_critical /\bcritical\b/
KEYWORD KW_break /\bbreak\b/
KEYWORD KW_rect /\brect\b/
KEYWORD KW_autonumber /\bautonumber\b/

# Class diagram keywords
KEYWORD KW_namespace /\bnamespace\b/

# Gantt keywords
KEYWORD KW_dateFormat /\bdateFormat\b/
KEYWORD KW_axisFormat /\baxisFormat\b/
KEYWORD KW_excludes /\bexcludes\b/
KEYWORD KW_todayMarker /\btodayMarker\b/

# ER diagram cardinality. Only the two-character forms are a cardinality:
# a lone `|`, `{`, `}` or `o` is a pipe, a flowchart node brace or an
# identifier, and matching those here (this token is tried before PIPE,
# CurlyOpen/CurlyClose and Ident) turned `-->|Yes|` edge labels and any node
# named `o` into cardinalities.
TOKEN Cardinality /\|\||\}o|o\{|\}\{|\}\||\|\{|\{\||\|o|o\|/

# Flowchart edges (ordered: longest match first)
TOKEN ThickArrow /==>|===/
TOKEN DottedArrow /-.->|-\.-/
TOKEN Arrow /-->|---|\|->|\|--/
TOKEN SimpleArrow /-->/
TOKEN LinkText /--\s*[^\r\n|>-]+\s*-->/

# Node shapes
TOKEN RoundOpen /\(/
TOKEN RoundClose /\)/
TOKEN SquareOpen /\[/
TOKEN SquareClose /\]/
TOKEN CurlyOpen /\{/
TOKEN CurlyClose /\}/
TOKEN DiamondOpen /\{\{/
TOKEN DiamondClose /\}\}/
TOKEN StadiumOpen /\(\[/
TOKEN StadiumClose /\]\)/
TOKEN SubroutineOpen /\[\[/
TOKEN SubroutineClose /\]\]/
TOKEN CylinderOpen /\[\(/
TOKEN CylinderClose /\)\]/
TOKEN TrapezoidOpen /\[\\/
TOKEN TrapezoidClose /\\\/\]/
TOKEN HexagonOpen /\{\{/
TOKEN HexagonClose /\}\}/

# Sequence diagram arrows
TOKEN SeqArrowSolid /->>/
TOKEN SeqArrowDotted /-->>/
TOKEN SeqArrowCross /-x/i
TOKEN SeqArrowOpen /-\)/

# String literals
TOKEN StringLit /"([^"\\]|\\.)*"/

# Identifiers
TOKEN Ident /[a-zA-Z_][a-zA-Z0-9_]*/

# Numeric literals
TOKEN NumberLit /[0-9]+(?:\.[0-9]+)?/

# Punctuation
TOKEN COLON /:/
TOKEN SEMICOLON /;/
TOKEN COMMA /,/
TOKEN PIPE /\|/
TOKEN DOT /\./
TOKEN HASH /#/
TOKEN TILDE /~/
TOKEN PLUS /\+/
TOKEN MINUS /-/
TOKEN STAR /\*/
TOKEN LT /</
TOKEN GT />/
TOKEN AMP /&/
TOKEN AT /@/

# Catch-all for other text
TOKEN Text /[^\s()[\]{}<>|:;,."#~+\-*&@]+/

=== grammar
# A Mermaid file is a diagram declaration followed by lines. Every line the
# structural rules cannot classify is still consumed, one token at a time, by
# AnyToken at the end of the Line alternatives: the parse must never stop, or
# everything after the first unusual line is silently dropped.
Doc -> DiagramDecl? NL? Block*
Block -> (Line NL?) / NL

DiagramDecl -> FlowchartDecl / SequenceDecl / ClassDecl / StateDecl
             / ErDecl / GanttDecl / PieDecl / MindmapDecl / GitGraphDecl
             / JourneyDecl / TimelineDecl / OtherDecl

FlowchartDecl  -> diagramType:KW_flowchart DirectionSpec?
SequenceDecl   -> diagramType:KW_sequenceDiagram
ClassDecl      -> diagramType:KW_classDiagram
StateDecl      -> diagramType:KW_stateDiagram
ErDecl         -> diagramType:KW_erDiagram
GanttDecl      -> diagramType:KW_gantt
PieDecl        -> diagramType:KW_pie
MindmapDecl    -> diagramType:KW_mindmap
GitGraphDecl   -> diagramType:KW_gitGraph
JourneyDecl    -> diagramType:KW_journey
TimelineDecl   -> diagramType:KW_timeline
OtherDecl      -> diagramType:Ident

DirectionSpec  -> direction:Ident

Line -> SubgraphLine / EndLine / ParticipantLine / EdgeLine / AnonEdgeLine
      / ClickLine / StyleLine / ClassDefLine / DirectiveLine / ContentLine
      / AnyToken

# Flowchart subgraph
SubgraphLine -> KW_subgraph sgName:NodeIdent Shape? sgLabel:TextLike?
EndLine      -> KW_end

# Sequence diagram participant
ParticipantLine -> (KW_participant / KW_actor) pName:NodeIdent (KW_class pAlias:NodeIdent)?

# Edge definitions (flowchart, state, class, ER).
# A node is a name plus an optional shape suffix (`A[Start]`, `B{Decision}`),
# and in state diagrams the start/end marker `[*]` stands in for the name, so
# the shape may also appear on its own. The operator is a run of link tokens:
# ER relationships (`||--o{`) and class relationships (`<|--`) lex as several
# tokens each, and a flowchart edge label (`-->|Yes|`) trails the operator.
# Labels do not propagate from a child rule to its parent, so the node names
# are captured on EdgeLine itself; a nested `Node` rule would only hand the
# semantics the node's LAST token (the closing bracket of `A[Start]`).
# The anonymous-node form covers the state-diagram marker `[*]`, which has a
# shape but no name.
EdgeLine -> srcNode:NodeIdent Shape? EdgeOp dstNode:NodeIdent Shape? edgeLabel:TextLike?

# An edge with an anonymous endpoint: the state-diagram start/end marker
# `[*]` is a shape with no name. It is a separate rule (rather than optional
# labels on EdgeLine) so the EdgeLine semantics can assume both endpoints
# exist and never build an edge id with an empty half.
AnonEdgeLine -> Shape EdgeOp NodeIdent Shape? TextLike?
              / NodeIdent Shape? EdgeOp Shape TextLike?
              / Shape EdgeOp Shape TextLike?

# One bracketed/parenthesised node label. The inner text is any run of tokens
# that is not the matching close, so labels with punctuation still fit.
Shape -> SquareOpen ShapeBody SquareClose
       / CurlyOpen ShapeBody CurlyClose
       / RoundOpen ShapeBody RoundClose
ShapeBody -> ( !SquareClose !CurlyClose !RoundClose !NL AnyToken )*

# A link operator is at least one link token, optionally followed by an
# inline `|label|`. The parts of the multi-token ER/class operators (MINUS,
# Cardinality, LT, GT, PIPE) are included so those relationships parse.
EdgeOp -> LinkPart+ EdgeLabelPipe?
# DOT is a link part because an ER non-identifying relationship is written
# with dots instead of dashes (`}|..|{`).
LinkPart -> Arrow / DottedArrow / ThickArrow / SimpleArrow / LinkText
          / SeqArrowSolid / SeqArrowDotted / SeqArrowCross / SeqArrowOpen
          / Cardinality / MINUS / LT / GT / DOT
EdgeLabelPipe -> PIPE ( !PIPE !NL AnyToken )* PIPE

# Click interactions (contain URLs or callback references)
ClickLine -> KW_click clickTarget:NodeIdent clickDest:StringLit?

# Style/class definitions
StyleLine    -> KW_style styleTarget:NodeIdent TextLike
ClassDefLine -> KW_classDef defName:Ident TextLike

# Directives (title, dateFormat, etc.)
DirectiveLine -> (KW_title / KW_dateFormat / KW_axisFormat / KW_direction
               / KW_excludes / KW_todayMarker / KW_section / KW_note
               / KW_activate / KW_deactivate / KW_autonumber
               / KW_loop / KW_alt / KW_else / KW_opt / KW_par / KW_critical
               / KW_break / KW_rect / KW_namespace) TextLike?

# Fallback for any other content line
ContentLine  -> Token+
Token        -> StringLit / NumberLit / Ident / Text / COLON / SEMICOLON
             / COMMA / PIPE / DOT / HASH / TILDE / PLUS / MINUS / STAR
             / LT / GT / AMP / AT / RoundOpen / RoundClose / SquareOpen
             / SquareClose / CurlyOpen / CurlyClose

# Every token kind declared in `=== lex` except NL, one at a time. NL is
# excluded so the line-oriented Block loop keeps its line structure.
AnyToken -> Token
          / Cardinality / ThickArrow / DottedArrow / Arrow / SimpleArrow
          / LinkText / SeqArrowSolid / SeqArrowDotted / SeqArrowCross
          / SeqArrowOpen
          / DiamondOpen / DiamondClose / StadiumOpen / StadiumClose
          / SubroutineOpen / SubroutineClose / CylinderOpen / CylinderClose
          / TrapezoidOpen / TrapezoidClose / HexagonOpen / HexagonClose
          / KW_flowchart / KW_sequenceDiagram / KW_classDiagram
          / KW_stateDiagram / KW_erDiagram / KW_gantt / KW_pie / KW_mindmap
          / KW_gitGraph / KW_journey / KW_timeline / KW_quadrantChart
          / KW_requirementDiagram / KW_C4Context / KW_block
          / KW_subgraph / KW_end / KW_direction / KW_participant / KW_actor
          / KW_class / KW_state / KW_note / KW_section / KW_title / KW_click
          / KW_style / KW_classDef / KW_linkStyle
          / KW_activate / KW_deactivate / KW_loop / KW_alt / KW_else
          / KW_opt / KW_par / KW_and / KW_critical / KW_break / KW_rect
          / KW_autonumber / KW_namespace
          / KW_dateFormat / KW_axisFormat / KW_excludes / KW_todayMarker

# A node / entity name. ER entity names are routinely hyphenated
# (`LINE-ITEM`, `DELIVERY-ADDRESS`); the hyphen lexes as MINUS because MINUS
# is also half of every `--` link, so the name is rebuilt here. A single
# MINUS followed by a name continues the identifier, while the `--` of a
# link is two MINUS in a row and is left to EdgeOp.
NodeIdent -> NamePart ( MINUS !MINUS NamePart )*
NamePart  -> Ident / StringLit / Text
TextLike  -> Token+

=== attrs
on FlowchartDecl:  def id=diagramType kind=Diagram
on SequenceDecl:   def id=diagramType kind=Diagram
on ClassDecl:      def id=diagramType kind=Diagram
on StateDecl:      def id=diagramType kind=Diagram
on ErDecl:         def id=diagramType kind=Diagram
on GanttDecl:      def id=diagramType kind=Diagram
on PieDecl:        def id=diagramType kind=Diagram
on MindmapDecl:    def id=diagramType kind=Diagram
on GitGraphDecl:   def id=diagramType kind=Diagram
on JourneyDecl:    def id=diagramType kind=Diagram
on TimelineDecl:   def id=diagramType kind=Diagram
on SubgraphLine:   def id=sgName_text kind=Subgraph
on ParticipantLine: def id=pName_text kind=Participant
on EdgeLine:       ref srcNode_text ref dstNode_text

=== features
content_type: diagram
identifier_kinds: Ident
coverage_token_kinds: Ident, Text, StringLit
vocabulary_token_kinds: Ident, Text, StringLit

=== semantics
# A plain `$label` is only the LAST token the label matched, so a hyphenated
# name such as `LINE-ITEM` (which lexes as Ident MINUS Ident) would come out
# as `ITEM`. `$label_text` is the accumulated text of everything the label
# matched, which is the whole name.
on SubgraphLine {
  let name = $sgName_text
  edge declares from $file to concat($file, "::", name) attrs obj("name", name, "kind", "Subgraph")
}

on ParticipantLine {
  let name = $pName_text
  edge declares from $file to concat($file, "::", name) attrs obj("name", name, "kind", "Participant")
}

# EdgeLine always has both endpoints; edges touching the anonymous `[*]`
# marker match AnonEdgeLine instead and declare no reference, because one of
# their endpoints has no name to point at.
on EdgeLine {
  let src = $srcNode_text
  let dst = $dstNode_text
  edge references from concat($file, "::", src) to concat($file, "::", dst) attrs obj("src", src, "dst", dst)
}

on ClickLine when $clickDest {
  let target = $clickTarget_text
  let dest = $clickDest
  edge moduleDependsOn from $file to $resolve(dest) attrs obj("via", dest, "dep_kind", "click")
}

=== resolver
relative_prefixes: ./, ../, /, http://, https://
exts: .mmd, .mermaid, .md
indexes:
bare_prefix: url:
module_path_style: slash
