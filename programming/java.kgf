kgf 0.6
language: java
sources: .java

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments
TOKEN DocComment /\/\*\*([\s\S]*?)\*\//
TOKEN BlockComment /\/\*[\s\S]*?\*\//
TOKEN LineComment /\/\/[^\r\n]*/

# String literals
TOKEN String /"([^"\\]|\\.)*"/
TOKEN TextBlock /"""[\s\S]*?"""/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F_]+|0b[01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?[fFdDlL]?/

# Annotations
TOKEN Annotation /@[a-zA-Z_][a-zA-Z0-9_.]*/

# Keywords
KEYWORD KW_package    /package\b/
KEYWORD KW_import     /import\b/
KEYWORD KW_class      /class\b/
KEYWORD KW_interface  /interface\b/
KEYWORD KW_enum       /enum\b/
# `record`, `sealed` and `permits` are CONTEXTUAL keywords: legal identifiers
# elsewhere. They still get tokens, unlike `var`, because a PEG cannot compare
# an identifier's text and the record declaration is otherwise indistinguishable
# from a method — `record User(int id) { }` and `String user(int id) { }` have
# exactly the same token shape, so without a token one of the two is always
# parsed as the other. They are RESTRICTED identifiers in modern Java (they
# cannot name a type), which bounds the cost of the shadowing to a local
# variable or method spelled `record` / `sealed` / `permits`.
KEYWORD KW_record     /record\b/
KEYWORD KW_sealed     /sealed\b/
KEYWORD KW_permits    /permits\b/
KEYWORD KW_extends    /extends\b/
KEYWORD KW_implements /implements\b/
KEYWORD KW_public     /public\b/
KEYWORD KW_private    /private\b/
KEYWORD KW_protected  /protected\b/
KEYWORD KW_static     /static\b/
KEYWORD KW_final      /final\b/
KEYWORD KW_abstract   /abstract\b/
KEYWORD KW_default    /default\b/
KEYWORD KW_void       /void\b/
KEYWORD KW_new        /new\b/
KEYWORD KW_this       /this\b/
KEYWORD KW_super      /super\b/
KEYWORD KW_return     /return\b/
KEYWORD KW_throws     /throws\b/
KEYWORD KW_throw      /throw\b/
KEYWORD KW_try        /try\b/
KEYWORD KW_catch      /catch\b/
KEYWORD KW_finally    /finally\b/
KEYWORD KW_if         /if\b/
KEYWORD KW_else       /else\b/
KEYWORD KW_switch     /switch\b/
KEYWORD KW_case       /case\b/
KEYWORD KW_for        /for\b/
KEYWORD KW_while      /while\b/
KEYWORD KW_do         /do\b/
KEYWORD KW_break      /break\b/
KEYWORD KW_continue   /continue\b/

# Built-in primitive types. These eight ARE reserved words in Java, so giving
# them tokens is safe. `var` is NOT among them: it is a reserved TYPE NAME
# only, and stays a perfectly legal name for a field, parameter, method or
# package — `int var = 1;` compiles. The lexer matches token rules in
# definition order, so listing `var` here shadowed `Ident` everywhere and made
# every such declaration unmatchable. `var` is matched as an ordinary `Ident`
# in type position, which `TypeAtom`'s `QualifiedName` alternative accepts.
TOKEN KeywordType /\b(?:int|byte|short|long|float|double|boolean|char)\b/

# Boolean literals
TOKEN BoolLit /\b(?:true|false)\b/
TOKEN NullLit /\bnull\b/

# Identifiers
TOKEN Ident /[a-zA-Z_$][a-zA-Z0-9_$]*/

# Operators
TOKEN ARROW   /->/
TOKEN DCOLON  /::/
TOKEN LT      /</
TOKEN GT      />/
TOKEN Operator /[+\-*\/%&|^~!=?:]+|&&|\|\||<<|>>|>>>/

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/
TOKEN AT       /@/

=== grammar
Module -> Item*

# Every top-level construct is one of these. `Other` is the catch-all and
# accepts ANY single token, including a lone bracket, so a declaration the
# rules only partially match can never stop the module parse: the leftovers are
# skipped one token at a time and the next declaration is picked up again.
#
# Declarations come before the bare `DocComment` alternative because PEG
# ordered choice takes the first match — a leading `DocComment` alternative
# would swallow the doc that belongs to the declaration below it.
Item -> NL
     / PackageDecl
     / ImportDecl
     / TypeDecl
     / DocComment
     / Other

TypeDecl -> ClassDecl / InterfaceDecl / EnumDecl / RecordDecl / AnnotationTypeDecl

# Package declaration
PackageDecl -> Annotation* NL* KW_package QualifiedName SEMI

# Import declaration
ImportDecl -> KW_import KW_static? path:QualifiedName ( DOT Operator )? SEMI
QualifiedName -> Ident ( DOT Ident )*

# ---------------------------------------------------------------------------
# Declaration metadata
# ---------------------------------------------------------------------------
# Every Java declaration carries the same outer metadata: a Javadoc block,
# annotations and modifiers, each typically on its own line. Real code writes
#
#   @RestController
#   public class UserController { … }
#
# which tokenizes as Annotation NL KW_public. A `( Annotation / Modifier / NL )*`
# group on BOTH sides of the doc block absorbs annotations, modifiers and the
# newlines around them wherever they fall; the doc capture still binds because
# a DocComment is none of those, so the greedy groups never swallow it. Without
# the newline in that group the NL after an annotation broke the rule, the
# declaration fell through to `Other`, and the type — with its whole body —
# was lost.
#
# The metadata is spelled out in each rule rather than factored into a shared
# prefix rule because a label binds only inside the rule that writes it: behind
# an indirection `$doc` and `$vis` would be invisible to the declaration's own
# semantics.
DeclMeta -> Annotation / Modifier / NL

# Class declaration. The header is a rule of its own so that it fires BEFORE
# the class body (PEG matches it to completion first, so its event — and the
# `bind` in its semantics — precedes every member event of the body). That
# binding is what attaches each method, field and nested type to the type it
# belongs to instead of leaving it at file level.
ClassDecl -> ClassHeader ClassBody
ClassHeader -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* KW_class id:Ident TypeParams? ExtendsClause? ImplementsClause? PermitsClause?
ExtendsClause -> KW_extends TypeList
ImplementsClause -> KW_implements TypeList
PermitsClause -> KW_permits TypeList
ClassBody -> LBRACE ClassMember* RBRACE
# The `!RBRACE` guard is essential. The member list ends at the body's closing
# brace, and the trailing catch-all — which must accept any token so a member
# the rules cannot match does not abort the type — would otherwise consume that
# `}` and run to end of file. `ClassBody`'s own `RBRACE` would then never
# match, the type would be dropped, and `Item*` would re-parse the whole body
# at top level: every member declared twice and detached from its type.
ClassMember -> !RBRACE ( NL / LineComment / BlockComment
            / TypeDecl / StaticBlock / ConstructorDecl / MethodDecl / FieldDecl
            / SEMI / MemberOther )
# Inside a body the catch-all must not swallow a brace either: an unbalanced
# one would run past the body's end exactly like `RBRACE` above.
MemberOther -> Atom / LPAREN / RPAREN / LBRACKET / RBRACKET / Body

# Interface declaration — same header/body split. Its body gets member rules of
# its own (`InterfaceMember`, `InterfaceMethodDecl`, `InterfaceFieldDecl`)
# purely so the semantics can tell it apart from a class body: every member of
# an interface is implicitly public even with no modifier written, while a
# class member with no modifier is package-private and must stay unpublished.
InterfaceDecl -> InterfaceHeader InterfaceBody
InterfaceHeader -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* KW_interface id:Ident TypeParams? ExtendsClause? PermitsClause?
InterfaceBody -> LBRACE InterfaceMember* RBRACE
InterfaceMember -> !RBRACE ( NL / LineComment / BlockComment
            / TypeDecl / InterfaceMethodDecl / InterfaceFieldDecl
            / SEMI / MemberOther )
InterfaceMethodDecl -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* TypeParams? Type method_id:Ident LPAREN NL* ParamList? NL* RPAREN ArrayDims? ThrowsClause? ( DefaultValue / Body / SEMI )
InterfaceFieldDecl -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* Type field_id:Ident ArrayDims? ( Operator Expr )? ( COMMA Ident ArrayDims? ( Operator Expr )? )* SEMI

# Annotation type declaration (`public @interface Foo { … }`).
AnnotationTypeDecl -> AnnotationTypeHeader InterfaceBody
AnnotationTypeHeader -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* AT KW_interface id:Ident

# Enum declaration
EnumDecl -> EnumHeader EnumBody
EnumHeader -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* KW_enum id:Ident ImplementsClause?
EnumBody -> LBRACE NL* EnumConstantList? ( SEMI ClassMember* )? NL* RBRACE
EnumConstantList -> EnumConstant ( NL* COMMA NL* EnumConstant )* ( NL* COMMA )? NL*
EnumConstant -> NL* const_meta:DeclMeta* const_doc:DocComment? DeclMeta* const_id:Ident Arguments? ClassBody?

# Record declaration. The component list sits OUTSIDE the header on purpose:
# a record component is a public accessor on the record, and an event fires
# only once its rule has matched to completion — so components parsed inside
# the header would emit their events BEFORE the header published the record,
# and every component would be attributed to the previous type.
RecordDecl -> RecordHeader LPAREN NL* RecordComponents? NL* RPAREN ImplementsClause? RecordBody
RecordHeader -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* KW_record id:Ident TypeParams?
RecordComponents -> RecordComponent ( NL* COMMA NL* RecordComponent )* ( NL* COMMA )?
RecordComponent -> NL* Annotation* NL* Type comp_id:Ident
# A record may be declared with no body at all: `public record User(int id);`
RecordBody -> LBRACE ClassMember* RBRACE / SEMI

# Constructor declaration — a name with no return type, directly followed by a
# parameter list and a body.
ConstructorDecl -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* id:Ident LPAREN NL* ParamList? NL* RPAREN ThrowsClause? Body

# Method declaration
MethodDecl -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* TypeParams? Type method_id:Ident LPAREN NL* ParamList? NL* RPAREN ArrayDims? ThrowsClause? ( DefaultValue / Body / SEMI )
# The default of an annotation-type element: `String value() default "x";`
DefaultValue -> KW_default Expr SEMI

# Field declaration. Several fields may share one type and initializer list.
FieldDecl -> pre:DeclMeta* doc:DocComment? mods:DeclMeta* Type field_id:Ident ArrayDims? ( Operator Expr )? ( COMMA Ident ArrayDims? ( Operator Expr )? )* SEMI

# Static / instance initializer block
StaticBlock -> DeclMeta* Body

# Modifiers. Java's other modifiers (`synchronized`, `native`, `transient`,
# `volatile`, `strictfp`) are reserved words with no token here; they are
# absorbed by `ContextualModifier`, which accepts a bare identifier only where
# another modifier or a declaration keyword actually follows it. A field or
# method NAMED like one of them is therefore left alone for the declaration
# rules, which is why the and-predicate is needed rather than a plain `Ident`.
Modifier -> KW_public / KW_private / KW_protected / KW_static / KW_final / KW_abstract / KW_default / KW_sealed / ContextualModifier
ContextualModifier -> Ident &( ( Ident / Annotation / NL / KW_public / KW_private / KW_protected / KW_static / KW_final / KW_abstract / KW_sealed )* ( KW_class / KW_interface / KW_enum / KW_record ) )

# Parameters
ParamList -> Param ( NL* COMMA NL* Param )* ( NL* COMMA )?
Param -> NL* Annotation* NL* KW_final? Annotation* Type Operator? param_id:Ident ArrayDims?
ThrowsClause -> KW_throws TypeList
Arguments -> LPAREN BodyContent* RPAREN

# Types
TypeParams -> LT NL* TypeParam ( NL* COMMA NL* TypeParam )* NL* GT
TypeParam -> Annotation* Ident ( KW_extends TypeBound )?
TypeBound -> Type ( Operator Type )*
TypeList -> Type ( NL* COMMA NL* Type )*
Type -> Annotation* TypeAtom ArrayDims? Operator?
TypeAtom -> KeywordType / KW_void / QualifiedName TypeArgs? ( DOT Ident TypeArgs? )*
# A type argument may be a wildcard (`<?>`, `<? extends T>`) or the diamond's
# empty list (`new HashMap<>()`).
TypeArgs -> LT NL* TypeArgList? NL* GT
TypeArgList -> TypeArg ( NL* COMMA NL* TypeArg )*
TypeArg -> Operator ( KW_extends / KW_super ) Type / Operator / Type
ArrayDims -> ( LBRACKET RBRACKET )+

# Body — an opaque balanced-bracket group. Nothing inside a method body is part
# of a type's public surface, so its contents only need to be consumed safely,
# with every bracket pair matched so the body ends at the right `}`.
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / Atom

# Expressions — a field initializer or an annotation-element default. Java puts
# array initializers, anonymous classes and lambdas there, so an expression is
# a run of atoms and balanced bracket groups, exactly like a body. Modelling it
# any more precisely only creates new ways to stop the parse. It must NOT
# accept a bare `,` or `;`, which end the field declaration it belongs to.
Expr -> ExprItem+
ExprItem -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / ExprAtom
ExprAtom -> Ident / Number / String / TextBlock / Char / BoolLit / NullLit / KeywordType / KW_new / KW_this / KW_super / KW_void / KW_class / KW_switch / KW_case / KW_if / KW_else / DOT / COLON / DCOLON / ARROW / LT / GT / Operator / Annotation

Atom -> ExprAtom / NL / DocComment / LineComment / BlockComment / KW_package / KW_import / KW_class / KW_interface / KW_enum / KW_record / KW_sealed / KW_permits / KW_extends / KW_implements / KW_public / KW_private / KW_protected / KW_static / KW_final / KW_abstract / KW_default / KW_return / KW_throws / KW_throw / KW_try / KW_catch / KW_finally / KW_for / KW_while / KW_do / KW_break / KW_continue / SEMI / COMMA / AT

# Catch-all: one token of any kind, including a bracket whose partner the
# declaration rules never reached (an `Atom` only accepts balanced groups).
Other -> Atom / LBRACE / RBRACE / LPAREN / RPAREN / LBRACKET / RBRACKET

=== attrs
on ClassHeader:          def id kind=Class doc=doc
on InterfaceHeader:      def id kind=Interface doc=doc
on AnnotationTypeHeader: def id kind=Interface doc=doc
on EnumHeader:           def id kind=Enum doc=doc
on RecordHeader:         def id kind=Record doc=doc
on MethodDecl:           def method_id kind=Method doc=doc
on InterfaceMethodDecl:  def method_id kind=Method doc=doc
on FieldDecl:            def field_id kind=Field doc=doc
on InterfaceFieldDecl:   def field_id kind=Field doc=doc
on ConstructorDecl:      def id kind=Constructor doc=doc
on EnumConstant:         def const_id kind=EnumConstant doc=const_doc
on RecordComponent:      def comp_id kind=RecordComponent
on Param:                def param_id kind=Param

=== features
function_kinds: Method, Constructor
identifier_kinds: Ident
qualifier_separators: DOT, DCOLON
vocabulary_token_kinds: DocComment, String

=== semantics
# Import dependency. Note there is deliberately no `on ImportDecl: import ...`
# line in the `=== attrs` section: an attrs `import` directive emits its own
# moduleDependsOn edge, so having both produced two identical edges per import.
#
# `$path` holds only the LAST token of the dotted name, so `$path_text` — the
# whole accumulated `com.example.model.User` — is what has to be resolved.
#
# Resolution is anchored at the project's SOURCE ROOT, not at the importing
# file's directory. A Java import names a package path from the root of the
# source tree (`com.example.model.User` -> `com/example/model/User.java`), so
# resolving it relative to the importer can never find a sibling package: every
# intra-project import fell back to the `maven:` prefix and the graph had no
# edge between two files of the same project.
#
# That anchoring now lives in the `=== resolver` section, as a `source_roots`
# step naming the layout and the build manifests that mark a module's root —
# which is where a fact about this ecosystem's project layout belongs. So this
# rule is a plain `$resolve` again: the chain does the anchoring, and when
# nothing matches — `java.util.Optional`, `org.springframework.…` — the same
# chain's `fallback: maven:` keeps external imports in their prefixed form.
on ImportDecl {
  edge moduleDependsOn from $file to $resolve($path_text) attrs obj("via", $path_text, "dep_kind", "value")
}

# ---------------------------------------------------------------------------
# Enclosing-type frame
# ---------------------------------------------------------------------------
# A type nested in another type's body belongs to that type, and a declaration
# written AFTER that body belongs to whatever enclosed it — so the enclosing
# type behaves like a stack. `scope push` / `scope pop` are that stack: a bind
# lands in the innermost frame and `$scope` searches frames innermost-first,
# so popping a type's frame re-exposes its enclosing type's binding with no
# bookkeeping of our own.
#
# Events fire bottom-up, so the frame is opened by the HEADER — which matches
# to completion before the body is parsed — and closed by the declaration rule,
# which fires after the whole body. `current_type` holds the innermost type;
# unbound means file level.
#
# The `declares` edge for the type itself is emitted from the same header block,
# BEFORE the push, so `$scope("value", "current_type")` still names the
# ENCLOSING type there — that is the edge's `from`.
#
# Java's default (package-private) visibility is not part of a module's public
# surface, and neither is `private`, so only `public` and `protected` types are
# published. Visibility is read out of the declaration's accumulated metadata
# text, because it may sit on either side of the Javadoc block. The push itself
# is unconditional: an unpublished type still owns its members.
on ClassHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Class", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on ClassHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on InterfaceHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Interface", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on InterfaceHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on AnnotationTypeHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Interface", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on AnnotationTypeHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on EnumHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Enum", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on EnumHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on RecordHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Record", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on RecordHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}

# A declaration rule fires after its own body, which is exactly where that body
# ends, so it closes the frame the header opened.
on ClassDecl { scope pop }
on InterfaceDecl { scope pop }
on AnnotationTypeDecl { scope pop }
on EnumDecl { scope pop }
on RecordDecl { scope pop }

# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------
# Java's default (package-private) visibility is not part of a module's public
# surface, and neither is `private`, so only `public` and `protected` members
# are published. Visibility is read out of the declaration's accumulated
# metadata text, because it may sit on either side of the Javadoc block.
#

# A class member is published only when it says `public` or `protected`: Java's
# default is package-private, which is not part of the module's surface.
on MethodDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $method_id) attrs obj("name", $method_id, "kind", "Method", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

# An interface member is implicitly public with no modifier written at all, so
# it is published unconditionally — except when it explicitly says `private`,
# which Java 9+ allows for helper methods.
on InterfaceMethodDecl when not(containsStr(concat($pre_text, $mods_text), "private")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $method_id) attrs obj("name", $method_id, "kind", "Method", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

on InterfaceFieldDecl when not(containsStr(concat($pre_text, $mods_text), "private")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

on ConstructorDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $id) attrs obj("name", $id, "kind", "Constructor", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

on FieldDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($doc), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

# A record component is a public accessor on the record, and an enum constant a
# public member of the enum: both are part of the type's surface with no
# modifier of their own. The header pushed the type before the body was parsed.
on RecordComponent when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $comp_id) attrs obj("name", $comp_id, "kind", "RecordComponent")
}

on EnumConstant when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $const_id) attrs obj("name", $const_id, "kind", "EnumConstant", "doc", trim($const_doc))
}

=== resolver
relative_prefixes: ./, ../
module_path_style: dot
resolve:
  - manifest: pom.xml @ dependencies
  - manifest: build.gradle @ dependencies
  - manifest: build.gradle.kts @ dependencies
  - marker: pom.xml, build.gradle, build.gradle.kts, settings.gradle, settings.gradle.kts
  # An import names a package path from the root of the SOURCE TREE, not from
  # the importing file, so resolution is anchored there. Maven and Gradle both
  # put that tree at `src/main/java` under the directory holding the build
  # manifest, and the markers below are how that directory is found — in a
  # multi-module build it is the module's own manifest, not the repository's.
  - source_roots: src/main/java @ pom.xml, build.gradle.kts, build.gradle
  - index: /src/main/java
  - ext: .java
  - fallback: maven:
