kgf 0.6
language: clojure
sources: .clj, .cljs, .cljc, .edn

=== lex
SKIP /[ \t,]+/
TOKEN NL /\r?\n+/
TOKEN Comment /;[^\r\n]*/
TOKEN String /"([^"\\]|\\.)*"/
TOKEN Regex /#"([^"\\]|\\.)*"/
TOKEN Number /[+-]?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?[MN]?|[+-]?0x[0-9a-fA-F]+|[+-]?0[0-7]+|[+-]?[0-9]+r[0-9a-zA-Z]+|[0-9]+\/[0-9]+/
KEYWORD KW_require_kw /:require\b/
KEYWORD KW_use_kw     /:use\b/
KEYWORD KW_import_kw  /:import\b/
TOKEN Keyword /:[a-zA-Z_*+!?\-][a-zA-Z0-9_*+!?\-.:]*/
KEYWORD KW_ns /ns\b/
KEYWORD KW_def /def\b/
KEYWORD KW_defn /defn\b/
KEYWORD KW_defmacro /defmacro\b/
KEYWORD KW_defmulti /defmulti\b/
KEYWORD KW_defmethod /defmethod\b/
KEYWORD KW_defprotocol /defprotocol\b/
KEYWORD KW_defrecord /defrecord\b/
KEYWORD KW_deftype /deftype\b/
KEYWORD KW_require /require\b/
KEYWORD KW_use /use\b/
KEYWORD KW_import /import\b/
# A Clojure symbol may be built entirely from operator characters (`=`, `<`,
# `+`, `->`), may carry a namespace (`str/join`, `java.util.UUID/randomUUID`)
# and `&` is itself the rest-argument symbol. The previous classes covered
# only alphanumeric-ish names, so every operator symbol was dropped by the
# lexer and the form around it could not parse.
TOKEN NamespacedSymbol /[a-zA-Z0-9_*+!?<>=&%$.|-]+\/[a-zA-Z0-9_*+!?<>=&%$.|-]+/
TOKEN Symbol /[a-zA-Z_*+!?<>=&%$|-][a-zA-Z0-9_*+!?<>=&%$.:|-]*/
TOKEN LPAREN /\(/
TOKEN RPAREN /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LBRACE /\{/
TOKEN RBRACE /\}/
TOKEN HASH /#/
TOKEN QUOTE /'/
TOKEN BACKTICK /`/
TOKEN TILDE /~/
# A bare `/` is the division symbol; `%`/`%1` are the anonymous-function
# arguments of `#(...)`. Both are ordinary source, not stray characters.
TOKEN SLASH /\//
TOKEN CARET /\^/
TOKEN AT /@/

=== grammar
Module -> Form*
Form -> Ws
     / NsForm
     / DefnDecl / DefMacroDecl / DefMultiDecl / DefMethodDecl
     / DefProtocolDecl / DefRecordDecl / DefTypeDecl / DefDecl
     / Expr
     / Token

# A namespace form spans lines and carries an optional docstring, metadata
# and any number of reference clauses. Without newline handling the whole
# `(ns ...)` form failed, and with it the file's very first form.
NsForm -> LPAREN Ws* KW_ns Ws* ns:Symbol Ws* doc:String? NsBody RPAREN
NsBody -> ( Ws / Meta / RequireForm / UseForm / ImportForm / NsOther )*
# A reference clause this spec does not model (`:gen-class`, `:refer-clojure`)
# is skipped as a balanced form rather than stopping the namespace parse.
NsOther -> LPAREN NsOtherInner* RPAREN / Keyword
NsOtherInner -> NsOther / !LPAREN !RPAREN Token
RequireForm -> LPAREN Ws* ( KW_require_kw / KW_require ) RequireSpecs RPAREN
UseForm -> LPAREN Ws* ( KW_use_kw / KW_use ) UseSpecs RPAREN
ImportForm -> LPAREN Ws* ( KW_import_kw / KW_import ) ImportSpecs RPAREN
RequireSpecs -> ( Ws / RequireSpec / Symbol / Keyword )*
RequireSpec -> LBRACKET Ws* mod:Symbol RequireOpts RBRACKET
RequireOpts -> ( Ws / Keyword / Symbol / LBRACKET ( Ws / Symbol )* RBRACKET )*
UseSpecs -> ( Ws / UseSpec / Symbol / Keyword )*
UseSpec -> LBRACKET Ws* mod:Symbol UseOpts RBRACKET
UseOpts -> ( Ws / Keyword / Symbol / LBRACKET ( Ws / Symbol )* RBRACKET )*
ImportSpecs -> ( Ws / ImportSpec / Symbol )*
ImportSpec -> LPAREN Ws* mod:Symbol ( Ws / Symbol )* RPAREN

DefDecl -> LPAREN Ws* KW_def Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefnDecl -> LPAREN Ws* KW_defn Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefMacroDecl -> LPAREN Ws* KW_defmacro Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefMultiDecl -> LPAREN Ws* KW_defmulti Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefMethodDecl -> LPAREN Ws* KW_defmethod Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefProtocolDecl -> LPAREN Ws* KW_defprotocol Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefRecordDecl -> LPAREN Ws* KW_defrecord Ws* id:Symbol Ws* doc:String? DefBody RPAREN
DefTypeDecl -> LPAREN Ws* KW_deftype Ws* id:Symbol Ws* doc:String? DefBody RPAREN
# What follows the (already captured) docstring: optional metadata, an
# optional parameter vector, then the body forms.
DefBody -> Ws* Meta? Ws* ParamVec? InnerForm*
# A form's contents, stopping before the form's own closing delimiter.
InnerForm -> !RPAREN !RBRACKET !RBRACE Form
Meta -> CARET Ws* ( Map / Keyword / Symbol )
ParamVec -> LBRACKET ( Ws / Symbol / Keyword / Vector / Map / SLASH )* RBRACKET
# Whitespace and comments may separate any two elements of a form.
Ws -> NL / Comment

Expr -> Literal / NamespacedSymbol / Symbol / List / Vector / Map / Set / AnonFn / Quote / SyntaxQuote / Unquote / Deref / Meta
# `#(...)` is an anonymous function literal, distinct from `#{...}` (a set).
AnonFn -> HASH LPAREN InnerForm* RPAREN
# Module-level catch-all: one token of any kind, including a delimiter whose
# partner is missing, so unmodelled or malformed source cannot stop the parse.
Token -> Literal / NamespacedSymbol / Symbol / Keyword / KW_require_kw / KW_use_kw / KW_import_kw / Comment / NL / HASH / QUOTE / BACKTICK / TILDE / CARET / AT / SLASH / LPAREN / RPAREN / LBRACKET / RBRACKET / LBRACE / RBRACE
Literal -> Number / String / Keyword / Regex
List -> LPAREN InnerForm* RPAREN
Vector -> LBRACKET InnerForm* RBRACKET
Map -> LBRACE InnerForm* RBRACE
Set -> HASH LBRACE InnerForm* RBRACE
Quote -> QUOTE Form
SyntaxQuote -> BACKTICK Form
Unquote -> TILDE Form
Deref -> AT Form

=== attrs
on NsForm: def id=ns kind=Namespace doc=doc
on RequireSpec: import module=mod
on UseSpec: import module=mod
on ImportSpec: import module=mod

=== features
function_kinds: Function, Macro, Method, Multimethod
identifier_kinds: Symbol, NamespacedSymbol
vocabulary_token_kinds: String

=== semantics
on RequireSpec {
  edge moduleDependsOn from $file to $resolve($mod) attrs obj("via", $mod, "dep_kind", "require")
}
on UseSpec {
  edge moduleDependsOn from $file to $resolve($mod) attrs obj("via", $mod, "dep_kind", "use")
}
on ImportSpec {
  edge moduleDependsOn from $file to $resolve($mod) attrs obj("via", $mod, "dep_kind", "import")
}

on NsForm {
  edge declares from $file to concat($file, "::", $ns) attrs obj("name", $ns, "kind", "Namespace", "doc", $doc)
}
on DefDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Var", "doc", $doc)
}
on DefnDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", $doc)
}
on DefMacroDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Macro", "doc", $doc)
}
on DefMultiDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Multimethod", "doc", $doc)
}
on DefMethodDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Method", "doc", $doc)
}
on DefProtocolDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Protocol", "doc", $doc)
}
on DefRecordDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Record", "doc", $doc)
}
on DefTypeDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Type", "doc", $doc)
}

=== resolver
relative_prefixes: ./
module_path_style: dot
resolve:
  - manifest: deps.edn @ deps
  - marker: deps.edn, project.clj
  - ext: .clj, .cljs, .cljc
  - fallback: clojars:
