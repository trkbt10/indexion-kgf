kgf 0.6
language: ocaml
sources: .ml, .mli

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - OCaml uses (** *) for OCamldoc
TOKEN DocComment /\(\*\*([\s\S]*?)\*\)/
TOKEN Comment /\(\*[\s\S]*?\*\)/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?/

# Keywords
KEYWORD KW_open    /open\b/
KEYWORD KW_include /include\b/
KEYWORD KW_module  /module\b/
KEYWORD KW_struct  /struct\b/
KEYWORD KW_sig     /sig\b/
KEYWORD KW_end     /end\b/
KEYWORD KW_functor /functor\b/
KEYWORD KW_let     /let\b/
KEYWORD KW_rec     /rec\b/
KEYWORD KW_and     /and\b/
KEYWORD KW_in      /in\b/
KEYWORD KW_type    /type\b/
KEYWORD KW_val     /val\b/
KEYWORD KW_external /external\b/
KEYWORD KW_exception /exception\b/
KEYWORD KW_class   /class\b/
KEYWORD KW_object  /object\b/
KEYWORD KW_method  /method\b/
KEYWORD KW_mutable /mutable\b/
KEYWORD KW_virtual /virtual\b/
KEYWORD KW_private /private\b/
KEYWORD KW_if      /if\b/
KEYWORD KW_then    /then\b/
KEYWORD KW_else    /else\b/
KEYWORD KW_match   /match\b/
KEYWORD KW_with    /with\b/
KEYWORD KW_function /function\b/
KEYWORD KW_fun     /fun\b/
KEYWORD KW_try     /try\b/
KEYWORD KW_begin   /begin\b/
KEYWORD KW_for     /for\b/
KEYWORD KW_while   /while\b/
KEYWORD KW_do      /do\b/
KEYWORD KW_done    /done\b/
KEYWORD KW_of      /of\b/

# Built-in values
TOKEN BoolLit /\b(?:true|false)\b/

# Identifiers
TOKEN ModuleIdent /[A-Z][a-zA-Z0-9_']*/
TOKEN Ident /[a-z_][a-zA-Z0-9_']*/

# Multi-character operators (must precede single-char punctuation and generic Operator)
TOKEN ARROW    /->/
TOKEN LARROW   /<-/
TOKEN DCOLON   /::/
TOKEN SEMI2    /;;/

# Punctuation (must precede generic Operator to avoid = being consumed as Operator)
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/
TOKEN EQ       /=/
TOKEN PIPE     /\|/
TOKEN QUOTE    /'/

# Generic operator (after specific punctuation to avoid conflicts)
TOKEN Operator /[!$%&*+\-.\/:<=>?@^|~]+|:=/

=== grammar
Module -> Item*

# `Other` is a catch-all accepting any single token so the start rule can
# never stop in front of an unmodelled construct. Without it, one construct
# the declaration rules do not cover (a `module type`, an `exception ... of`,
# an object body) truncated the parse and every declaration after it was
# dropped.
Item -> NL
     / OpenDecl
     / IncludeDecl
     / ModuleTypeDecl
     / ModuleDecl
     / TypeDecl
     / LetDecl
     / ValDecl
     / ExternalDecl
     / ExceptionDecl
     / ClassDecl
     / DocComment
     / Other

# Open / include declarations.
#
# `path` is the whole dotted path, so `open Core.Std` produces
# `via="Core.Std"` rather than just its first segment.
OpenDecl -> KW_open path:ModulePath
IncludeDecl -> KW_include path:ModulePath
ModulePath -> ModuleIdent ( DOT ModuleIdent )*

# Module declaration.
#
# `ModuleHeader` fires BEFORE the body is parsed, so its `bind` of the module
# id is in scope for the members inside `struct`/`sig` (events fire bottom-up,
# so a label on `ModuleDecl` itself would be too late).
ModuleDecl -> ModuleHeader ( EQ NL* ModuleExpr )?
ModuleHeader -> doc:DocComment? NL* KW_module KW_rec? id:ModuleIdent FunctorParams? ( COLON NL* ModuleType )?
FunctorParams -> FunctorParam+
FunctorParam -> LPAREN ModuleIdent COLON ModuleType RPAREN

# `module type NAME = sig ... end` declares a signature, not a module. It is
# listed before `ModuleDecl` in `Item` because both start with `module`.
ModuleTypeDecl -> doc:DocComment? NL* KW_module KW_type id:ModuleIdent EQ NL* ModuleType

ModuleType -> KW_sig SigItem* KW_end / ModulePath
ModuleExpr -> KW_struct StructItem* KW_end
           / KW_functor FunctorParams ARROW NL* ModuleExpr
           / ModulePath
SigItem -> ValDecl / TypeDecl / ModuleTypeDecl / ModuleDecl / ExceptionDecl / ExternalDecl / IncludeDecl / DocComment / NL / Comment
StructItem -> LetDecl / TypeDecl / ModuleTypeDecl / ModuleDecl / ExceptionDecl / ExternalDecl / OpenDecl / IncludeDecl / DocComment / NL / Comment

# Type declaration.
#
# `TypeHeader` publishes the type id before the definition is parsed, so the
# variants and record fields inside it can attach to their parent.
TypeDecl -> TypeHeader ( NL* EQ NL* TypeDef )? ( NL* KW_and TypeHeader ( NL* EQ NL* TypeDef )? )*
TypeHeader -> doc:DocComment? NL* KW_type TypeParams? id:Ident
TypeParams -> QUOTE Ident / LPAREN QUOTE Ident ( COMMA QUOTE Ident )* RPAREN
TypeDef -> VariantDef / RecordDef / Type
VariantDef -> NL* PIPE? NL* Variant ( NL* PIPE NL* Variant )*
# The OCamldoc for a variant is conventionally written AFTER the constructor
# (`| Low  (** Run whenever ... *)`), unlike every other declaration. The
# capture therefore sits at the end of the rule, not the start.
Variant -> variant_id:ModuleIdent ( KW_of Type )? variant_doc:DocComment?
RecordDef -> LBRACE NL* RecordField ( NL* SEMI DocComment? NL* RecordField )* NL* SEMI? DocComment? NL* RBRACE
# The field's own doc may also be written on the line ABOVE it; the trailing
# form (`limit : int;  (** ... *)`) is absorbed by the separator in
# `RecordDef`, which is why it is not captured here.
RecordField -> field_doc:DocComment? NL* KW_mutable? field_id:Ident COLON Type

# Let declaration.
#
# Only the FIRST binder is captured as `id`: `let a = ... and b = ...` would
# otherwise rebind the same label and report the last name for both. The
# `and` clauses are consumed without a capture.
LetDecl -> doc:DocComment? NL* KW_let KW_rec? id:Ident Params? ( COLON NL* Type )? EQ Expr ( NL* KW_and Ident Params? ( COLON Type )? EQ Expr )*
Params -> Param+
Param -> Ident / LPAREN Ident COLON Type RPAREN / LPAREN Ident RPAREN / QUOTE Ident

# Val declaration (in signatures)
ValDecl -> doc:DocComment? NL* KW_val KW_mutable? id:Ident COLON NL* Type

# External declaration
ExternalDecl -> doc:DocComment? NL* KW_external id:Ident COLON Type EQ String+

# Exception declaration.
#
# `exception Overloaded of string` is the form that truncated the parse: the
# payload was not accepted, so the item failed and nothing after it was read.
ExceptionDecl -> doc:DocComment? NL* KW_exception id:ModuleIdent ( KW_of Type )?

# Class declaration.
#
# `ClassHeader` publishes the class id before the object body is entered, for
# the same bottom-up reason as `ModuleHeader`.
ClassDecl -> ClassHeader EQ NL* ClassBody
ClassHeader -> doc:DocComment? NL* KW_class KW_virtual? id:Ident Params? ( COLON Type )?
ClassBody -> KW_object ClassSelf? ClassMember* KW_end
# Anything inside `object ... end` that is not a member is skipped as a single
# token, so an unmodelled construct cannot end the body early and cause the
# enclosing ClassDecl to fail and be retried.
ClassSelf -> LPAREN Ident RPAREN
ClassMember -> MethodDecl / ValDecl / DocComment / NL / Comment / ClassOther
ClassOther -> ExprAtom / KW_mutable / KW_virtual / KW_private / KW_type / KW_val / KW_method / KW_object / KW_class / KW_open / KW_include / KW_module / KW_struct / KW_sig / KW_functor / KW_external / KW_exception
# `method virtual now : int` has a type annotation and NO body; the concrete
# form has `= expr`. Both must match or the object body ends early.
MethodDecl -> method_doc:DocComment? NL* KW_method MethodFlag* method_id:Ident Params? ( COLON NL* Type )? ( EQ MethodBody )?
# A method body stops at end of line: the next line is either another member
# or the `end` that closes the object.
MethodBody -> ExprAtom+
# `virtual`, `private` and `!` are the only modifiers allowed before a method
# name. Accepting an arbitrary `Ident` here made `method sleep_for ms = ms`
# report the PARAMETER `ms` as the method name.
# `virtual`, `private` and `!` are the only modifiers allowed between
# `method` and the method name. Accepting an arbitrary `Ident` here made
# `method sleep_for ms = ms` report the PARAMETER `ms` as the method name.
MethodFlag -> KW_virtual / KW_private / Operator

# Types.
#
# A type expression mixes arrows, tuples (`*`), type application
# (`int list`), optional/labelled arguments and qualified names. Operators
# and commas are accepted between atoms so an unusual type cannot break the
# declaration that contains it.
Type -> TypeApp ( ( ARROW / Operator / COMMA / COLON ) TypeApp )*
# A type application is one or more juxtaposed atoms: the last is the type
# constructor and the ones before it are its arguments.
TypeApp -> TypeAtom+
TypeAtom -> QUOTE Ident / ModulePath / Ident / ModuleIdent / LPAREN NL* Type? ( COMMA NL* Type )* NL* RPAREN / LBRACKET NL* ( PIPE / Type )* NL* RBRACKET / LBRACE ( NL / Atom )* RBRACE

# Expressions.
#
# A right-hand side is opaque: a balanced token soup that cannot break the
# enclosing declaration. `NL` is excluded so the expression stops at end of
# line; continuation lines are reached because an indented line's first token
# is an `ExprAtom` too and `Expr` is greedy across the `NL` only via the
# explicit `NL*` slots in the declaration rules. Keywords that open a nested
# construct are included so `match`/`fun`/`if` bodies stay inside the
# expression rather than being seen as new items.
Expr -> ExprItem+
ExprItem -> ExprAtom / NL ExprAtom
ExprAtom -> Ident / ModuleIdent / Number / String / Char / BoolLit / LPAREN / RPAREN / LBRACKET / RBRACKET / LBRACE / RBRACE / COMMA / SEMI / SEMI2 / COLON / DCOLON / ARROW / LARROW / EQ / PIPE / QUOTE / DOT / Operator / Comment / KW_in / KW_if / KW_then / KW_else / KW_match / KW_with / KW_function / KW_fun / KW_try / KW_begin / KW_for / KW_while / KW_do / KW_of / KW_let / KW_rec / KW_and / KW_mutable

Atom -> ExprAtom / NL / DocComment / KW_open / KW_include / KW_module / KW_struct / KW_sig / KW_functor / KW_type / KW_val / KW_external / KW_exception / KW_class / KW_object / KW_method / KW_virtual / KW_private / KW_end / KW_done

Other -> Atom

=== attrs
on ModuleHeader:    def id kind=Module doc=doc
on ModuleTypeDecl:  def id kind=ModuleType doc=doc
on TypeHeader:      def id kind=Type doc=doc
on LetDecl:         def id kind=Function doc=doc
on ValDecl:         def id kind=Val doc=doc
on ExternalDecl:    def id kind=External doc=doc
on ExceptionDecl:   def id kind=Exception doc=doc
on ClassHeader:     def id kind=Class doc=doc
on Variant:         def variant_id kind=Variant doc=variant_doc
on RecordField:     def field_id kind=Field doc=field_doc
on MethodDecl:      def method_id kind=Method doc=method_doc


=== features
function_kinds: Function, External, Val
function_keyword: KW_let
identifier_kinds: Ident, ModuleIdent
qualifier_separators: DOT
vocabulary_token_kinds: DocComment, String

=== semantics
# Import dependencies. `$path` carries the full dotted path.
on OpenDecl {
  edge moduleDependsOn from $file to $resolve($path) attrs obj("via", $path, "dep_kind", "value")
}
on IncludeDecl {
  edge moduleDependsOn from $file to $resolve($path) attrs obj("via", $path, "dep_kind", "value")
}

# OCaml top-level declarations. Visibility is controlled by the companion
# `.mli` interface rather than per declaration, so all are emitted.
#
# `$doc_text` is the doc block's accumulated text; `$doc` alone would hold
# only its last token.
# ---------------------------------------------------------------------------
# Enclosing frames
# ---------------------------------------------------------------------------
# `scope push` / `scope pop` bracket a body's members in a frame of their own:
# a bind lands in the innermost frame and `$scope` searches frames
# innermost-first, so popping a body's frame re-exposes whatever enclosed it.
# The frame is opened by the HEADER — which matches before the body is entered,
# events being bottom-up — and closed by the declaration rule, which fires once
# the whole body is complete. A `StructItem` may itself be a `ModuleDecl` and a
# `TypeDecl` chains headers with `and`, so without the pop a binding outlived
# its own declaration: a variant of a later type, or a method of a later class,
# was attributed to the previous one.
on ModuleHeader {
  # Publish the module id for the members of its `struct`/`sig` body. The
  # header matches before the body is entered, so this is in scope for them.
  let outer = $scope("value", "current_module")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Module", "doc", trim($doc_text))
  scope push
  bind ns "value" name "current_module" to sym_id
}
on ModuleDecl { scope pop }
on ModuleTypeDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "ModuleType", "doc", trim($doc_text))
}
on TypeHeader {
  # Publish the type id so the variants and record fields of its definition
  # attach to it. The header matches before the definition is parsed.
  #
  # No frame is opened here: a single `TypeDecl` chains SEVERAL `TypeHeader`s
  # with `and`, so one push per header could never be matched by one pop per
  # declaration. The binding is simply rebound by the next header, which is
  # exactly the order the definitions are parsed in, and the enclosing module's
  # frame is what stops it escaping the `struct` it was written in.
  bind ns "value" name "current_type" to concat($file, "::", $id)
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Type", "doc", trim($doc_text))
}
on LetDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", trim($doc_text))
}
on ValDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Val", "doc", trim($doc_text))
}
on ExternalDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "External", "doc", trim($doc_text))
}
on ExceptionDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Exception", "doc", trim($doc_text))
}
on ClassHeader {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Class", "doc", trim($doc_text))
  scope push
  bind ns "value" name "current_class" to concat($file, "::", $id)
}
on ClassDecl { scope pop }

# Variants and record fields attach to the type published by `TypeHeader`.
on Variant when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $variant_id) attrs obj("name", $variant_id, "kind", "Variant", "doc", trim($variant_doc_text))
}
on RecordField when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($field_doc_text))
}

# Methods attach to the class published by `ClassHeader`.
on MethodDecl when $scope("value", "current_class") {
  let parent = $scope("value", "current_class")
  edge declares from parent to concat(parent, "#", $method_id) attrs obj("name", $method_id, "kind", "Method", "doc", trim($method_doc_text))
}

=== resolver
relative_prefixes: ./
module_path_style: dot
resolve:
  - marker: dune, dune-project
  - ext: .ml, .mli
  - fallback: opam:
