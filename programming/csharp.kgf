kgf 0.6
language: csharp
sources: .cs

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - C# uses /// for XML documentation
TOKEN DocComment /\/\/\/(.*)/
TOKEN LineComment /\/\/[^\r\n]*/
TOKEN BlockComment /\/\*[\s\S]*?\*\//

# String literals.
#
# The `$` of an interpolated string MUST be written `\$`. Unescaped, `$` is the
# regexp end-of-input anchor — which is how the engine read it, so the
# `$"…"` alternative could never match anything and every interpolated string
# in a file was left as `unrecognized input: "$"`. That is ordinary regexp
# semantics rather than an engine defect, so the fix belongs here.
#
# Alternatives, longest-first (the engine takes the first that matches, not the
# longest, so a prefix form must not be listed ahead of the form it prefixes):
#   """…"""            raw string, may contain single quotes
#   $@"…" / @$"…"      verbatim interpolated, "" escapes a quote
#   @"…"               verbatim, "" escapes a quote
#   $"…"               interpolated; `{…}` may itself contain quotes
#   "…"                plain, backslash escapes
TOKEN String /"""[\s\S]*?"""|[\$]@"([^"]|"")*"|@[\$]"([^"]|"")*"|@"([^"]|"")*"|[\$]"([^"\\{]|\\.|[{][^}]*[}])*"|"([^"\\]|\\.)*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F]+|0b[01]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?[fFdDmMlLuU]*/

# Keywords
KEYWORD KW_namespace /namespace\b/
KEYWORD KW_using     /using\b/
KEYWORD KW_class     /class\b/
KEYWORD KW_struct    /struct\b/
KEYWORD KW_interface /interface\b/
KEYWORD KW_enum      /enum\b/
# `record` is a contextual keyword, but it still gets a token: a PEG cannot
# compare an identifier's text, and `record User(int Id)` is otherwise
# indistinguishable from a method declaration `Result User(int Id)`, so one of
# the two would always be parsed as the other.
KEYWORD KW_record    /record\b/
KEYWORD KW_delegate  /delegate\b/
KEYWORD KW_public    /public\b/
KEYWORD KW_private   /private\b/
KEYWORD KW_protected /protected\b/
KEYWORD KW_internal  /internal\b/
KEYWORD KW_static    /static\b/
KEYWORD KW_abstract  /abstract\b/
KEYWORD KW_sealed    /sealed\b/
KEYWORD KW_virtual   /virtual\b/
KEYWORD KW_override  /override\b/
KEYWORD KW_new       /new\b/
KEYWORD KW_readonly  /readonly\b/
KEYWORD KW_const     /const\b/
KEYWORD KW_void      /void\b/
KEYWORD KW_return    /return\b/
KEYWORD KW_if        /if\b/
KEYWORD KW_else      /else\b/
KEYWORD KW_switch    /switch\b/
KEYWORD KW_case      /case\b/
KEYWORD KW_for       /for\b/
KEYWORD KW_foreach   /foreach\b/
KEYWORD KW_while     /while\b/
KEYWORD KW_in        /in\b/
KEYWORD KW_out       /out\b/
KEYWORD KW_ref       /ref\b/
KEYWORD KW_this      /this\b/
KEYWORD KW_base      /base\b/
KEYWORD KW_event     /event\b/

# Built-in types. `void` … `object` are reserved words, so tokens for them are
# safe. `var` and `dynamic` are NOT: both are CONTEXTUAL keywords and stay
# perfectly legal names for a field, parameter or method — `int var = 1;`
# compiles. The lexer matches token rules in definition order, so listing them
# here shadowed `Ident` everywhere and made every such declaration unmatchable,
# silently dropping the symbol and, when it had a brace body, everything after
# it. They are matched as ordinary identifiers in type position, which
# `TypeAtom`'s `QualifiedName` alternative accepts.
#
# `partial`, `async`, `await`, `get`, `set`, `init`, `value` and `where` are
# contextual for the same reason and likewise have no tokens; the grammar
# recognizes them POSITIONALLY (see `ContextualModifier` and `Accessor`).
TOKEN KeywordType /\b(?:void|int|byte|sbyte|short|ushort|long|ulong|float|double|decimal|bool|char|string|object)\b/

# Built-in values
TOKEN BoolLit /\b(?:true|false)\b/
TOKEN NullLit /\bnull\b/

# Identifiers
TOKEN TypeIdent /[A-Z][a-zA-Z0-9_]*/
TOKEN Ident /[a-z_@][a-zA-Z0-9_]*/

# Operators
TOKEN ARROW    /=>/
TOKEN NULLCOND /\?\./
TOKEN NULLCOAL /\?\?/
TOKEN LT       /</
TOKEN GT       />/
TOKEN Operator /[+\-*%&|^~!=]+|&&|\|\||<<|>>/

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN QMARK    /\?/
TOKEN COLON    /:/

# Additional keywords used in grammar contexts
KEYWORD KW_extern /extern\b/
KEYWORD KW_unsafe /unsafe\b/

=== grammar
Module -> Item*

# Every top-level construct is one of these. `Other` is the catch-all and
# accepts ANY single token, including a lone bracket, so a declaration the
# rules only partially match can never stop the module parse: the leftovers are
# skipped one token at a time and the next declaration is picked up again.
#
# Declarations come before the bare `DocComment` alternative because PEG
# ordered choice takes the first match — a leading `DocComment` alternative
# would swallow the doc that belongs to the declaration below it.
Item -> NL
     / UsingDecl
     / NamespaceDecl
     / TypeDecl
     / GlobalMember
     / DocBlock
     / Other

TypeDecl -> ClassDecl / StructDecl / InterfaceDecl / EnumDecl / RecordDecl / DelegateDecl
# A file with top-level statements may also carry methods at file scope.
GlobalMember -> MethodDecl

# Doc block (consecutive /// comments)
DocBlock -> DocComment ( NL DocComment )*

# Using declaration
UsingDecl -> KW_using KW_static? ( Ident Operator )? path:QualifiedName SEMI
QualifiedName -> Name ( DOT Name )*
# The lexer splits identifiers by first-letter case, so a name in declaration
# position may be either kind: `int Id`, `record User(int Id)`, `void get()`.
Name -> Ident / TypeIdent

# Namespace declaration — braced or file-scoped (`namespace N;`).
NamespaceDecl -> KW_namespace QualifiedName NL* ( NamespaceBody / SEMI )
NamespaceBody -> LBRACE NamespaceMember* RBRACE
NamespaceMember -> !RBRACE ( NL / LineComment / BlockComment / UsingDecl / NamespaceDecl / TypeDecl / SEMI / MemberOther )

# ---------------------------------------------------------------------------
# Declaration metadata
# ---------------------------------------------------------------------------
# Every declaration carries the same outer metadata: an XML doc block,
# attributes and modifiers, each typically on its own line. Real code writes
#
#   /// <summary>…</summary>
#   [Obsolete]
#   public sealed partial class Foo { … }
#
# A `( Attribute / Modifier / NL )*` group on BOTH sides of the doc block
# absorbs attributes, modifiers and the newlines around them wherever they
# fall; the doc capture still binds because a DocBlock is none of those, so the
# greedy groups never swallow it.
#
# The metadata is spelled out in each rule rather than factored into a shared
# prefix rule because a label binds only inside the rule that writes it: behind
# an indirection `$doc` would be invisible to the declaration's own semantics.
DeclMeta -> Attribute / Modifier / NL

# Each type's header is a rule of its own so that it fires BEFORE the body (PEG
# matches it to completion first, so its event — and the `bind` in its
# semantics — precedes every member event). That binding is what attaches each
# method, property and nested type to the type it belongs to.
ClassDecl -> ClassHeader ClassBody
ClassHeader -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_class id:TypeIdent TypeParams? BaseList? WhereClause* NL*
BaseList -> COLON NL* TypeList
ClassBody -> LBRACE ClassMember* RBRACE
# The `!RBRACE` guard is essential. The member list ends at the body's closing
# brace, and the trailing catch-all — which must accept any token so a member
# the rules cannot match does not abort the type — would otherwise consume that
# `}` and run to end of file. `ClassBody`'s own `RBRACE` would then never
# match, the type would be dropped, and `Item*` would re-parse the whole body
# at top level: every member declared twice and detached from its type.
#
# Order matters: a constructor (a name with no return type) must be tried
# before a method, and a property (a name followed by `{`) before a field.
ClassMember -> !RBRACE ( NL / LineComment / BlockComment
            / TypeDecl / ConstructorDecl / IndexerDecl / EventDecl
            / PropertyDecl / MethodDecl / FieldDecl
            / SEMI / MemberOther )
# Inside a body the catch-all must not swallow a brace either: an unbalanced
# one would run past the body's end exactly like `RBRACE` above.
MemberOther -> Atom / LPAREN / RPAREN / LBRACKET / RBRACKET / Body

StructDecl -> StructHeader ClassBody
StructHeader -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_struct id:TypeIdent TypeParams? BaseList? WhereClause* NL*

InterfaceDecl -> InterfaceHeader InterfaceBody
InterfaceHeader -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_interface id:TypeIdent TypeParams? BaseList? WhereClause* NL*
# An interface body gets member rules of its own purely so the semantics can
# tell it apart from a class body: every interface member is implicitly public
# even with no modifier written, while a class member with no modifier is
# private and must stay unpublished.
InterfaceBody -> LBRACE InterfaceMember* RBRACE
InterfaceMember -> !RBRACE ( NL / LineComment / BlockComment
                / TypeDecl / IndexerDecl / EventDecl
                / InterfacePropertyDecl / InterfaceMethodDecl
                / SEMI / MemberOther )
InterfaceMethodDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type method_id:Name TypeParams? LPAREN NL* ParamList? NL* RPAREN WhereClause* NL* ( Body / ARROW Expr SEMI / SEMI )
InterfacePropertyDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type prop_id:Name NL* ( PropertyAccessors / ARROW Expr SEMI )

EnumDecl -> EnumHeader EnumBody
EnumHeader -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_enum id:TypeIdent ( COLON Type )? NL*
EnumBody -> LBRACE NL* EnumMemberList? NL* RBRACE
EnumMemberList -> EnumMember ( NL* COMMA NL* EnumMember )* ( NL* COMMA )? NL*
# The explicit value must be a `DefaultExpr`, not a general `Expr`: a general
# expression accepts `,` as an atom, so `Green = 2` swallowed every member
# after it and they all disappeared from the graph.
EnumMember -> NL* member_pre:DeclMeta* member_doc:DocBlock? DeclMeta* member_id:Name ( Operator DefaultExpr )?

# Record declaration. The positional parameter list sits OUTSIDE the header on
# purpose: a positional parameter is a public property on the record, and an
# event fires only once its rule has matched to completion — so parameters
# parsed inside the header would emit their events BEFORE the header published
# the record, and each one would be attributed to the previous type.
RecordDecl -> RecordHeader RecordParams? BaseList? WhereClause* NL* ( ClassBody / SEMI )
RecordHeader -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_record ( KW_struct / KW_class )? id:TypeIdent TypeParams?
# The positional parameters of a record have their own rule: they declare
# public properties on the record, while an ordinary method `Param` declares
# nothing. Sharing one rule made every method parameter in the file surface
# as a property of its enclosing type.
RecordParams -> LPAREN NL* RecordParamList? NL* RPAREN
RecordParamList -> RecordParam ( NL* COMMA NL* RecordParam )* ( NL* COMMA )?
RecordParam -> NL* Attribute* NL* ParamModifier* Type rec_param_id:Name ( Operator DefaultExpr )?

DelegateDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_delegate Type id:TypeIdent TypeParams? LPAREN NL* ParamList? NL* RPAREN WhereClause* SEMI

# Constructor declaration — a name with no return type, directly followed by a
# parameter list.
ConstructorDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* id:TypeIdent LPAREN NL* ParamList? NL* RPAREN ( COLON NL* ( KW_this / KW_base ) LPAREN BodyContent* RPAREN )? NL* ( Body / ARROW Expr SEMI / SEMI )

MethodDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type method_id:Name TypeParams? LPAREN NL* ParamList? NL* RPAREN WhereClause* NL* ( Body / ARROW Expr SEMI / SEMI )

PropertyDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type prop_id:Name NL* ( PropertyAccessors / ARROW Expr SEMI )
PropertyAccessors -> LBRACE NL* Accessor+ NL* RBRACE ( Operator Expr SEMI )?
# `get`, `set` and `init` are contextual keywords with no token of their own
# (a token would shadow `Ident` everywhere and break a method or field named
# `get`). An accessor is recognized positionally instead: an identifier
# directly followed by `;`, `{` or `=>` inside a property's accessor list.
Accessor -> NL* DeclMeta* Ident ( Body / SEMI / ARROW Expr SEMI )

FieldDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type field_id:Name ( Operator Expr )? ( COMMA Name ( Operator Expr )? )* SEMI

EventDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* KW_event Type event_id:Name ( EventAccessors / ( Operator Expr )? SEMI )
EventAccessors -> LBRACE NL* EventAccessor+ NL* RBRACE
EventAccessor -> NL* DeclMeta* Ident Body

IndexerDecl -> pre:DeclMeta* doc:DocBlock? mods:DeclMeta* Type KW_this LBRACKET ParamList RBRACKET NL* PropertyAccessors

# Attributes — an opaque balanced-bracket group: the contents are metadata, not
# declarations, and any attempt to model them precisely just adds failure modes.
Attribute -> LBRACKET BodyContent* RBRACKET

# Modifiers. C#'s contextual modifiers (`partial`, `async`, `required`,
# `file`, `sealed`-adjacent words, …) have no lexer tokens, because a token
# would shadow `Ident` and break every identifier spelled the same — `int
# async;` and `void partial()` are legal C#.
#
# They are absorbed by `ContextualModifier`, which accepts a bare identifier
# only where a declaration actually follows: either a type keyword
# (`… partial class Foo`) or a member's `Type Name (` / `Type Name {` /
# `Type Name ;` shape (`… async Task<int> DoAsync(`). The and-predicate is
# what keeps a field or method NAMED `async` from being eaten as a modifier of
# whatever comes after it, which a plain `Ident` alternative would do.
Modifier -> KW_public / KW_private / KW_protected / KW_internal / KW_static / KW_abstract / KW_sealed / KW_virtual / KW_override / KW_new / KW_readonly / KW_const / KW_extern / KW_unsafe / ContextualModifier
ContextualModifier -> Ident &( ModifierRun ( TypeKeyword / MemberStart ) )
ModifierRun -> ( Ident / Attribute / NL / KW_public / KW_private / KW_protected / KW_internal / KW_static / KW_abstract / KW_sealed / KW_virtual / KW_override / KW_new / KW_readonly / KW_const / KW_extern / KW_unsafe )*
TypeKeyword -> KW_class / KW_struct / KW_interface / KW_enum / KW_record / KW_delegate / KW_event
MemberStart -> Type Name ( LPAREN / LBRACE / SEMI / Operator / ARROW / LT )

# Parameters
ParamList -> Param ( NL* COMMA NL* Param )* ( NL* COMMA )?
# A parameter may carry `params`, `scoped` or `this` before its type. `params`
# and `scoped` are contextual words with no token (a token would shadow
# `Ident`), so they are matched as a bare identifier that is itself followed
# by a type and a name — the and-predicate keeps an ordinary
# `Type name` parameter from being read as `modifier Type`.
Param -> NL* Attribute* NL* ParamModifier* Type param_id:Name ( Operator DefaultExpr )?
ParamModifier -> KW_this / KW_ref / KW_out / KW_in / Ident &( ( Ident / KeywordType / KW_void ) )
# `where T : ISomething, new()` — a constraint clause. `where` is contextual,
# so it is matched as an identifier followed by the `TypeIdent :` shape.
WhereClause -> NL* Ident &( TypeIdent COLON ) TypeIdent COLON TypeConstraint ( COMMA TypeConstraint )*
TypeConstraint -> KW_class QMARK? / KW_struct / KW_new LPAREN RPAREN / Type

# Types
TypeParams -> LT NL* TypeParam ( NL* COMMA NL* TypeParam )* NL* GT
TypeParam -> Attribute* ( KW_in / KW_out )? TypeIdent
TypeList -> Type ( NL* COMMA NL* Type )*
Type -> TypeCore ( ArrayDims / QMARK )*
TypeCore -> KeywordType / KW_void / TupleType / QualifiedName TypeArgs? ( DOT Name TypeArgs? )*
TupleType -> LPAREN NL* TupleElement ( NL* COMMA NL* TupleElement )+ NL* RPAREN
TypeArgs -> LT NL* TypeArgList? NL* GT
TypeArgList -> Type ( NL* COMMA NL* Type )*
ArrayDims -> LBRACKET COMMA* RBRACKET
TupleElement -> Type Name?

# Body — an opaque balanced-bracket group. Nothing inside a method body is part
# of a type's public surface, so its contents only need to be consumed safely,
# with every bracket pair matched so the body ends at the right `}`.
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / Atom

# Expressions — a field/property initializer or an expression body. C# puts
# object initializers, lambdas and collection expressions there, so an
# expression is a run of atoms and balanced bracket groups, exactly like a
# body. Modelling it more precisely only creates new ways to stop the parse.
Expr -> ExprItem+
ExprItem -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / ExprAtom
ExprAtom -> Ident / TypeIdent / Number / String / Char / BoolLit / NullLit / KeywordType / KW_new / KW_this / KW_base / KW_switch / KW_case / KW_in / KW_out / KW_ref / DOT / COMMA / COLON / ARROW / NULLCOND / NULLCOAL / QMARK / LT / GT / Operator
# A default value ends at the comma or paren that ends its parameter, so unlike
# `Expr` it must NOT accept a bare `,`; a comma inside it is nested in a
# bracket group, which `DefaultItem` consumes whole.
DefaultExpr -> DefaultItem+
DefaultItem -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / DefaultAtom
DefaultAtom -> Ident / TypeIdent / Number / String / Char / BoolLit / NullLit / KeywordType / KW_new / KW_this / KW_base / DOT / COLON / ARROW / NULLCOND / NULLCOAL / QMARK / LT / GT / Operator

Atom -> ExprAtom / NL / DocComment / LineComment / BlockComment / KW_namespace / KW_using / KW_class / KW_struct / KW_interface / KW_enum / KW_record / KW_delegate / KW_public / KW_private / KW_protected / KW_internal / KW_static / KW_abstract / KW_sealed / KW_virtual / KW_override / KW_readonly / KW_const / KW_void / KW_return / KW_if / KW_else / KW_for / KW_foreach / KW_while / KW_event / KW_extern / KW_unsafe / SEMI

# Catch-all: one token of any kind, including a bracket whose partner the
# declaration rules never reached (an `Atom` only accepts balanced groups).
Other -> Atom / LBRACE / RBRACE / LPAREN / RPAREN / LBRACKET / RBRACKET

=== attrs
on ClassHeader:            def id kind=Class doc=doc
on StructHeader:           def id kind=Struct doc=doc
on InterfaceHeader:        def id kind=Interface doc=doc
on EnumHeader:             def id kind=Enum doc=doc
on RecordHeader:           def id kind=Record doc=doc
on DelegateDecl:           def id kind=Delegate doc=doc
on MethodDecl:             def method_id kind=Method doc=doc
on InterfaceMethodDecl:    def method_id kind=Method doc=doc
on PropertyDecl:           def prop_id kind=Property doc=doc
on InterfacePropertyDecl:  def prop_id kind=Property doc=doc
on FieldDecl:              def field_id kind=Field doc=doc
on EventDecl:              def event_id kind=Event doc=doc
on ConstructorDecl:        def id kind=Constructor doc=doc
on EnumMember:             def member_id kind=EnumMember doc=member_doc
on Param:                  def param_id kind=Param
on RecordParam:            def rec_param_id kind=Property

=== features
document_symbol_kinds: Class, Struct, Interface, Enum, Record, Delegate
function_kinds: Method, Constructor
coverage_token_kinds: Ident, TypeIdent
identifier_kinds: Ident, TypeIdent
qualifier_separators: DOT
vocabulary_token_kinds: DocComment, String

=== semantics
# Import dependency. Note there is deliberately no `on UsingDecl: import ...`
# line in the `=== attrs` section: an attrs `import` directive emits its own
# moduleDependsOn edge, so having both produced two identical edges per using.
#
# `$path` holds only the LAST token of the dotted name, so `$path_text` — the
# whole accumulated `System.Collections.Generic` — is what has to be resolved.
on UsingDecl {
  edge moduleDependsOn from $file to $resolve($path_text) attrs obj("via", $path_text, "dep_kind", "value")
}

# ---------------------------------------------------------------------------
# Enclosing-type frame
# ---------------------------------------------------------------------------
# A type nested in another type's body belongs to that type, and a declaration
# written AFTER that body belongs to whatever enclosed it — so the enclosing
# type behaves like a stack. `scope push` / `scope pop` are that stack: a bind
# lands in the innermost frame and `$scope` searches frames innermost-first,
# so popping a type's frame re-exposes its enclosing type's binding with no
# bookkeeping of our own.
#
# Events fire bottom-up, so the frame is opened by the HEADER — which matches
# to completion before the body is parsed — and closed by the declaration rule,
# which fires after the whole body. `current_type` holds the innermost type;
# unbound means file level.
#
# C#'s default member visibility is private and its default TYPE visibility is
# internal, so only `public` and `protected` declarations are published.
# `internal` is assembly-visible and not part of the package's surface.
# Visibility is read out of the declaration's accumulated metadata text,
# because it may sit on either side of the doc block.
#
# The type's own `declares` edge is emitted from the same header, BEFORE the
# push, so `$scope("value", "current_type")` still names the ENCLOSING type
# there — that is the edge's `from`. The push itself is unconditional: an
# unpublished type still owns its members.
on ClassHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Class", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on ClassHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on StructHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Struct", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on StructHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on InterfaceHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Interface", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on InterfaceHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on EnumHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Enum", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on EnumHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}
on RecordHeader when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let owner = $scope("value", "current_type")
  let from_id = cond(owner, owner, $file)
  edge declares from from_id to concat(from_id, cond(owner, ".", "::"), $id) attrs obj("name", $id, "kind", "Record", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on RecordHeader {
  let outer = $scope("value", "current_type")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_type" to sym_id
}

# A declaration rule fires after its own body, which is exactly where that body
# ends, so it closes the frame the header opened.
on ClassDecl { scope pop }
on StructDecl { scope pop }
on InterfaceDecl { scope pop }
on EnumDecl { scope pop }
on RecordDecl { scope pop }

# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------
on DelegateDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $id) attrs obj("name", $id, "kind", "Delegate", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

on MethodDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $method_id) attrs obj("name", $method_id, "kind", "Method", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on ConstructorDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $id) attrs obj("name", $id, "kind", "Constructor", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on PropertyDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $prop_id) attrs obj("name", $prop_id, "kind", "Property", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on FieldDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on EventDecl when cond(containsStr(concat($pre_text, $mods_text), "public"), 1, containsStr(concat($pre_text, $mods_text), "protected")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $event_id) attrs obj("name", $event_id, "kind", "Event", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

# An interface member is implicitly public with no modifier written at all, so
# it is published unconditionally — except when it explicitly says `private`,
# which C# 8+ allows for helper members.
on InterfaceMethodDecl when not(containsStr(concat($pre_text, $mods_text), "private")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $method_id) attrs obj("name", $method_id, "kind", "Method", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}
on InterfacePropertyDecl when not(containsStr(concat($pre_text, $mods_text), "private")) {
  let parent = $scope("value", "current_type")
  let owner = cond(parent, parent, $file)
  edge declares from owner to concat(owner, cond(parent, ".", "::"), $prop_id) attrs obj("name", $prop_id, "kind", "Property", "doc", trim($doc_text), "modifiers", trim(concat($pre_text, " ", $mods_text)))
}

# An enum member is a public constant of its enum, with no modifier of its own.
# The header pushed the enum before the body was parsed.
on EnumMember when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $member_id) attrs obj("name", $member_id, "kind", "EnumMember", "doc", trim($member_doc_text))
}

# A positional record parameter declares a public property on the record. The
# parameter list is parsed after the header (see the RecordDecl note), so
# `current_type` already names the record it belongs to.
on RecordParam when $scope("value", "current_type") {
  let parent = $scope("value", "current_type")
  edge declares from parent to concat(parent, ".", $rec_param_id) attrs obj("name", $rec_param_id, "kind", "Property")
}

=== resolver
relative_prefixes: ./, ../
module_path_style: dot
resolve:
  - manifest: *.csproj @ ItemGroup/PackageReference
  - manifest: packages.config @ packages
  - manifest: Directory.Build.props @ PackageReference
  - marker: *.csproj, *.sln, Directory.Build.props
  - ext: .cs
  - fallback: nuget:
