kgf 0.6
language: julia
sources: .jl

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments
TOKEN Comment /#[^\r\n]*/
TOKEN BlockComment /#=[\s\S]*?=#/

# Docstrings
TOKEN DocString /"""([\s\S]*?)"""/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"|"""[\s\S]*?"""|`[^`]*`|raw"[^"]*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Symbols
TOKEN Symbol /:[a-zA-Z_][a-zA-Z0-9_!]*/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?([imf][0-9]+)?/

# Keywords
KEYWORD KW_module     /module\b/
KEYWORD KW_baremodule /baremodule\b/
KEYWORD KW_using      /using\b/
KEYWORD KW_import     /import\b/
KEYWORD KW_export     /export\b/
KEYWORD KW_function   /function\b/
KEYWORD KW_macro      /macro\b/
KEYWORD KW_struct     /struct\b/
KEYWORD KW_mutable    /mutable\b/
KEYWORD KW_abstract   /abstract\b/
KEYWORD KW_primitive  /primitive\b/
KEYWORD KW_type       /type\b/
KEYWORD KW_const      /const\b/
KEYWORD KW_let        /let\b/
KEYWORD KW_begin      /begin\b/
KEYWORD KW_end        /end\b/
KEYWORD KW_if         /if\b/
KEYWORD KW_elseif     /elseif\b/
KEYWORD KW_else       /else\b/
KEYWORD KW_for        /for\b/
KEYWORD KW_in         /in\b/
KEYWORD KW_while      /while\b/
KEYWORD KW_return     /return\b/
KEYWORD KW_try        /try\b/
KEYWORD KW_catch      /catch\b/
KEYWORD KW_finally    /finally\b/
KEYWORD KW_quote    /quote\b/
KEYWORD KW_do       /do\b/
KEYWORD KW_global   /global\b/
KEYWORD KW_local    /local\b/
KEYWORD KW_where      /where\b/

# Built-in values
TOKEN BoolLit /\b(?:true|false)\b/
TOKEN NothingLit /\bnothing\b/

# Identifiers
TOKEN TypeIdent /[A-Z][a-zA-Z0-9_]*/
TOKEN Ident /[a-z_][a-zA-Z0-9_!]*/

# Operators
TOKEN DCOLON /::/
TOKEN ARROW  /->/
TOKEN DARROW /=>/
# `Operator` deliberately omits the BARE `=` and `:`. The lexer matches
# token rules in definition order (first match wins, not longest match),
# and this rule is defined before `EQ` and `COLON`; with those characters
# in the class every single `=` lexed as `Operator`, so the assignment
# form `f(x) = expr` (the most common way to define a Julia function)
# could never match its `EQ` slot, and every `name::Type` lost its
# `COLON`. The multi-character forms that CONTAIN them (`==`, `!=`, `<=`,
# `>=`, `=>`, `::`, `:=`) are listed explicitly first so they still win
# over the bare single-character tokens.
TOKEN Operator /===|!==|==|!=|<=|>=|=>|:=|\.\.\.?|&&|\|\||\/\/|\\\\|[+\-*\/%&|^~!<>]+/

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/
TOKEN EQ       /=/
TOKEN AT       /@/
TOKEN DOLLAR   /\$/

=== grammar
Module -> Item*

# `Other` is a catch-all accepting any single token so the start rule can
# never stop in front of an unmodelled construct.
Item -> NL
     / ModuleDecl
     / UsingDecl
     / ImportDecl
     / ExportDecl
     / FunctionDecl
     / ShortFunctionDecl
     / MacroDecl
     / StructDecl
     / AbstractDecl
     / PrimitiveDecl
     / ConstDecl
     / DocString
     / Other

# A block body, consumed as a BALANCED opaque group.
#
# This is the central fix for this spec. The previous bodies were
# `( NL / Comment / Expr )*` and `Expr`'s atom set reached `KW_end` through
# `Atom`; a body that can eat its own terminator never stops, so every
# `function ... end` failed to match and the whole file fell through to
# `Other` — zero edges while still reporting "Parse: SUCCESS".
#
# `BlockContent` excludes the block terminator `end` and instead recurses
# into the nested block forms, so a body always stops at its own `end`.
BlockContent -> BlockKeyword BlockContent* KW_end
             / LPAREN BracketContent* RPAREN
             / LBRACE BracketContent* RBRACE
             / LBRACKET BracketContent* RBRACKET
             / BlockAtom
# Inside brackets, `for` and `if` are comprehension syntax with no `end`, so
# they are consumed as ordinary atoms rather than as block openers.
BracketContent -> LPAREN BracketContent* RPAREN / LBRACE BracketContent* RBRACE / LBRACKET BracketContent* RBRACKET
               / KW_function BlockContent* KW_end / KW_begin BlockContent* KW_end / KW_let BlockContent* KW_end
               / KW_do BlockContent* KW_end / KW_quote BlockContent* KW_end / KW_try BlockContent* KW_end
               / KW_while BlockContent* KW_end
               / KW_for / KW_if / BlockAtom
# Every keyword that OPENS a block and is closed by `end`.
BlockKeyword -> KW_function / KW_macro / KW_struct / KW_module / KW_baremodule / KW_begin / KW_let / KW_if / KW_for / KW_while / KW_try / KW_quote / KW_do / KW_mutable
# Every token EXCEPT `end` and the bracket terminators handled above.
BlockAtom -> Ident / TypeIdent / Number / String / DocString / Char / Symbol / BoolLit / NothingLit / DOT / COMMA / COLON / DCOLON / SEMI / EQ / ARROW / DARROW / AT / DOLLAR / Operator / Comment / BlockComment / NL
          / KW_using / KW_import / KW_export / KW_abstract / KW_primitive / KW_type / KW_const / KW_where / KW_in / KW_return / KW_elseif / KW_else / KW_catch / KW_finally / KW_global / KW_local
Block -> BlockContent* KW_end

# Module declaration.
#
# `ModuleHeader` fires BEFORE the body, so its `bind` of the module id is in
# scope for the members inside it (events fire bottom-up, so a label on
# `ModuleDecl` itself would be too late for its own members).
ModuleDecl -> ModuleHeader ModuleMember* KW_end
ModuleHeader -> doc:DocString? NL* ( KW_module / KW_baremodule ) id:TypeIdent
ModuleMember -> UsingDecl / ImportDecl / ExportDecl / FunctionDecl / ShortFunctionDecl / MacroDecl / StructDecl / AbstractDecl / PrimitiveDecl / ConstDecl / ModuleDecl / DocString / NL / Comment / BlockComment / NestedBlock / BlockAtom
NestedBlock -> BlockKeyword BlockContent* KW_end / LPAREN BracketContent* RPAREN / LBRACE BracketContent* RBRACE / LBRACKET BracketContent* RBRACKET

# Using/Import/Export declarations.
#
# `path` is the WHOLE dotted path, so `import Base.Threads` produces
# `via="Base.Threads"`; `$path` alone would hold only the last segment.
UsingDecl -> KW_using path:ModulePath ( COLON Names )? ( COMMA ModulePath ( COLON Names )? )*
ImportDecl -> KW_import path:ModulePath ( COLON Names )? ( COMMA ModulePath ( COLON Names )? )*
ExportDecl -> KW_export Names
ModulePath -> DOT* ( TypeIdent / Ident ) ( DOT ( TypeIdent / Ident ) )*
Names -> ExportName ( COMMA NL* ExportName )*
ExportName -> TypeIdent / Ident / AT Ident / Operator

# Function declaration (long form).
#
# A Julia function name may be qualified (`Base.show`) or an operator
# (`function ==(a, b)`); `FuncName` accepts all three and the label binds the
# final identifier, which is the name consumers expect.
# The name capture is INLINE rather than inside a `FuncName` sub-rule: a
# label bound in a referenced rule does not leak to its caller, so `id:`
# must appear in this rule's own expression.
FunctionDecl -> doc:DocString? NL* KW_function Qualifier* id:( Ident / TypeIdent / Operator ) TypeArgs? LPAREN NL* ParamList? NL* RPAREN ( DCOLON Type )? WhereClause? Block
Qualifier -> ( TypeIdent / Ident ) DOT

# Function declaration (short/assignment form): `pending(col) = expr`.
#
# This form is extremely common in Julia and had no rule at all, so every
# one-line function was lost. It is listed AFTER the long form in `Item`
# because both start with an identifier.
ShortFunctionDecl -> doc:DocString? NL* Qualifier* id:( Ident / TypeIdent / Operator ) TypeArgs? LPAREN NL* ParamList? NL* RPAREN ( DCOLON Type )? WhereClause? EQ ShortBody
# The right-hand side runs to end of line, or is a balanced block.
ShortBody -> BlockKeyword BlockContent* KW_end / ShortAtom+
ShortAtom -> LPAREN BracketContent* RPAREN / LBRACE BracketContent* RBRACE / LBRACKET BracketContent* RBRACKET
          / Ident / TypeIdent / Number / String / Char / Symbol / BoolLit / NothingLit / DOT / COMMA / COLON / DCOLON / EQ / ARROW / DARROW / AT / DOLLAR / Operator / KW_in / KW_where / KW_return

TypeParams -> LBRACE NL* TypeParam ( NL* COMMA NL* TypeParam )* NL* RBRACE
TypeParam -> ( TypeIdent / Ident ) ( Operator Type )?
WhereClause -> ( KW_where TypeConstraint )+
TypeConstraint -> LBRACE NL* TypeParam ( NL* COMMA NL* TypeParam )* NL* RBRACE / ( TypeIdent / Ident ) ( Operator Type )?

# Macro declaration
MacroDecl -> doc:DocString? NL* KW_macro id:Ident LPAREN NL* ParamList? NL* RPAREN Block

# Struct declaration.
#
# `StructHeader` publishes the struct id before the body, so its fields
# attach to it.
StructDecl -> StructHeader StructMember* KW_end
StructHeader -> doc:DocString? NL* KW_mutable? KW_struct id:TypeIdent TypeParams? SuperType?
SuperType -> Operator Type
# An inner constructor is an ordinary (short or long) function and is matched
# as such; a plain `name::Type` line is a field.
StructMember -> InnerConstructor / FieldDecl / DocString / NL / Comment / BlockComment / NestedBlock / BlockAtom
# An inner constructor shares the struct's name and is a member of it.
InnerConstructor -> ctor_doc:DocString? NL* ctor_id:TypeIdent TypeArgs? LPAREN NL* ParamList? NL* RPAREN WhereClause? ( EQ ShortBody / Block )
FieldDecl -> field_doc:DocString? NL* field_id:Ident DCOLON Type / field_doc:DocString? NL* field_id:Ident NL

# Abstract / primitive type declarations
AbstractDecl -> doc:DocString? NL* KW_abstract KW_type id:TypeIdent TypeParams? SuperType?
PrimitiveDecl -> doc:DocString? NL* KW_primitive KW_type id:TypeIdent TypeParams? SuperType? Number

# Const declaration
ConstDecl -> doc:DocString? NL* KW_const id:Ident ( DCOLON Type )? EQ ShortBody

# Parameters.
#
# A parameter list may contain positional params, defaults, a `;` separating
# keyword params, splats (`args...`) and untyped names.
ParamList -> Param ( NL* ( COMMA / SEMI ) NL* Param )* NL* COMMA? NL*
# `weight(::Low) = 0` dispatches on a type with NO parameter name, so the
# anonymous form must be accepted before the named one.
Param -> DCOLON Type / param_id:Ident ( DCOLON Type )? ( Operator )? ( EQ ShortAtom+ )? / Operator / ShortAtom

# Types
Type -> TypeAtom ( Operator TypeAtom )*
TypeAtom -> ( TypeIdent / Ident ) TypeArgs? ( DOT ( TypeIdent / Ident ) TypeArgs? )* / LBRACE NL* Type ( NL* COMMA NL* Type )* NL* RBRACE / Number
TypeArgs -> LBRACE NL* Type ( NL* COMMA NL* Type )* NL* RBRACE

Atom -> BlockAtom / KW_end / KW_function / KW_macro / KW_struct / KW_module / KW_baremodule / KW_begin / KW_let / KW_if / KW_for / KW_while / KW_try / KW_quote / KW_do / KW_mutable / LPAREN / RPAREN / LBRACE / RBRACE / LBRACKET / RBRACKET

Other -> Atom

=== attrs
on ModuleHeader:  def id kind=Module doc=doc
on FunctionDecl:  def id kind=Function doc=doc
on ShortFunctionDecl: def id kind=Function doc=doc
on MacroDecl:     def id kind=Macro doc=doc
on StructHeader:  def id kind=Struct doc=doc
on AbstractDecl:  def id kind=AbstractType doc=doc
on PrimitiveDecl: def id kind=PrimitiveType doc=doc
on ConstDecl:     def id kind=Const doc=doc
on FieldDecl:     def field_id kind=Field doc=field_doc
on InnerConstructor: def ctor_id kind=Constructor doc=ctor_doc
on Param:         def param_id kind=Param


=== features
function_kinds: Function, Macro
function_keyword: KW_function
identifier_kinds: Ident, TypeIdent
qualifier_separators: DOT, DCOLON
vocabulary_token_kinds: DocString, String

=== semantics
# Dependency edges. `$path_text` is the whole dotted path; `$path` alone
# would hold only its last segment.
on ImportDecl {
  edge moduleDependsOn from $file to $resolve($path_text) attrs obj("via", $path_text, "dep_kind", "value", "rel", "import")
}
on UsingDecl {
  edge moduleDependsOn from $file to $resolve($path_text) attrs obj("via", $path_text, "dep_kind", "value", "rel", "using")
}

# Julia declarations. Visibility is controlled by the module's `export` list
# rather than per declaration, so every top-level declaration is emitted.
#
# The module HEADER carries the declares edge and the bind, not `ModuleDecl`:
# events fire bottom-up, so a bind on the whole declaration would happen
# after its own members had already been reduced.
# A `ModuleMember` may itself be a `ModuleDecl`, and a `StructDecl` opens a
# body of its own, so both open a scope frame: `scope push` / `scope pop`
# bracket a body's members in a frame of their own, a bind lands in the
# innermost frame and `$scope` searches frames innermost-first. Popping the
# frame at the declaration rule — which fires after the whole body — re-exposes
# whatever enclosed it, so a struct written after a nested module no longer
# belongs to that module and a field written after a nested struct no longer
# belongs to that struct.
on ModuleHeader {
  let outer = $scope("value", "current_module")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Module", "doc", trim($doc_text))
  scope push
  bind ns "value" name "current_module" to sym_id
}
on ModuleDecl { scope pop }
on FunctionDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", trim($doc_text))
}
on ShortFunctionDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", trim($doc_text))
}
on MacroDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Macro", "doc", trim($doc_text))
}
on StructHeader {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Struct", "doc", trim($doc_text))
  scope push
  bind ns "value" name "current_struct" to concat($file, "::", $id)
}
on StructDecl { scope pop }
on AbstractDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "AbstractType", "doc", trim($doc_text))
}
on PrimitiveDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "PrimitiveType", "doc", trim($doc_text))
}
on ConstDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Const", "doc", trim($doc_text))
}

# Inner constructors and fields both attach to the struct published by
# `StructHeader`.
on InnerConstructor when $scope("value", "current_struct") {
  let parent = $scope("value", "current_struct")
  edge declares from parent to concat(parent, ".", $ctor_id) attrs obj("name", $ctor_id, "kind", "Constructor", "doc", trim($ctor_doc_text))
}

on FieldDecl when $scope("value", "current_struct") {
  let parent = $scope("value", "current_struct")
  edge declares from parent to concat(parent, ".", $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($field_doc_text))
}

=== resolver
relative_prefixes: ./
module_path_style: dot
resolve:
  - manifest: Project.toml @ deps
  - marker: Project.toml
  - ext: .jl
  - fallback: pkg:
