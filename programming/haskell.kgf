kgf 0.6
language: haskell
sources: .hs, .lhs

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - Haddock uses -- | and {- | -}
TOKEN DocComment /-- \|(.*)/
TOKEN DocBlockComment /\{- \|([\s\S]*?)-\}/
TOKEN LineComment /--[^\r\n]*/
TOKEN BlockComment /\{-[\s\S]*?-\}/
TOKEN Pragma /\{-#[\s\S]*?#-\}/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F]+|0o[0-7]+|0b[01]+|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/

# Keywords
KEYWORD KW_module   /module\b/
KEYWORD KW_import   /import\b/
KEYWORD KW_qualified /qualified\b/
KEYWORD KW_as       /as\b/
KEYWORD KW_hiding   /hiding\b/
KEYWORD KW_data     /data\b/
KEYWORD KW_newtype  /newtype\b/
KEYWORD KW_type     /type\b/
KEYWORD KW_class    /class\b/
KEYWORD KW_instance /instance\b/
KEYWORD KW_deriving /deriving\b/
KEYWORD KW_where    /where\b/
KEYWORD KW_let      /let\b/
KEYWORD KW_in       /in\b/
KEYWORD KW_do       /do\b/
KEYWORD KW_case     /case\b/
KEYWORD KW_of       /of\b/
KEYWORD KW_if       /if\b/
KEYWORD KW_then     /then\b/
KEYWORD KW_else     /else\b/
KEYWORD KW_family   /family\b/

# Identifiers
#
# A Haskell module name and a qualified reference are written as dot-joined
# segments with no spaces (`Data.Map.Strict`, `Map.insertWith`). The lexer is
# first-match-in-order, so the dotted forms must be defined BEFORE the
# single-segment `ConIdent`/`VarIdent`; otherwise `Data.Map.Strict` lexes as
# three idents around two `Operator` dots and `module`/`import` capture only
# the first segment, producing a `hackage:Data` dependency instead of
# `Data.Map.Strict` and no Module edge at all.
#
# `QualVarIdent` (a qualified *value*, `Map.insertWith`) is listed first
# because it ends in a lowercase segment, which `QualConIdent` would not
# match; both are needed so that a qualified use inside an expression stays a
# single token instead of re-introducing the `Operator .` split.
TOKEN QualVarIdent /[A-Z][a-zA-Z0-9_']*(?:\.[A-Z][a-zA-Z0-9_']*)*\.[a-z_][a-zA-Z0-9_']*/
TOKEN QualConIdent /[A-Z][a-zA-Z0-9_']*(?:\.[A-Z][a-zA-Z0-9_']*)+/
TOKEN ConIdent /[A-Z][a-zA-Z0-9_']*/
TOKEN VarIdent /[a-z_][a-zA-Z0-9_']*/

# Multi-character operators (must precede single-char punctuation and generic Operator)
TOKEN DCOLON /::/
TOKEN ARROW  /->/
TOKEN LARROW /<-/
TOKEN DARROW /=>/

# Punctuation (must precede generic Operator to avoid = | being consumed as Operator)
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN BACKTICK /`/
TOKEN PIPE     /\|/
TOKEN EQ       /=/
TOKEN AT       /@/

# Generic operator (after specific punctuation to avoid conflicts)
TOKEN Operator /[!#$%&*+.\/<=>?\\^|\-~:]+/

=== grammar
Module -> Item*

# `Other` is a catch-all accepting any single token, so the start rule can
# never stop in front of something the declaration rules do not model (a
# `where`-bound helper, an operator definition, a GADT block). Without it a
# single unmodelled construct truncates the parse and every declaration after
# it is silently dropped.
Item -> NL
     / ModuleDecl
     / ImportDecl
     / DataDecl
     / NewtypeDecl
     / TypeDecl
     / ClassDecl
     / InstanceDecl
     / FunctionDecl
     / DocComment
     / DocBlockComment
     / Other

# A Haddock doc block: consecutive `-- |` / `--` continuation lines, or one
# `{- | ... -}` block comment. Haddock continuation lines after the first are
# plain `--` comments, so they lex as `LineComment` and must be absorbed here
# or they break the declaration that follows.
DocBlock -> ( DocComment / DocBlockComment ) ( NL LineComment )*

# Module declaration
#
# The header name is a dotted module path (`Data.Task.Scheduler`), which the
# lexer emits as a single `QualConIdent`; a single-segment name stays a
# `ConIdent`, so both are accepted.
#
# The export list is written across many lines, one entry per line, with the
# closing paren and `where` on their own line. Every `NL*` slot below absorbs
# those newlines. Without them the whole header fails to match, falls through
# to `Other`, and the file gets no Module edge at all.
ModuleDecl -> ( Pragma / NL )* doc:DocBlock? ( Pragma / NL )* KW_module id:( QualConIdent / ConIdent ) NL* ( LPAREN ExportList RPAREN NL* )? KW_where
ExportList -> NL* Export ( NL* COMMA NL* Export )* NL* COMMA? NL*
# `Thing(..)`, `Thing(mk, run)`, a bare value, or a re-exported module.
Export -> KW_module ( QualConIdent / ConIdent )
       / ( QualConIdent / QualVarIdent / ConIdent / VarIdent / LPAREN Operator RPAREN ) ( LPAREN NL* ( Operator / ExportSubList )? NL* RPAREN )?
ExportSubList -> ExportSubItem ( NL* COMMA NL* ExportSubItem )*
ExportSubItem -> VarIdent / ConIdent / LPAREN Operator RPAREN

# Import declaration
#
# `path` accepts the dotted form first: `import Data.Map.Strict` must yield
# the full path in `via`, not just its first segment.
ImportDecl -> KW_import KW_qualified? path:( QualConIdent / ConIdent ) ( KW_as ( QualConIdent / ConIdent ) )? KW_hiding? ( LPAREN ImportList RPAREN )?
ImportList -> NL* Import ( NL* COMMA NL* Import )* NL* COMMA? NL*
Import -> ( ConIdent / VarIdent / LPAREN Operator RPAREN ) ( LPAREN NL* ( Operator / ImportSubList )? NL* RPAREN )?
ImportSubList -> ImportSubItem ( NL* COMMA NL* ImportSubItem )*
ImportSubItem -> VarIdent / ConIdent / LPAREN Operator RPAREN

# Data declaration
#
# The constructor list and the record fields run across lines, so `NL*` sits
# before `=`, around each `|`, and inside the record braces.
DataDecl -> doc:DocBlock? NL* KW_data id:ConIdent TypeVars? NL* ( EQ NL* DataCons ( NL* PIPE NL* DataCons )* )? NL* DerivingClause?
DataCons -> cons_doc:DocBlock? NL* cons_id:ConIdent ( NL* RecordBody / ConArg* )
# Record syntax: `{ field :: Type, ... }`. Each field is captured on its own
# so a record's fields become Field members of their data type rather than
# being mistaken for top-level functions.
RecordBody -> LBRACE NL* RecordField ( NL* COMMA NL* RecordField )* NL* COMMA? NL* RBRACE
RecordField -> field_doc:DocBlock? NL* field_id:VarIdent ( COMMA NL* VarIdent )* DCOLON Type
ConArg -> TypeAtom
TypeVars -> VarIdent+
DerivingClause -> KW_deriving ( DerivingStrategy )? ( ConIdent / LPAREN NL* ConIdent ( NL* COMMA NL* ConIdent )* NL* RPAREN )
DerivingStrategy -> VarIdent

# Newtype declaration
NewtypeDecl -> doc:DocBlock? NL* KW_newtype id:ConIdent TypeVars? NL* EQ NL* ConIdent ( NL* RecordBody / TypeAtom* ) NL* DerivingClause?

# Type synonym declaration
TypeDecl -> doc:DocBlock? NL* KW_type KW_family? id:ConIdent TypeVars? ( NL* EQ Type )?

# Class declaration
#
# `ClassHeader` is a separate sub-rule that fires BEFORE the body is parsed,
# so its `bind` of the class id is already in scope when the member rules
# run (events fire bottom-up, so a label on `ClassDecl` itself would not be
# visible to `MethodSig`).
ClassDecl -> ClassHeader ClassBody?
ClassHeader -> doc:DocBlock? NL* KW_class Context? id:ConIdent TypeVars? ( Operator TypeVars )? KW_where
Context -> LPAREN Constraint ( COMMA Constraint )* RPAREN DARROW / Constraint DARROW
Constraint -> ConIdent ( VarIdent / ConIdent )+
ClassBody -> ( NL ClassMember )+
# A class body is indentation-delimited, which a token grammar cannot see, so
# membership ends at the first construct that cannot be a member. Only method
# signatures, docs, comments and blank lines qualify; a `default` method body
# is an ordinary FunctionDecl and is intentionally NOT a member, so the body
# stops there and the equation is picked up as a top-level item instead of
# swallowing the rest of the file.
ClassMember -> MethodSig / DocComment / DocBlockComment / LineComment / BlockComment
MethodSig -> method_doc:DocBlock? NL* method_id:( VarIdent / LPAREN Operator RPAREN ) DCOLON Type

# Instance declaration
InstanceDecl -> doc:DocBlock? NL* KW_instance Context? ( QualConIdent / ConIdent ) TypeAtom* KW_where?

# Function declaration.
#
# A top-level function is written as a type signature followed by one or more
# defining equations:
#
#     -- | Doc.
#     schedule :: [(String, Priority)] -> [String]
#     schedule = map fst . sortOn snd
#
# Both lines must parse, but they describe ONE symbol. Emitting a declares
# edge from each form produced two identical edges per function. The rule now
# has a single alternative: the signature, optionally followed by its
# equations. `FunctionEquation` is a separate sub-rule with NO `func_id`
# label, so it can be reached as a standalone item (for a function written
# without a signature) while contributing no second declares edge of its own.
FunctionDecl -> doc:DocBlock? NL* func_id:VarIdent DCOLON sig:Type ( NL+ FunctionEquation )*
FunctionEquation -> VarIdent Pattern* EQ Expr WhereBlock?
# `where`-bound helpers are local to their equation and must not surface as
# top-level declarations, so the block is consumed here as opaque text.
#
# The block is indentation-delimited, which a token grammar cannot see. It is
# therefore bounded the same way a class body is: a `where` line, then lines
# that must each be non-blank. `( NL WhereLine )*` stops at the first blank
# line (two consecutive NLs), which is where the helper block ends in
# idiomatic code. A greedy `( NL / Atom )*` here instead swallowed every
# following declaration to end of file.
WhereBlock -> NL* KW_where WhereLine* ( NL WhereLine+ )*
WhereLine -> ExprAtom / KW_let / KW_in / KW_do / KW_case / KW_of / KW_if / KW_then / KW_else / KW_where

# Pattern
Pattern -> VarIdent / ConIdent / QualConIdent / Number / String / Char / LBRACE ( NL / Atom )* RBRACE / LPAREN Pattern* RPAREN / LBRACKET Pattern* RBRACKET / Operator / COMMA / BACKTICK / AT

# Types
Type -> TypeApp ( ( ARROW / DARROW / Operator / COMMA ) TypeApp )*
# A type application is a head atom followed by its arguments, written by
# juxtaposition with nothing in between.
TypeApp -> TypeAtom TypeAtom*
TypeAtom -> QualConIdent / QualVarIdent / ConIdent / VarIdent / Number / LPAREN Type? RPAREN / LBRACKET Type? RBRACKET / LBRACE ( NL / Atom )* RBRACE

# Expressions
#
# An equation's right-hand side is opaque: it is consumed as a balanced token
# soup so that whatever it contains cannot break the enclosing declaration.
# `NL` is excluded so the expression stops at end of line and the next
# declaration is seen; continuation lines are reached through
# `( NL+ FunctionEquation )*` above.
Expr -> ExprAtom+
ExprAtom -> VarIdent / ConIdent / QualVarIdent / QualConIdent / Number / String / Char / LPAREN / RPAREN / LBRACE / RBRACE / LBRACKET / RBRACKET / COMMA / SEMI / BACKTICK / PIPE / EQ / DCOLON / ARROW / LARROW / DARROW / AT / Operator / Pragma / KW_let / KW_in / KW_do / KW_case / KW_of / KW_if / KW_then / KW_else

Atom -> ExprAtom / NL / DocComment / DocBlockComment / LineComment / BlockComment / KW_module / KW_import / KW_qualified / KW_as / KW_hiding / KW_data / KW_newtype / KW_type / KW_class / KW_instance / KW_deriving / KW_where / KW_family

Other -> Atom

=== attrs
on ModuleDecl:    def id kind=Module doc=doc
on DataDecl:      def id kind=Data doc=doc
on NewtypeDecl:   def id kind=Newtype doc=doc
on TypeDecl:      def id kind=Type doc=doc
on ClassHeader:   def id kind=Class doc=doc
on FunctionDecl:  def func_id kind=Function doc=doc
on DataCons:      def cons_id kind=Constructor doc=cons_doc
on RecordField:   def field_id kind=Field doc=field_doc
on MethodSig:     def method_id=method_id_text kind=Method doc=method_doc


=== features
function_kinds: Function
identifier_kinds: VarIdent, ConIdent
vocabulary_token_kinds: DocComment, DocBlockComment, String

=== semantics
# Import dependency.
#
# `$path` is the full dotted module path, because the lexer keeps it as one
# `QualConIdent` token. The resolver's `module_path_style: dot` turns it into
# a file path; unresolved names fall back to `hackage:`.
on ImportDecl {
  edge moduleDependsOn from $file to $resolve($path) attrs obj("via", $path, "dep_kind", "value")
}

# Haskell top-level declarations. Visibility is controlled by the module
# export list rather than per declaration, so every top-level declaration is
# emitted.
#
# `$doc` holds only the LAST token of a doc block; `$doc_text` is the block's
# full accumulated text, which is what doc coverage and README generation
# need. `trim` strips the leading space Haddock leaves after `-- |`.
on ModuleDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Module", "doc", trim($doc_text))
}
on DataDecl {
  # Publish the data type's symbol id so its constructors and record fields
  # can attach to it. `bind` is visible to rules that fire later; because
  # events are bottom-up, the members have already fired by the time this
  # runs, which is why constructors resolve their parent through `$scope`
  # on the NEXT declaration instead. See DataCons below.
  bind ns "value" name "current_data" to concat($file, "::", $id)
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Data", "doc", trim($doc_text))
}
on NewtypeDecl {
  bind ns "value" name "current_data" to concat($file, "::", $id)
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Newtype", "doc", trim($doc_text))
}
on TypeDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Type", "doc", trim($doc_text))
}
# The class HEADER carries the declares edge and opens the scope frame, not
# `ClassDecl`. Events fire bottom-up, so `ClassDecl` runs after its members; a
# header sub-rule that matches before the body is entered is the only place a
# binding is in scope for `MethodSig`.
#
# The binding lives in a frame of its own: `scope push` opens it here and
# `ClassDecl` — which fires only once the whole class body is complete — closes
# it with `scope pop`. Without the pop the class stayed "current" for the rest
# of the file, so a `MethodSig` belonging to a LATER class, or none at all, was
# attributed to it.
on ClassHeader {
  scope push
  bind ns "value" name "current_class" to concat($file, "::", $id)
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Class", "doc", trim($doc_text))
}
on ClassDecl { scope pop }
# One edge per function: the rule matches the signature plus its equations as
# a single declaration, so a documented `f :: T` / `f x = ...` pair no longer
# produces two identical declares edges.
on FunctionDecl {
  edge declares from $file to concat($file, "::", $func_id) attrs obj("name", $func_id, "kind", "Function", "doc", trim($doc_text))
}

# Data constructors and record fields attach to their data type.
#
# `DataCons` fires BEFORE its enclosing `DataDecl` (bottom-up), so the bind
# from that same declaration is not yet in scope. The id is therefore rebuilt
# from `$file` and the constructor name, and the parent link is carried in
# the `parent` attr, which the enrichment pass uses to nest the member.
on DataCons {
  edge declares from $file to concat($file, "::", $cons_id) attrs obj("name", $cons_id, "kind", "Constructor", "doc", trim($cons_doc_text))
}
on RecordField {
  edge declares from $file to concat($file, "::", $field_id) attrs obj("name", $field_id, "kind", "Field", "doc", trim($field_doc_text))
}

# Class methods attach to the class published by `ClassHeader`, which has
# already fired by the time a member is reduced.
on MethodSig when $scope("value", "current_class") {
  let parent = $scope("value", "current_class")
  let name = trim($method_id_text)
  edge declares from parent to concat(parent, "::", name) attrs obj("name", name, "kind", "Method", "doc", trim($method_doc_text))
}

=== resolver
relative_prefixes: ./, ../
module_path_style: dot
resolve:
  - manifest: package.yaml @ dependencies
  - manifest: *.cabal @ build-depends
  - manifest: cabal.project @ packages
  - marker: package.yaml, *.cabal, cabal.project, stack.yaml
  - index: /src
  - ext: .hs, .lhs
  - fallback: hackage:
