kgf 0.6
language: javascript-jsx
sources: .jsx
extends: javascript

# JSX is JavaScript plus JSX syntax. `=== lex` adds the JSX tokens,
# `=== grammar` adds the JSX element rules, and `=== resolver` differs too:
# a bare `./Button` import in a .jsx file has to resolve to `Button.jsx` and
# `./dir` to `dir/index.jsx`, so this spec's resolver adds `.jsx` to the base
# extension and index lists. attrs, features, semantics and ignore are
# inherited from `javascript` unchanged.

=== lex
# Whitespace (not comments - we capture those for JSDoc)
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# JSDoc comment block /** ... */
TOKEN DocComment /\/\*\*([\s\S]*?)\*\//

# Regular comments
TOKEN LineComment /\/\/[^\r\n]*/
TOKEN BlockComment /\/\*[\s\S]*?\*\//

# String literals (including template literals)
TOKEN TemplateLit /`(?:[^`\\$]|\\.|\$(?!\{)|\$\{[^}]*\})*`/
TOKEN StringLit /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/

# JSX tokens (order matters - more specific first)
TOKEN JSX_FRAG_CLOSE /<\/>/
TOKEN JSX_FRAG_OPEN /<>/
TOKEN JSX_CLOSE_START /<\//
TOKEN JSX_SELF_CLOSE /\/>/

# Keywords
KEYWORD KW_import     /import\b/
KEYWORD KW_from       /from\b/
KEYWORD KW_export     /export\b/
KEYWORD KW_default    /default\b/
KEYWORD KW_function   /function\b/
KEYWORD KW_const      /const\b/
KEYWORD KW_let        /let\b/
KEYWORD KW_var        /var\b/
KEYWORD KW_as         /as\b/
KEYWORD KW_return     /return\b/
KEYWORD KW_new        /new\b/
KEYWORD KW_class      /class\b/
KEYWORD KW_extends    /extends\b/
KEYWORD KW_async      /async\b/
KEYWORD KW_await      /await\b/
KEYWORD KW_if         /if\b/
KEYWORD KW_else       /else\b/
KEYWORD KW_for        /for\b/
KEYWORD KW_while      /while\b/
KEYWORD KW_do         /do\b/
KEYWORD KW_switch     /switch\b/
KEYWORD KW_case       /case\b/
KEYWORD KW_break      /break\b/
KEYWORD KW_continue   /continue\b/
KEYWORD KW_throw      /throw\b/
KEYWORD KW_static     /static\b/
KEYWORD KW_typeof     /typeof\b/
KEYWORD KW_in         /in\b/

# Identifiers and literals
TOKEN Ident         /[A-Za-z_$][A-Za-z0-9_$]*/
TOKEN Number        /0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\.[0-9]+)?/

# Regex literal /.../flags.
# Defined after the comment and JSX tokens so `//`, `/*`, `</` and `/>` keep
# priority, and before SLASH so a regex body stays one token instead of
# shredding into punctuation (dropping `^`, `@` and `\` on the way).
TOKEN RegexLit /\/(?![*\/])([^\/\\\[\r\n]|\\[^\r\n]|\[([^\]\\\r\n]|\\[^\r\n])*\])+\/[dgimsuvy]*/

# Punctuation
TOKEN LBRACE        /\{/
TOKEN RBRACE        /\}/
TOKEN LPAREN        /\(/
TOKEN RPAREN        /\)/
TOKEN LBRACKET      /\[/
TOKEN RBRACKET      /\]/
TOKEN LT            /</
TOKEN GT            />/
TOKEN SEMI          /;/
TOKEN COMMA         /,/
TOKEN COLON         /:/
TOKEN DOT           /\./
TOKEN ARROW         /=>/
TOKEN EQ            /=/
TOKEN QMARK         /\?/
TOKEN STAR          /\*/
TOKEN PIPE          /\|/
TOKEN AMP           /&/
TOKEN SLASH         /\//
TOKEN PLUS          /\+/
TOKEN MINUS         /-/
TOKEN BANG          /!/
TOKEN PERCENT /%/
TOKEN AT      /@/
TOKEN CARET   /\^/
TOKEN TILDE   /~/
TOKEN BACKSLASH /\\/

# JSX text content.
# Text between JSX tags is prose, not code: it may hold punctuation, symbols
# and any non-ASCII character. Defined last so every real syntax token keeps
# priority, and excluding the characters that delimit JSX (`<`, `>`, `{`, `}`)
# plus quotes and whitespace, which are lexed as their own tokens.
TOKEN TextChunk /[^<>{}()\[\]"'`\s\\]+/

=== grammar
Module -> Item*

Item -> NL
     / ImportDecl
     / ExportDecl
     / FunctionDecl
     / ClassDecl
     / VarDecl
     / DocComment
     / Other

# Import declarations
ImportDecl -> KW_import ( SideEffect / ImportNS / ImportNamedDefault / ImportNamed / ImportDefault ) SEMI?
SideEffect -> path:StringLit
ImportNS -> STAR KW_as ns:Ident KW_from from:StringLit
ImportNamedDefault -> defId:Ident COMMA LBRACE NL* ImportSpecList NL* RBRACE KW_from from:StringLit
ImportNamed -> LBRACE NL* ImportSpecList NL* RBRACE KW_from from:StringLit
ImportDefault -> defId:Ident KW_from from:StringLit
ImportSpecList -> ImportSpec ( NL* COMMA NL* ImportSpec )* NL* COMMA?
ImportSpec -> origin:Ident ( KW_as local:Ident )?

ExportDecl -> doc:DocComment? NL* KW_export KW_default? ( FunctionDecl / ClassDecl / VarDecl )
           / KW_export STAR KW_from from:StringLit SEMI?
           / KW_export LBRACE NL* ExportSpecList NL* RBRACE KW_from from:StringLit SEMI?
           / KW_export LBRACE NL* ExportSpecList NL* RBRACE SEMI?
ExportSpecList -> ExportSpec ( NL* COMMA NL* ExportSpec )* NL* COMMA?
ExportSpec -> origin:Ident ( KW_as local:Ident )?

FunctionDecl -> doc:DocComment? NL* KW_async? KW_function id:Ident LPAREN NL* ParamList? NL* RPAREN Body?
ClassDecl -> ClassHeader ClassBody
ClassHeader -> doc:DocComment? NL* KW_class id:Ident ( KW_extends Ident ( DOT Ident )* )?
VarDecl -> doc:DocComment? NL* (KW_const / KW_let / KW_var) id:Ident ( EQ Expr )? SEMI?

# Class bodies
ClassBody -> LBRACE ClassMember* RBRACE
ClassMember -> MethodDecl / PropertyDecl / NL / LineComment / BlockComment
Modifier -> KW_static / KW_async
# The doc comment is captured on the member declaration itself, with the
# modifiers absorbed there too. Capturing it on the wrapper instead left
# the member's own $doc unbound, so every class member was reported
# undocumented no matter what JSDoc preceded it.
MethodDecl -> doc:DocComment? NL* Modifier* id:Ident LPAREN NL* ParamList? NL* RPAREN ( Body / SEMI? )
PropertyDecl -> doc:DocComment? NL* Modifier* id:Ident ( EQ Expr )? SEMI?

# Parameters
ParamList -> Param ( NL* COMMA NL* Param )* NL* COMMA?
Param -> DestructurePattern ( EQ Expr )?
       / id:Ident ( EQ Expr )?
DestructurePattern -> LBRACE DestructureField ( COMMA DestructureField )* COMMA? RBRACE
                    / LBRACKET DestructureField ( COMMA DestructureField )* COMMA? RBRACKET
DestructureField -> Ident ( COLON Ident )? ( EQ SimpleExpr )? / DOT DOT DOT Ident
SimpleExpr -> Ident / Number / StringLit / TemplateLit

# JSX Elements
JsxElement -> JsxSelfClosing / JsxOpenClose / JsxFragment
JsxSelfClosing -> LT JsxTagName JsxAttr* JSX_SELF_CLOSE
JsxOpenClose -> LT JsxTagName JsxAttr* GT JsxChild* JSX_CLOSE_START JsxTagName GT
JsxFragment -> JSX_FRAG_OPEN JsxChild* JSX_FRAG_CLOSE
JsxTagName -> Ident ( DOT Ident )*
JsxAttr -> Ident ( EQ JsxAttrValue )?
JsxAttrValue -> StringLit / TemplateLit / LBRACE Expr RBRACE
JsxChild -> JsxElement / LBRACE Expr RBRACE / JsxText
JsxText -> ( Ident / Number / StringLit / TemplateLit / TextChunk )+

# Bodies and expressions (simplified - just balance braces)
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / BodyAtom
Expr -> JsxElement / ExprPart+
ExprPart -> ObjectLit / ArrayLit / LBRACE BodyContent* RBRACE / LPAREN ExprPart* RPAREN / LBRACKET ExprPart* RBRACKET / ExprAtom
ObjectLit -> LBRACE ObjectEntry* RBRACE
ObjectEntry -> NL / LineComment / BlockComment / DocComment / ObjectProp COMMA? / COMMA
ObjectProp -> PropertyName COLON Expr / PropertyName
PropertyName -> Ident / StringLit / Number
ArrayLit -> LBRACKET ArrayEntry* RBRACKET
ArrayEntry -> NL / LineComment / BlockComment / DocComment / Expr COMMA? / COMMA
ExprAtom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / DOT / COMMA / COLON / LT / GT / EQ / ARROW / QMARK / STAR / PIPE / AMP / SLASH / PLUS / MINUS / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / NL / LineComment / BlockComment / DocComment / KW_as / KW_new / KW_typeof / KW_const / KW_in / JSX_SELF_CLOSE / JSX_CLOSE_START / JSX_FRAG_OPEN / JSX_FRAG_CLOSE
BodyAtom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / SEMI / COMMA / COLON / DOT / EQ / ARROW / QMARK / STAR / PIPE / AMP / LT / GT / SLASH / PLUS / MINUS / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / KW_async / KW_await / KW_return / KW_if / KW_else / KW_for / KW_while / KW_do / KW_switch / KW_case / KW_break / KW_continue / KW_new / KW_throw / KW_const / KW_let / KW_var / KW_function / KW_class / KW_extends / KW_static / KW_import / KW_export / KW_from / KW_as / KW_default / KW_typeof / KW_in / NL / LineComment / BlockComment / DocComment / JSX_SELF_CLOSE / JSX_CLOSE_START / JSX_FRAG_OPEN / JSX_FRAG_CLOSE
Atom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / SEMI / COMMA / COLON / DOT / EQ / ARROW / QMARK / STAR / PIPE / AMP / LT / GT / LPAREN / RPAREN / SLASH / PLUS / MINUS / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / NL / LineComment / BlockComment / DocComment / KW_as / KW_typeof / KW_in / KW_export / KW_function / KW_class / KW_const / KW_let / KW_var / KW_async / KW_return / KW_if / KW_else / KW_for / KW_while / KW_do / KW_break / KW_continue / KW_new / KW_throw / KW_default / KW_switch / KW_case / KW_import / KW_from / KW_extends / KW_static / KW_await

# Module-level fallback.
#
# A statement that is not a declaration (a bare call, an assignment, an IIFE)
# still has to be consumed, or the module parse stops there and every later
# declaration is silently dropped. It is consumed in two steps:
#
#   1. OpaqueGroup — a balanced bracket group taken as one opaque unit, so the
#      braces of a call's object-literal argument or of a callback body do not
#      have to be understood, only balanced.
#   2. a single token of any kind, including a lone bracket whose partner is
#      missing, so even malformed or truncated source cannot stop the parse.
Other -> Atom / OpaqueGroup / LBRACE / RBRACE / LBRACKET / RBRACKET / LPAREN / RPAREN

# Inside a group only balanced sub-groups and plain atoms are allowed, so a
# group never swallows an unmatched opening bracket and stays truly balanced.
# Atom lists LPAREN/RPAREN, so they are excluded here explicitly.
OpaqueGroup -> LBRACE OpaqueInner* RBRACE / LBRACKET OpaqueInner* RBRACKET / LPAREN OpaqueInner* RPAREN
OpaqueInner -> OpaqueGroup / !LPAREN !RPAREN Atom

=== resolver
relative_prefixes: ./, ../, /
module_path_style: slash
project_config: package.json
install_cmd: npm install {name}
build_cmd: npm run build
resolve:
  - exact:
  # Same alias maps as the base spec (jsconfig/tsconfig `paths` + `baseUrl`).
  - namespace_map: jsconfig.json @ compilerOptions.paths + compilerOptions.baseUrl
  - namespace_map: tsconfig.json @ compilerOptions.paths + compilerOptions.baseUrl
  - manifest: package.json @ exports["."] | main | module
  - index: /index.js, /index.jsx, /index.mjs
  - ext: .js, .jsx, .mjs, .cjs
  - ancestors: node_modules/
  - fallback: npm:
