kgf 0.6
language: typescript-jsx
sources: .tsx
extends: typescript

# TSX is TypeScript plus JSX syntax. The two sections below differ from the
# base — `=== lex` adds the JSX tokens (and a dedicated template-literal
# token), `=== grammar` adds the JSX element rules — and everything else
# (attrs, features, semantics, resolver, ignore) is inherited unchanged.
# A derived section replaces the base's whole, so both are written out in
# full rather than as a diff against TypeScript's.

=== lex
# Whitespace (not comments - we capture those)
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# JSDoc comment block /** ... */
TOKEN DocComment /\/\*\*([\s\S]*?)\*\//

# Regular comments (skip for doc purposes)
TOKEN LineComment /\/\/[^\r\n]*/
TOKEN BlockComment /\/\*[\s\S]*?\*\//

# String literals (including template literals)
TOKEN TemplateLit /`(?:[^`\\$]|\\.|\$(?!\{)|\$\{[^}]*\})*`/
TOKEN StringLit /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/

# JSX tokens (order matters - more specific first)
TOKEN JSX_FRAG_CLOSE /<\/>/
TOKEN JSX_FRAG_OPEN /<>/
TOKEN JSX_CLOSE_START /<\//
TOKEN JSX_SELF_CLOSE /\/>/

# Keywords
KEYWORD KW_import    /import\b/
KEYWORD KW_from      /from\b/
KEYWORD KW_export    /export\b/
KEYWORD KW_default   /default\b/
KEYWORD KW_function  /function\b/
KEYWORD KW_class     /class\b/
KEYWORD KW_interface /interface\b/
KEYWORD KW_type      /type\b/
KEYWORD KW_const     /const\b/
KEYWORD KW_let       /let\b/
KEYWORD KW_var       /var\b/
KEYWORD KW_enum      /enum\b/
KEYWORD KW_extends   /extends\b/
KEYWORD KW_implements /implements\b/
KEYWORD KW_async     /async\b/
KEYWORD KW_await     /await\b/
KEYWORD KW_return    /return\b/
KEYWORD KW_public    /public\b/
KEYWORD KW_private   /private\b/
KEYWORD KW_protected /protected\b/
KEYWORD KW_static    /static\b/
KEYWORD KW_readonly  /readonly\b/
KEYWORD KW_abstract  /abstract\b/
KEYWORD KW_as        /as\b/
KEYWORD KW_typeof    /typeof\b/
KEYWORD KW_keyof     /keyof\b/
KEYWORD KW_infer     /infer\b/
KEYWORD KW_in        /in\b/
KEYWORD KW_satisfies /satisfies\b/
KEYWORD KW_if        /if\b/
KEYWORD KW_else      /else\b/
KEYWORD KW_switch    /switch\b/
KEYWORD KW_case      /case\b/
KEYWORD KW_for       /for\b/
KEYWORD KW_while     /while\b/
KEYWORD KW_do        /do\b/
KEYWORD KW_break     /break\b/
KEYWORD KW_continue  /continue\b/
KEYWORD KW_new       /new\b/
KEYWORD KW_throw     /throw\b/

# Identifiers and literals
TOKEN Ident   /[A-Za-z_$][A-Za-z0-9_$]*/
TOKEN Number  /0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\.[0-9]+)?/

# Regex literal /.../flags.
# Defined after the comment and JSX tokens so `//`, `/*`, `</` and `/>` keep
# priority, and before SLASH so a regex body stays one token instead of
# shredding into punctuation (dropping `^`, `@` and `\` on the way).
TOKEN RegexLit /\/(?![*\/])([^\/\\\[\r\n]|\\[^\r\n]|\[([^\]\\\r\n]|\\[^\r\n])*\])+\/[dgimsuvy]*/

# Punctuation
TOKEN LBRACE  /\{/
TOKEN RBRACE  /\}/
TOKEN LPAREN  /\(/
TOKEN RPAREN  /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LT      /</
TOKEN GT      />/
TOKEN SEMI    /;/
TOKEN COMMA   /,/
TOKEN COLON   /:/
TOKEN DOT     /\./
TOKEN ARROW   /=>/
TOKEN EQ      /=/
TOKEN QMARK   /\?/
TOKEN STAR    /\*/
TOKEN PIPE    /\|/
TOKEN AMP     /&/
TOKEN SLASH   /\//
TOKEN PLUS    /\+/
TOKEN MINUS   /-/
TOKEN BANG    /!/
TOKEN PERCENT /%/
TOKEN AT      /@/
TOKEN CARET   /\^/
TOKEN TILDE   /~/
TOKEN BACKSLASH /\\/

# JSX text content.
# Text between JSX tags is prose, not code: it may hold punctuation, symbols
# and any non-ASCII character. Defined last so every real syntax token keeps
# priority, and excluding the characters that delimit JSX (`<`, `>`, `{`, `}`)
# plus quotes and whitespace, which are lexed as their own tokens.
TOKEN TextChunk /[^<>{}()\[\]"'`\s\\]+/

=== grammar
# Module with optional leading module doc (JSDoc with @module or @packageDocumentation)
Module -> ModuleDoc? Item*

# Module-level documentation (JSDoc at file top).
# Negative lookahead: only match when the DocComment is NOT followed by a
# declaration/export — otherwise the JSDoc belongs to the first declaration.
# PEG backtracks if the lookahead fails, letting Item*/ExportDecl/etc. capture it.
ModuleDoc -> module_doc:DocComment NL* !DeclKeyword

# Declaration start keywords (used for negative lookahead in ModuleDoc)
DeclKeyword -> KW_export / KW_import / KW_function / KW_class / KW_interface / KW_type / KW_const / KW_let / KW_var / KW_enum / KW_async / KW_abstract / KW_default

Item -> NL
     / ImportDecl
     / ExportDecl
     / FunctionDecl
     / ClassDecl
     / InterfaceDecl
     / TypeDecl
     / VarDecl
     / EnumDecl
     / DocComment
     / Other

# Import declarations
# `import type` (TS 3.8+) is treated the same as `import` for dependency analysis
ImportDecl -> KW_import KW_type? ( SideEffect / ImportNS / ImportNamedDefault / ImportNamed / ImportDefault ) SEMI?
SideEffect -> path:StringLit
ImportNS -> STAR KW_as ns:Ident KW_from from:StringLit
ImportNamedDefault -> defId:Ident COMMA LBRACE NL* ImportSpecList NL* RBRACE KW_from from:StringLit
ImportNamed -> LBRACE NL* ImportSpecList NL* RBRACE KW_from from:StringLit
ImportDefault -> defId:Ident KW_from from:StringLit
ImportSpecList -> ImportSpec ( NL* COMMA NL* ImportSpec )* NL* COMMA?
ImportSpec -> KW_type? origin:Ident ( KW_as local:Ident )?

# Documented declarations (doc comment preceding)
ExportDecl -> doc:DocComment? NL* KW_export KW_default? ( FunctionDecl / ClassDecl / InterfaceDecl / TypeDecl / VarDecl / EnumDecl )
           / KW_export STAR KW_from from:StringLit SEMI?
           / KW_export KW_type? LBRACE NL* ExportList NL* RBRACE KW_from from:StringLit SEMI?
           / KW_export KW_type? LBRACE NL* ExportList NL* RBRACE SEMI?
ExportList -> KW_type? Ident ( KW_as Ident )? ( NL* COMMA NL* KW_type? Ident ( KW_as Ident )? )* NL* COMMA?

FunctionDecl -> doc:DocComment? NL* KW_async? KW_function id:Ident GenericParams? LPAREN NL* ParamList? NL* RPAREN TypeAnnotation? Body?
ClassDecl -> ClassHeader ClassBody
ClassHeader -> doc:DocComment? NL* KW_abstract? KW_class id:Ident GenericParams? ExtendsClause? ImplementsClause?
InterfaceDecl -> InterfaceHeader InterfaceBody
InterfaceHeader -> doc:DocComment? NL* KW_interface id:Ident GenericParams? ExtendsClause?
TypeDecl -> doc:DocComment? NL* KW_type id:Ident GenericParams? EQ NL* Type SEMI?
VarDecl -> doc:DocComment? NL* (KW_const / KW_let / KW_var) id:Ident TypeAnnotation? ( EQ expr:Expr )? SEMI?
EnumDecl -> EnumHeader EnumBody
EnumHeader -> doc:DocComment? NL* KW_enum id:Ident

# Class/Interface bodies
ClassBody -> LBRACE ClassMember* RBRACE
ClassMember -> MethodDecl / PropertyDecl / NL / LineComment / BlockComment
Modifier -> KW_public / KW_private / KW_protected / KW_static / KW_readonly / KW_abstract / KW_async
# The doc comment is captured on the member declaration itself, with the
# modifiers absorbed there too. Capturing it on the wrapper instead left
# the member's own $doc unbound, so every class member was reported
# undocumented no matter what JSDoc preceded it.
MethodDecl -> doc:DocComment? NL* Modifier* id:Ident GenericParams? LPAREN NL* ParamList? NL* RPAREN TypeAnnotation? ( Body / SEMI? )
PropertyDecl -> doc:DocComment? NL* Modifier* id:Ident QMARK? TypeAnnotation? ( EQ Expr )? SEMI?

InterfaceBody -> LBRACE InterfaceMember* RBRACE
InterfaceMember -> MethodSig / PropertySig / NL / LineComment / BlockComment
MethodSig -> doc:DocComment? NL* id:MemberName GenericParams? LPAREN NL* ParamList? NL* RPAREN TypeAnnotation? SEMI?
PropertySig -> doc:DocComment? NL* id:MemberName QMARK? TypeAnnotation? SEMI?
MemberName -> Ident / KW_type / KW_class / KW_interface / KW_enum / KW_function / KW_const / KW_let / KW_var / KW_default / KW_export / KW_import / KW_from / KW_as

EnumBody -> LBRACE EnumMember* RBRACE
EnumMember -> doc:DocComment? NL* id:Ident ( EQ EnumValue )? COMMA? / NL / LineComment / BlockComment
EnumValue -> StringLit / Number / Ident ( DOT Ident )* / PLUS / MINUS

# Parameters
ParamList -> Param ( NL* COMMA NL* Param )* NL* COMMA?
Param -> DestructurePattern TypeAnnotation? ( EQ Expr )?
       / id:Ident QMARK? TypeAnnotation? ( EQ Expr )?
DestructurePattern -> LBRACE DestructureField ( COMMA DestructureField )* COMMA? RBRACE
                    / LBRACKET DestructureField ( COMMA DestructureField )* COMMA? RBRACKET
DestructureField -> MemberName ( COLON MemberName )? ( EQ SimpleExpr )? / DOT DOT DOT Ident
SimpleExpr -> Ident / Number / StringLit / TemplateLit

# Type annotations
TypeAnnotation -> COLON Type

# Conditional type: A extends B ? C : D (right-associative)
# Leading PIPE? allows `type T = | A | B` (discriminated union style)
Type -> PIPE? NL* IntersectionType ( NL* PIPE NL* IntersectionType )* ConditionalTail?
ConditionalTail -> NL* KW_extends Type NL* QMARK NL* Type NL* COLON NL* Type
IntersectionType -> TypeAtom ( AMP TypeAtom )*

TypeAtom -> LPAREN NL* ParamList? NL* RPAREN ARROW Type
         / TypeOperator TypeAtom
         / KW_infer Ident ( KW_extends Type )?
         / Ident ( DOT Ident )* GenericArgs? IndexAccess* ArraySuffix*
         / StringLit / Number
         / LPAREN Type RPAREN
         / LBRACE NL* MappedType RBRACE
         / LBRACE TypeMembers RBRACE
         / LBRACKET TypeListOpt RBRACKET

# typeof, keyof, readonly as type-level operators
TypeOperator -> KW_typeof / KW_keyof / KW_readonly

# Array suffix T[] and indexed access T[K], T["key"], T[number]
ArraySuffix -> LBRACKET RBRACKET
IndexAccess -> LBRACKET Type RBRACKET

# Mapped type: { [K in keyof T]: T[K] }, { readonly [K in T]-?: V }
MappedType -> KW_readonly? LBRACKET Ident KW_in Type RBRACKET MappedModifier? COLON NL* Type SEMI? NL*
MappedModifier -> MINUS QMARK / PLUS QMARK / QMARK

GenericParams -> LT GenericParam ( COMMA GenericParam )* GT
GenericParam -> Ident ( KW_extends Type )? ( EQ Type )?
GenericArgs -> LT Type ( COMMA Type )* GT

TypeMembers -> TypeMember*
TypeMember -> KW_readonly? MemberName QMARK? COLON Type SEMI? / LBRACKET Ident COLON Type RBRACKET COLON Type SEMI? / NL / LineComment / BlockComment

TypeListOpt -> Type ( COMMA Type )*

ExtendsClause -> KW_extends TypeList
ImplementsClause -> KW_implements TypeList
TypeList -> Type ( COMMA Type )*

# JSX Elements
JsxElement -> JsxSelfClosing / JsxOpenClose / JsxFragment
JsxSelfClosing -> LT JsxTagName JsxAttr* JSX_SELF_CLOSE
JsxOpenClose -> LT JsxTagName JsxAttr* GT JsxChild* JSX_CLOSE_START JsxTagName GT
JsxFragment -> JSX_FRAG_OPEN JsxChild* JSX_FRAG_CLOSE
JsxTagName -> Ident ( DOT Ident )*
JsxAttr -> Ident ( EQ JsxAttrValue )?
JsxAttrValue -> StringLit / TemplateLit / LBRACE Expr RBRACE
JsxChild -> JsxElement / LBRACE Expr RBRACE / JsxText
JsxText -> ( Ident / Number / StringLit / TemplateLit / TextChunk )+

# Bodies and expressions (simplified - just balance braces)
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / BodyAtom
Expr -> JsxElement / ExprPart+
ExprPart -> ObjectLit / ArrayLit / LBRACE BodyContent* RBRACE / LPAREN ExprPart* RPAREN / LBRACKET ExprPart* RBRACKET / ExprAtom
ObjectLit -> LBRACE ObjectEntry* RBRACE
ObjectEntry -> NL / LineComment / BlockComment / DocComment / ObjectProp COMMA? / COMMA
ObjectProp -> PropertyName COLON Expr / PropertyName
PropertyName -> Ident / StringLit / Number
ArrayLit -> LBRACKET ArrayEntry* RBRACKET
ArrayEntry -> NL / LineComment / BlockComment / DocComment / Expr COMMA? / COMMA
ExprAtom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / DOT / COMMA / COLON / LT / GT / EQ / ARROW / QMARK / STAR / PIPE / AMP / PLUS / MINUS / SLASH / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / NL / LineComment / BlockComment / DocComment / KW_as / KW_satisfies / KW_new / KW_typeof / KW_const / KW_in / JSX_SELF_CLOSE / JSX_CLOSE_START / JSX_FRAG_OPEN / JSX_FRAG_CLOSE
BodyAtom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / SEMI / COMMA / COLON / DOT / EQ / ARROW / QMARK / STAR / PIPE / AMP / LT / GT / SLASH / PLUS / MINUS / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / KW_async / KW_await / KW_return / KW_if / KW_else / KW_switch / KW_case / KW_default / KW_for / KW_while / KW_do / KW_break / KW_continue / KW_new / KW_throw / KW_const / KW_let / KW_var / KW_function / KW_class / KW_interface / KW_type / KW_enum / KW_import / KW_export / KW_from / KW_as / KW_extends / KW_implements / KW_public / KW_private / KW_protected / KW_static / KW_readonly / KW_abstract / KW_typeof / KW_keyof / KW_infer / KW_in / KW_satisfies / NL / LineComment / BlockComment / DocComment / JSX_SELF_CLOSE / JSX_CLOSE_START / JSX_FRAG_OPEN / JSX_FRAG_CLOSE
Atom -> Ident / Number / StringLit / TemplateLit / RegexLit / TextChunk / SEMI / COMMA / COLON / DOT / EQ / ARROW / QMARK / STAR / PIPE / AMP / LT / GT / LPAREN / RPAREN / SLASH / PLUS / MINUS / BANG / PERCENT / AT / CARET / TILDE / BACKSLASH / NL / LineComment / BlockComment / DocComment / KW_as / KW_typeof / KW_keyof / KW_infer / KW_in / KW_satisfies / KW_export / KW_function / KW_class / KW_interface / KW_type / KW_enum / KW_const / KW_let / KW_var / KW_async / KW_return / KW_if / KW_else / KW_for / KW_while / KW_do / KW_break / KW_continue / KW_new / KW_throw / KW_default / KW_switch / KW_case / KW_import / KW_from / KW_extends / KW_implements / KW_abstract / KW_public / KW_private / KW_protected / KW_static / KW_readonly / KW_await

# Module-level fallback.
#
# A statement that is not a declaration (a bare call, an assignment, an IIFE)
# still has to be consumed, or the module parse stops there and every later
# declaration is silently dropped. It is consumed in two steps:
#
#   1. OpaqueGroup — a balanced bracket group taken as one opaque unit, so the
#      braces of a call's object-literal argument or of a callback body do not
#      have to be understood, only balanced.
#   2. a single token of any kind, including a lone bracket whose partner is
#      missing, so even malformed or truncated source cannot stop the parse.
Other -> Atom / OpaqueGroup / LBRACE / RBRACE / LBRACKET / RBRACKET / LPAREN / RPAREN

# Inside a group only balanced sub-groups and plain atoms are allowed, so a
# group never swallows an unmatched opening bracket and stays truly balanced.
# Atom lists LPAREN/RPAREN, so they are excluded here explicitly.
OpaqueGroup -> LBRACE OpaqueInner* RBRACE / LBRACKET OpaqueInner* RBRACKET / LPAREN OpaqueInner* RPAREN
OpaqueInner -> OpaqueGroup / !LPAREN !RPAREN Atom
