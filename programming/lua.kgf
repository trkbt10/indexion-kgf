kgf 0.6
language: lua
sources: .lua

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - block must precede line to avoid --[[ matching --
TOKEN DocComment /---(.*)/
TOKEN BlockComment /--\[\[[\s\S]*?\]\]/
TOKEN LineComment /--[^\r\n]*/

# String literals
TOKEN String /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'|\[\[[\s\S]*?\]\]|\[=\[[\s\S]*?\]=\]/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F]+|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/

# Keywords
KEYWORD KW_function /function\b/
KEYWORD KW_local    /local\b/
KEYWORD KW_end      /end\b/
KEYWORD KW_return   /return\b/
KEYWORD KW_if       /if\b/
KEYWORD KW_then     /then\b/
KEYWORD KW_elseif   /elseif\b/
KEYWORD KW_else     /else\b/
KEYWORD KW_for      /for\b/
KEYWORD KW_in       /in\b/
KEYWORD KW_while    /while\b/
KEYWORD KW_do       /do\b/
KEYWORD KW_repeat   /repeat\b/
KEYWORD KW_until    /until\b/
KEYWORD KW_break    /break\b/

# Built-in values
TOKEN BoolLit /\b(?:true|false)\b/
TOKEN NilLit /\bnil\b/

# Identifiers
TOKEN Ident /[a-zA-Z_][a-zA-Z0-9_]*/

# Operators
TOKEN Operator /[+\-*\/%^#<>=~]+|\.\.\.?|==|~=|<=|>=|<<|>>|\/\/|&|\||~/

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/
TOKEN EQ       /=/

=== grammar
Module -> Item*

# `Other` is a catch-all accepting any single token so the start rule can
# never stop in front of an unmodelled construct.
Item -> NL
     / FunctionDecl
     / LocalFunctionDecl
     / RequireDecl
     / LocalVarDecl
     / AssignmentDecl
     / DocComment
     / Other

# A Luadoc block: a `---` line plus its `--` continuation lines, which lex as
# `LineComment` and must be absorbed here or they break the declaration that
# follows.
DocBlock -> DocComment ( NL LineComment )*

# A block body, consumed as a BALANCED opaque group.
#
# This is the central fix for this spec. The previous `FunctionBody` was
# `( NL / ... / Expr )*` and `Statement` listed `KW_end` among the keywords it
# accepted; a body that can eat its own terminator never stops, so every
# `function ... end` failed to match and the whole file fell through to
# `Other` — zero edges while still reporting "Parse: SUCCESS".
#
# `BlockContent` excludes `end` (and `until`, which closes a `repeat`) and
# recurses into the nested block forms instead, so a body always stops at its
# own terminator.
Block -> BlockContent* KW_end
BlockContent -> BlockOpener BlockContent* KW_end
             / KW_repeat BlockContent* KW_until
             / LPAREN BlockContent* RPAREN
             / LBRACE BlockContent* RBRACE
             / LBRACKET BlockContent* RBRACKET
             / BlockAtom
# Every keyword that OPENS a block terminated by `end`.
#
# `if`/`for`/`while` are NOT listed: they are closed by `end`, but so is the
# `do`/`then` that follows them, and consuming the opener separately lets the
# inner `do ... end` pair up correctly. They are ordinary atoms here and the
# `do`/`then` carries the nesting.
BlockOpener -> KW_function / KW_do / KW_then
# Every token EXCEPT `end`, `until` and the bracket terminators handled above.
BlockAtom -> Ident / Number / String / BoolLit / NilLit / DOT / COMMA / COLON / SEMI / EQ / Operator / DocComment / LineComment / BlockComment / NL
          / KW_local / KW_return / KW_if / KW_elseif / KW_else / KW_for / KW_in / KW_while / KW_break

# Function declaration (global or a method on a table).
#
# `FunctionName` covers `f`, `M.f` and `M:f`; the label binds the LAST
# identifier, which is the method name, and `$id_text` holds the whole
# dotted/colon path.
FunctionDecl -> doc:DocBlock? NL* KW_function id:FunctionName LPAREN NL* ParamList? NL* RPAREN Block
FunctionName -> Ident ( ( DOT / COLON ) Ident )*

# Local function declaration
LocalFunctionDecl -> doc:DocBlock? NL* KW_local KW_function id:Ident LPAREN NL* ParamList? NL* RPAREN Block

# `local x = require("mod")` / `require "mod"` — Lua's only import form.
# The module name is a string literal, so `via` carries its text.
# The captures are INLINE rather than in a `RequireCall` sub-rule: a label
# bound in a referenced rule does not leak to its caller.
RequireDecl -> doc:DocBlock? NL* ( KW_local? NameList EQ )? req:Ident ( LPAREN NL* path:String NL* RPAREN / path:String )
NameList -> Ident ( COMMA Ident )*

# Local variable declaration
LocalVarDecl -> doc:DocBlock? NL* KW_local id:Ident ( COMMA Ident )* ( EQ ExprList )?

# Global assignment. `M.f = function(...) ... end` is how many modules define
# their methods, so the value may be a whole function body.
AssignmentDecl -> doc:DocBlock? NL* id:AssignTarget EQ Value
AssignTarget -> Ident ( ( DOT / COLON ) Ident )* ( LBRACKET BlockContent* RBRACKET )?
Value -> KW_function LPAREN NL* ParamList? NL* RPAREN Block / Expr

# Parameters
ParamList -> Param ( NL* COMMA NL* Param )*
Param -> param_id:Ident / Operator

# Expression list
ExprList -> Expr ( COMMA NL* Expr )*

# Expressions.
#
# A value is opaque: a balanced token soup that cannot break the enclosing
# declaration. `NL` is excluded so it stops at end of line.
Expr -> ExprAtom+
ExprAtom -> LPAREN BlockContent* RPAREN / LBRACE BlockContent* RBRACE / LBRACKET BlockContent* RBRACKET
         / Ident / Number / String / BoolLit / NilLit / DOT / COMMA / COLON / EQ / Operator

Atom -> BlockAtom / KW_function / KW_end / KW_do / KW_then / KW_repeat / KW_until / LPAREN / RPAREN / LBRACE / RBRACE / LBRACKET / RBRACKET

Other -> Atom

=== attrs
on FunctionDecl:      def id=id_text kind=Function doc=doc
on AssignmentDecl:    def id=id_text kind=Variable doc=doc
on Param:             def param_id kind=Param

=== features
function_kinds: Function
function_keyword: KW_function
identifier_kinds: Ident
qualifier_separators: DOT, COLON
vocabulary_token_kinds: DocComment, String

=== semantics
# `require "mod"` is Lua's only import form; the module name is a string
# literal, so `stripQuotes` removes the surrounding quotes before resolving.
on RequireDecl when eq($req, "require") {
  let mod = stripQuotes($path)
  edge moduleDependsOn from $file to $resolve(mod) attrs obj("via", mod, "dep_kind", "value")
}

# Lua declarations.
#
# `local` IS Lua's visibility keyword: a `local` function or variable is
# file-private and must NOT appear in the module's public surface, the same
# way `defp` is private in Elixir. Only globals, and the fields assigned onto
# the module table, are declared.
#
# `$doc_text` is the doc block's accumulated text; `$doc` alone would hold
# only its last token.
on FunctionDecl {
  edge declares from $file to concat($file, "::", $id_text) attrs obj("name", $id_text, "kind", "Function", "doc", trim($doc_text))
}
# A global assignment is a module-level export; `M.f = function() ... end` is
# a very common way to define a method.
on AssignmentDecl {
  edge declares from $file to concat($file, "::", $id_text) attrs obj("name", $id_text, "kind", "Variable", "doc", trim($doc_text))
}

=== resolver
relative_prefixes: ./
module_path_style: dot
resolve:
  - manifest: *.rockspec @ dependencies
  - marker: *.rockspec, .luacheckrc
  - ext: .lua
  - index: /init.lua
  - fallback: luarocks:
