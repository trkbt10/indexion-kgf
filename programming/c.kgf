kgf 0.6
language: c
sources: .c, .h

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - Doxygen uses /** */ and ///
TOKEN DocComment /\/\/\/(.*)/
TOKEN DocBlockComment /\/\*\*([\s\S]*?)\*\//
TOKEN BlockComment /\/\*[\s\S]*?\*\//
TOKEN LineComment /\/\/[^\r\n]*/

# Preprocessor directives
TOKEN Include /#\s*(include|import)\s*[<"][^>"]+[>"]/
# Preprocessor directive. A directive is one logical line, and a backslash
# immediately before the newline continues it onto the next physical line,
# which is how any non-trivial macro is written. Matching only the first
# physical line left the continuation lines to be lexed as ordinary code
# and the trailing backslash matched nothing at all.
TOKEN Preprocessor /#\s*(define|ifdef|ifndef|endif|if|else|elif|undef|pragma|error|warning)([^\\\r\n]|\\[\s\S])*/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F]+|0b[01]+|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?[fFlLuU]*/

# Keywords
KEYWORD KW_typedef  /typedef\b/
KEYWORD KW_struct   /struct\b/
KEYWORD KW_union    /union\b/
KEYWORD KW_enum     /enum\b/
KEYWORD KW_static   /static\b/
KEYWORD KW_extern   /extern\b/
KEYWORD KW_inline   /inline\b/
KEYWORD KW_const    /const\b/
KEYWORD KW_volatile /volatile\b/
KEYWORD KW_if       /if\b/
KEYWORD KW_else     /else\b/
KEYWORD KW_switch   /switch\b/
KEYWORD KW_case     /case\b/
KEYWORD KW_for      /for\b/
KEYWORD KW_while    /while\b/
KEYWORD KW_do       /do\b/
KEYWORD KW_return   /return\b/
KEYWORD KW_sizeof   /sizeof\b/

# Built-in types
TOKEN KeywordType /\b(?:void|int|char|short|long|float|double|signed|unsigned|_Bool|_Complex|_Imaginary|size_t|ptrdiff_t)\b/

# Identifiers
TOKEN TypeIdent /[A-Z][a-zA-Z0-9_]*/
TOKEN Ident /[a-z_][a-zA-Z0-9_]*/

# Operators
TOKEN ARROW   /->/
# `##` is the preprocessor token-paste operator and `#` the stringize
# operator; both appear in macro bodies. Listed before the general class
# so they are matched whole.
TOKEN Operator /##|[+\-\/%&|^~!<>=?:]+|&&|\|\||<<|>>|\.\.\./

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN STAR     /\*/

=== grammar
Module -> Item*

Item -> NL
     / Include
     / Preprocessor
     / StructDecl
     / UnionDecl
     / EnumDecl
     / TypedefDecl
     / FunctionDecl
     / VarDecl
     / DocComment
     / DocBlockComment
     / Other

# Doc block (consecutive /// comments or /** */)
DocBlock -> DocComment ( NL DocComment )*
          / DocBlockComment

# Struct / union / enum declarations.
#
# Each is split into a HEADER and a BODY. The header matches to completion
# before the body is parsed, so its event — and the `scope push` in its
# semantics — precedes every member event of the body. That frame is what lets
# a field or enum value be declared under the type it belongs to; without it
# the member rules read a `current_struct` / `current_enum` that nothing ever
# bound, and no field or enum value was declared at all.
#
# C allows the name on EITHER side of the body: `struct Point { … };` names the
# tag up front, while `typedef struct { … } Point;` names it only afterwards.
# Only the tag is reachable from the header, so the trailing typedef name stays
# on the declaration rule — which is also where the whole type is published.
Name -> Ident / TypeIdent
StructDecl -> StructHeader StructBody? tag:Name? SEMI
StructHeader -> doc:DocBlock? NL? KW_typedef? KW_struct id:Name?
StructBody -> LBRACE StructMember* RBRACE
StructMember -> field_doc:DocBlock? Type STAR* field_id:Ident ArrayDims? SEMI / NL / LineComment / BlockComment

UnionDecl -> UnionHeader UnionBody? tag:Name? SEMI
UnionHeader -> doc:DocBlock? NL? KW_typedef? KW_union id:Name?
UnionBody -> LBRACE UnionMember* RBRACE
UnionMember -> field_doc:DocBlock? Type field_id:Ident ArrayDims? SEMI / NL / LineComment / BlockComment

EnumDecl -> EnumHeader EnumBody? tag:Name? SEMI
EnumHeader -> doc:DocBlock? NL? KW_typedef? KW_enum id:Name?
EnumBody -> LBRACE EnumValue* RBRACE
EnumValue -> value_doc:DocBlock? value_id:Name ( Operator Expr )? COMMA? / NL / LineComment / BlockComment

# Typedef declaration
TypedefDecl -> doc:DocBlock? NL? KW_typedef Type id:Name ArrayDims? SEMI

# Function declaration
FunctionDecl -> doc:DocBlock? NL? StorageClass* Type STAR* func_id:Name LPAREN ParamList? RPAREN ( Body / SEMI )
StorageClass -> KW_static / KW_extern / KW_inline

# Variable declaration
VarDecl -> doc:DocBlock? NL? StorageClass* Type STAR* var_id:Ident ArrayDims? ( Operator Expr )? SEMI

# Parameters
ParamList -> Param ( COMMA Param )*
Param -> Type STAR* param_id:Name? ArrayDims?

# Types
Type -> TypeQual* TypeAtom
TypeQual -> KW_const / KW_volatile
TypeAtom -> KeywordType+ / KW_struct Name / KW_union Name / KW_enum Name / TypeIdent / Ident
ArrayDims -> ( LBRACKET ArraySize? RBRACKET )+
ArraySize -> ( Ident / TypeIdent / Number / Operator / STAR )+

# Body (simplified - balance braces)
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / Atom

# Expressions
Expr -> ( ExprAtom / BraceInit )+
BraceInit -> LBRACE ( ExprAtom / BraceInit / COMMA / NL / LineComment / BlockComment )* RBRACE
ExprAtom -> Ident / TypeIdent / Number / String / Char / KeywordType / LPAREN / RPAREN / DOT / COMMA / ARROW / STAR / Operator

Atom -> ExprAtom / NL / DocComment / DocBlockComment / LineComment / BlockComment / Include / Preprocessor / KW_typedef / KW_struct / KW_union / KW_enum / KW_static / KW_extern / KW_inline / KW_const / KW_volatile / KW_if / KW_else / KW_switch / KW_case / KW_for / KW_while / KW_do / KW_return / KW_sizeof / SEMI

# Module-level fallback: a balanced bracket group taken as one opaque unit,
# then any single token including a bracket whose partner is missing, so no
# construct can stop the module parse and silently drop later declarations.
Other -> Atom / OpaqueGroup / LBRACE / RBRACE / LBRACKET / RBRACKET / LPAREN / RPAREN
OpaqueGroup -> LBRACE OpaqueInner* RBRACE / LBRACKET OpaqueInner* RBRACKET / LPAREN OpaqueInner* RPAREN
OpaqueInner -> OpaqueGroup / !LPAREN !RPAREN !LBRACE !RBRACE !LBRACKET !RBRACKET Atom

=== attrs
on StructHeader: def id kind=Struct doc=doc
on UnionHeader:  def id kind=Union doc=doc
on EnumHeader:   def id kind=Enum doc=doc
on TypedefDecl:  def id kind=Typedef doc=doc
on FunctionDecl: def func_id kind=Function doc=doc
on VarDecl:      def var_id kind=Variable doc=doc
on StructMember: def field_id kind=Field doc=field_doc
on UnionMember:  def field_id kind=Field doc=field_doc
on EnumValue:    def value_id kind=EnumValue doc=value_doc
on Param:        def param_id kind=Param

=== features
document_symbol_kinds: Function, Struct, Union, Enum, Typedef
function_kinds: Function
coverage_token_kinds: Ident, TypeIdent
identifier_kinds: Ident, TypeIdent
qualifier_separators: DOT, ARROW
vocabulary_token_kinds: DocComment, DocBlockComment, String

=== semantics
# C declarations are public by default (header-visible).
#
# ---------------------------------------------------------------------------
# Enclosing-type frames
# ---------------------------------------------------------------------------
# A header opens a frame for its body's members with `scope push`, and the
# declaration rule — which fires only once the body is complete, events being
# bottom-up — closes it with `scope pop`. The frame is what stops one type's
# binding from claiming the fields of the next, and what lets a struct nested
# in another struct's body keep its own fields.
#
# The symbol is built from the TAG when the type has one, so `struct Point { … }`
# publishes `Point` before its fields are parsed. `typedef struct { … } Point;`
# names the type only after the body, so the anonymous header binds nothing and
# the declaration rule publishes the trailing name on its own — its fields are
# unreachable either way, since nothing names them until the body is over.
on StructHeader when $id {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Struct", "doc", $doc_text)
  scope push
  bind ns "value" name "current_struct" to concat($file, "::", $id)
  bind ns "value" name "named_ahead" to "1"
} else {
  # Anonymous so far: the name can only arrive after the body. The doc is kept
  # in the frame for the declaration rule, the first place the name is known.
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
# A trailing typedef name (KW_typedef KW_struct BODY Name SEMI) is the first
# place an otherwise anonymous type is named, so this is where it is published.
# It is skipped when the header already published a tag.
on StructDecl when cond($tag, not($scope("value", "named_ahead"))) {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Struct", "doc", $scope("value", "pending_doc"))
}
on StructDecl { scope pop }

on UnionHeader when $id {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Union", "doc", $doc_text)
  scope push
  bind ns "value" name "current_struct" to concat($file, "::", $id)
  bind ns "value" name "named_ahead" to "1"
} else {
  # Anonymous so far: the name can only arrive after the body. The doc is kept
  # in the frame for the declaration rule, the first place the name is known.
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
# A trailing typedef name (KW_typedef KW_union BODY Name SEMI) is the first
# place an otherwise anonymous type is named, so this is where it is published.
# It is skipped when the header already published a tag.
on UnionDecl when cond($tag, not($scope("value", "named_ahead"))) {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Union", "doc", $scope("value", "pending_doc"))
}
on UnionDecl { scope pop }

on EnumHeader when $id {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Enum", "doc", $doc_text)
  scope push
  bind ns "value" name "current_enum" to concat($file, "::", $id)
  bind ns "value" name "named_ahead" to "1"
} else {
  # Anonymous so far: the name can only arrive after the body. The doc is kept
  # in the frame for the declaration rule, the first place the name is known.
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
# A trailing typedef name (KW_typedef KW_enum BODY Name SEMI) is the first
# place an otherwise anonymous type is named, so this is where it is published.
# It is skipped when the header already published a tag.
on EnumDecl when cond($tag, not($scope("value", "named_ahead"))) {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Enum", "doc", $scope("value", "pending_doc"))
}
on EnumDecl { scope pop }
on TypedefDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Typedef", "doc", $doc_text)
}
on FunctionDecl {
  edge declares from $file to concat($file, "::", $func_id) attrs obj("name", $func_id, "kind", "Function", "doc", $doc_text)
}
on VarDecl {
  edge declares from $file to concat($file, "::", $var_id) attrs obj("name", $var_id, "kind", "Variable", "doc", $doc_text)
}

# Struct field. `StructMember` also has blank-line and comment alternatives
# that fire an event with no `field_id` bound at all, so the name is guarded as
# well as the enclosing struct — otherwise every newline inside a struct body
# produced a nameless Field edge.
on StructMember when cond($field_id, $scope("value", "current_struct")) {
  let parent = $scope("value", "current_struct")
  let sym_id = concat(parent, ".", $field_id)
  edge declares from parent to sym_id attrs obj("name", $field_id, "kind", "Field", "doc", $field_doc_text)
}

# Enum value. Guarded on the name for the same reason as `StructMember`.
on EnumValue when cond($value_id, $scope("value", "current_enum")) {
  let parent = $scope("value", "current_enum")
  let sym_id = concat(parent, ".", $value_id)
  edge declares from parent to sym_id attrs obj("name", $value_id, "kind", "EnumValue", "doc", $value_doc_text)
}

=== resolver
relative_prefixes: ./, ../
module_path_style: slash
resolve:
  - ext: .h, .c
  - fallback: system:
