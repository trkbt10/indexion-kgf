kgf 0.6
language: python
sources: .py, .pyi

=== lex
# Indentation handling: the lexer cannot count indentation depth, so it only
# distinguishes an indented line start (NL_INDENT) from a blank or column-0
# line start (NL). Every grammar rule that walks a block relies on that single
# bit: a block continues while lines start with NL_INDENT and ends at the first
# NL followed by a non-indented token. Nesting depth is invisible, see the
# grammar notes on suites for what that means.
TOKEN NL_INDENT /\r?\n[ \t]+/
TOKEN NL /\r?\n/
SKIP /[ \t]+/
# Backslash line continuation joins physical lines; it is whitespace here.
SKIP /\\\r?\n/

# Docstrings (triple-quoted strings). The capture group strips the quotes so
# `$doc` carries the text itself; the value comes from whichever alternative
# matched. An optional raw/unicode prefix is allowed (`r"""..."""`).
TOKEN Docstring /[rRuU]?"""([\s\S]*?)"""|[rRuU]?'''([\s\S]*?)'''/

# Comments
TOKEN Comment /#[^\r\n]*/

# Strings with any legal one- or two-letter prefix combination (f, r, b, u,
# rb, br, fr, rf, in any case). A single-quoted string cannot span lines.
TOKEN String /(?:[rR][bBfF]?|[bBfF][rR]?|[uU])?"(?:[^"\\\r\n]|\\.)*"|(?:[rR][bBfF]?|[bBfF][rR]?|[uU])?'(?:[^'\\\r\n]|\\.)*'/

# Keywords. Only the words the grammar needs structurally are keywords; every
# other Python keyword (if, for, while, with, lambda, yield, ...) lexes as an
# Ident and is absorbed by the statement-level atom rules. `self` and `cls`
# are tokens of their own because the `self_keyword` feature refers to them.
KEYWORD KW_def      /def\b/
KEYWORD KW_class    /class\b/
KEYWORD KW_async    /async\b/
KEYWORD KW_import   /import\b/
KEYWORD KW_from     /from\b/
KEYWORD KW_as       /as\b/
KEYWORD KW_return   /return\b/
KEYWORD KW_pass     /pass\b/
KEYWORD KW_self     /self\b/
KEYWORD KW_cls      /cls\b/

# Decorators. `@property` (and the `cached_property` / `.setter` / `.getter`
# / `.deleter` family) gets its own token so a decorated method can be
# classified as a Property by token kind; every other decorator is a plain
# Decorator. Both are tried before Ident so the `@` is never left over.
TOKEN PropertyDecorator /@(?:[A-Za-z_][A-Za-z0-9_]*\.)*(?:cached_)?property\b|@[A-Za-z_][A-Za-z0-9_.]*\.(?:setter|getter|deleter)\b/
TOKEN Decorator /@[A-Za-z_][A-Za-z0-9_.]*/

# Identifiers
TOKEN Ident /[A-Za-z_][A-Za-z0-9_]*/

# Numbers: hex/octal/binary, decimals with underscores, floats with an
# exponent, imaginary literals, and a leading-dot float (`.5`).
TOKEN Number /0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\.[0-9_]*)?(?:[eE][+-]?[0-9_]+)?[jJ]?|\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?[jJ]?/

# Brackets
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/

# Operators. The lexer takes the first rule that matches in definition order,
# so the multi-character forms that begin with `*`, `|`, `=`, `:` or `-`
# (`**=`, `|=`, `==`, `:=`, `->`) must be listed before the single-character
# STAR / PIPE / EQ / COLON tokens the grammar depends on, and ARROW must be
# listed before the `-` inside Operator.
TOKEN ARROW    /->/
TOKEN Operator /\*\*=|\/\/=|>>=|<<=|:=|==|!=|<=|>=|\+=|-=|\*=|\/=|%=|&=|\|=|\^=|@=|\/\/|<<|>>|[+\-\/%<>&^~!;@]/
TOKEN STARSTAR /\*\*/
TOKEN STAR     /\*/
TOKEN PIPE     /\|/
TOKEN EQ       /=/
TOKEN COLON    /:/
TOKEN COMMA    /,/
TOKEN DOT      /\./

=== grammar
Module -> ModuleDoc? Item*

# A module docstring may be preceded by comment lines (shebang, encoding,
# license header).
ModuleDoc -> ( Comment NL* )* doc:Docstring

# Every top-level line is one of these. `Other` accepts any single token so
# the module rule never stops early: whatever the declaration rules cannot
# match is skipped one token at a time and parsing resumes at the next line.
Item -> NL
     / NL_INDENT
     / Comment
     / FunctionDef
     / ClassDef
     / Statement
     / Other

# ---------------------------------------------------------------------------
# Imports
# ---------------------------------------------------------------------------
# `import a.b as c, d` — one ModEntry per imported module so each yields its
# own dependency edge.
ImportStmt -> KW_import ModEntry ( COMMA ModEntry )*
ModEntry -> module:QN ( KW_as Ident )?

# `from ..pkg.mod import (a as b, c)` / `from . import x` / `from m import *`.
# The leading dots are captured separately from the dotted module path so the
# semantics can turn them into the resolver's relative prefixes.
FromImport -> KW_from dots:Dots? module:QN? KW_import Names
Dots -> DOT+
Names -> STAR / LPAREN Ws* NameList Ws* RPAREN / NameList
NameList -> NameEntry ( Ws* COMMA Ws* NameEntry )* ( Ws* COMMA )?
NameEntry -> Ident ( KW_as Ident )?
QN -> Ident ( DOT Ident )*

# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------
# A decorator line: `@name`, `@name(args...)`, possibly followed by a comment,
# then the newline(s) leading to the next decorator or the def/class.
DecoratorLine -> Decorator Group? Comment? Ws*
PropertyDecoratorLine -> PropertyDecorator Group? Comment? Ws*

# The docstring is the first statement of the body, so it is captured on the
# declaration itself (right after the newline that opens the body, after any
# comment lines): `$doc` is then a plain label of FunctionDef / ClassDef /
# MethodDef and needs no scope plumbing.
#
# Suites and nesting: NL_INDENT carries no depth, so a body is simply the run
# of indented lines that follows. Inside a top-level function every `def` or
# `class` on an indented line is necessarily nested and is consumed as
# InnerDef / InnerClass without declaring anything. Inside a class body an
# indented `def` is ambiguous (a sibling method or a function nested in the
# previous method); it is always treated as a member of the class, so a
# method body stops in front of it (`!MemberStart`).
FunctionDef -> decorators:DecoratorLine* KW_async? KW_def id:Ident Params ReturnHint? COLON Comment? ( BlockOpen doc:Docstring? FnLineContent? FnLine* / SimpleBody )
FnLine -> NL* NL_INDENT FnLineContent? / Comment
FnLineContent -> Comment / InnerDef / InnerClass / Statement Comment?
InnerDef -> ( DecoratorLine / PropertyDecoratorLine )* KW_async? KW_def Ident Params ReturnHint? COLON Comment? ( BlockOpen Docstring? FnLineContent? FnLine* / SimpleBody )
InnerClass -> DecoratorLine* KW_class Ident Bases? COLON Comment? ( BlockOpen Docstring? FnLineContent? FnLine* / SimpleBody )

# ClassHeader is a separate rule so it fires before the body: its semantics
# bind the enclosing class for the MethodDef events that follow (events fire
# bottom-up, children before parents).
ClassDef -> ClassHeader COLON Comment? ( BlockOpen doc:Docstring? MemberContent? ClassMember* / SimpleBody )
ClassHeader -> decorators:DecoratorLine* KW_class id:Ident Bases?
Bases -> Group
ClassMember -> NL* NL_INDENT MemberContent? / Comment
MemberContent -> Comment / MethodDef / NestedClass / Statement Comment?

# A method's decorators may include the property family; `prop` is bound only
# when one does, which is what classifies the member as a Property.
MethodDef -> decorators:( DecoratorLine / prop:PropertyDecoratorLine )* KW_async? KW_def id:Ident Params ReturnHint? COLON Comment? ( BlockOpen doc:Docstring? MethodLineContent? MethodLine* / SimpleBody )
MethodLine -> NL* NL_INDENT !MemberStart MethodLineContent? / Comment
MethodLineContent -> Comment / Statement Comment?
MemberStart -> Decorator / PropertyDecorator / KW_async / KW_def / KW_class

# A class nested in a class body is declared under its parent. Its body lines
# are consumed like a method body, so its own methods (if any) are attributed
# to the enclosing class — the depth-blind tokenizer cannot tell them apart.
NestedClass -> decorators:DecoratorLine* KW_class id:Ident Bases? COLON Comment? ( BlockOpen doc:Docstring? MethodLineContent? MethodLine* / SimpleBody )

# The newline that opens an indented body, skipping comment-only lines so the
# docstring that follows them is still captured. BlockOpen consumes the first
# line's NL_INDENT, which is why every body rule accepts one line of content
# directly after the optional docstring before the NL_INDENT-led line loop.
BlockOpen -> NL* NL_INDENT ( Comment NL* NL_INDENT )*
SimpleBody -> Statement Comment?

# Parameters: `self` / `cls`, `*args`, `**kwargs`, the bare `*` keyword-only
# marker, the `/` positional-only marker, annotations and defaults. Parameter
# lists routinely span lines, so whitespace/newline/comment runs (`Ws`) are
# allowed around every element.
Params -> LPAREN Ws* ParamList? Ws* RPAREN
ParamList -> Param ( Ws* COMMA Ws* Param )* ( Ws* COMMA )?
Param -> ( STARSTAR / STAR )? ( id:Ident / KW_self / KW_cls ) TypeHint? Default? / STAR / Operator
Default -> EQ DefaultExpr
DefaultExpr -> ArgAtom+
TypeHint -> COLON Type
ReturnHint -> ARROW Type

# An annotation is any expression that contains no top-level `=`, `,` or `:`
# (the tokens that end a parameter or a header); brackets nest freely.
Type -> TypeAtom+
TypeAtom -> Group / Ident / KW_self / KW_cls / Number / String / Docstring / DOT / STAR / STARSTAR / PIPE / Operator

# ---------------------------------------------------------------------------
# Statements and expressions
# ---------------------------------------------------------------------------
Statement -> ImportStmt / FromImport / Assignment / ExprStmt

# `x = e`, `x: T`, `x: T = e`. A bare identifier is not an assignment.
Assignment -> id:Ident ( TypeHint ( EQ expr:Expr )? / EQ expr:Expr )

# Any other statement: a run of atoms up to the end of the line. Compound
# statement headers (`if x:`, `for t in items:`, `with f() as g:`) are plain
# atom runs too; their bodies are the indented lines that follow.
ExprStmt -> Atom+
Expr -> Atom+

# Atoms never include a newline, so a statement ends at the line end unless
# it is inside brackets: a Group absorbs newlines, comments and anything else
# until its closing bracket.
Atom -> ArgAtom / COMMA / EQ
ArgAtom -> Group / Ident / KW_self / KW_cls / KW_return / KW_pass / KW_as / KW_async / KW_from / KW_import / Number / String / Docstring / DOT / COLON / STAR / STARSTAR / PIPE / ARROW / Operator
Group -> LPAREN Inner* RPAREN / LBRACKET Inner* RBRACKET / LBRACE Inner* RBRACE
Inner -> Atom / Ws / KW_def / KW_class / Decorator / PropertyDecorator
Ws -> NL_INDENT / NL / Comment

# Catch-all for the module level: one token of any kind, including a bracket
# whose partner is missing (an Atom only accepts balanced groups).
Other -> Atom / KW_def / KW_class / Decorator / PropertyDecorator / LPAREN / RPAREN / LBRACKET / RBRACKET / LBRACE / RBRACE

=== attrs
on FunctionDef:  def id kind=Function doc=doc
on ClassHeader:  def id kind=Class
on MethodDef:    def id kind=Method doc=doc
on NestedClass:  def id kind=Class doc=doc
on Assignment:   def id kind=Variable
on Param:        def id kind=Param
on ModuleDoc:    module_doc doc=doc

=== features
function_kinds: Function, Method, Property
function_keyword: KW_def
identifier_kinds: Ident
self_keyword: KW_self
qualifier_separators: DOT
vocabulary_token_kinds: Docstring, String
# NL is insignificant by default; Python additionally emits NL_INDENT for
# indented newlines, which grep should also skip when matching patterns.
insignificant_token_kinds: NL_INDENT

=== semantics
# Module docstring
on ModuleDoc {
  note module_doc payload obj("doc", trim($doc))
}

# `import a.b` — one edge per module entry.
on ModEntry {
  edge moduleDependsOn from $file to $resolve($module_text) attrs obj("via", $module_text, "dep_kind", "value")
}

# `from ..pkg import x` — the leading dots are Python's relative-import
# syntax: one dot is the importing module's own package, each further dot
# climbs one package. They are rewritten into the resolver's relative
# prefixes (`./`, `../`) declared in the resolver section: "" -> "", "." ->
# "./", ".." -> "../", "..." -> "../../", and so on (three characters of the
# "../" ladder per extra dot).
on FromImport {
  let dots = $dots_text
  let parents = slice("../../../../../../../../../../../../", 0, mul(sub(countOccurrences(dots, "."), 1), 3))
  let rel = cond(eq(dots, ""), "", cond(eq(dots, "."), "./", parents))
  edge moduleDependsOn from $file to $resolve(concat(rel, $module_text)) attrs obj("via", concat(dots, $module_text), "dep_kind", "value")
}

# Python has no visibility keyword; every module-level definition is public
# (a leading underscore is convention only), so every declaration is emitted.
on FunctionDef {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", trim($doc), "decorators", trim($decorators_text))
}

# The header fires before the class body, so it publishes the class for the
# MethodDef / NestedClass events that follow; ClassDef itself fires after the
# body and owns the docstring.
on ClassHeader {
  let sym_id = concat($file, "::", $id)
  bind ns "value" name "current_class" to sym_id
  bind ns "value" name "current_class_name" to $id
  bind ns "value" name "current_class_decorators" to trim($decorators_text)
}

on ClassDef {
  let sym_id = $scope("value", "current_class")
  let name = $scope("value", "current_class_name")
  let decorators = $scope("value", "current_class_decorators")
  edge declares from $file to sym_id attrs obj("name", name, "kind", "Class", "doc", trim($doc), "decorators", decorators)
}

on MethodDef when $scope("value", "current_class") {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, ".", $id)
  let kind = cond($prop, "Property", "Method")
  edge declares from parent to sym_id attrs obj("name", $id, "kind", kind, "doc", trim($doc), "decorators", trim($decorators_text))
}

on NestedClass when $scope("value", "current_class") {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, ".", $id)
  edge declares from parent to sym_id attrs obj("name", $id, "kind", "Class", "doc", trim($doc), "decorators", trim($decorators_text))
}

=== resolver
relative_prefixes: ./, ../, /
module_path_style: dot
project_config: pyproject.toml
install_cmd: pip install {name}
build_cmd: pip install -e .
resolve:
  - manifest: pyproject.toml @ project.dependencies
  - manifest: setup.py @ install_requires
  - manifest: requirements.txt @ -
  # A directory with `__init__.py` is a package; the package itself is the
  # target of `from . import x` and `import pkg`, so it is probed first.
  - marker: __init__.py, pyproject.toml, setup.py, requirements.txt
  - ext: .py, .pyi
  - fallback: pip:

=== ignore
# Virtual environments
.venv/
venv/
env/
# Cache
__pycache__/
.pytest_cache/
.mypy_cache/
# Build
dist/
build/
*.egg-info/
