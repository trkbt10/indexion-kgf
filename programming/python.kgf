kgf 0.6
language: python
sources: .py, .pyi

=== lex
# Indentation handling. The lexer is regex-only and cannot compare one line's
# indentation with the previous line's, so it only distinguishes an indented
# line start (NL_INDENT) from a blank or column-0 line start (NL). Depth comes
# from the LAYOUT directive at the end of this section: the engine's post-lex
# pass reads the whitespace each newline token carries and injects INDENT /
# DEDENT tokens, which the grammar uses to bracket every suite exactly.
TOKEN NL_INDENT /\r?\n[ \t]+/
TOKEN NL /\r?\n/
SKIP /[ \t]+/
# Backslash line continuation joins physical lines; it is whitespace here.
SKIP /\\\r?\n/

# Docstrings (triple-quoted strings). The capture group strips the quotes so
# `$doc` carries the text itself; the value comes from whichever alternative
# matched. An optional raw/unicode prefix is allowed (`r"""..."""`).
TOKEN Docstring /[rRuU]?"""([\s\S]*?)"""|[rRuU]?'''([\s\S]*?)'''/

# Comments
TOKEN Comment /#[^\r\n]*/

# Strings with any legal one- or two-letter prefix combination (f, r, b, u,
# rb, br, fr, rf, in any case). A single-quoted string cannot span lines.
TOKEN String /(?:[rR][bBfF]?|[bBfF][rR]?|[uU])?"(?:[^"\\\r\n]|\\.)*"|(?:[rR][bBfF]?|[bBfF][rR]?|[uU])?'(?:[^'\\\r\n]|\\.)*'/

# Keywords. Only the words the grammar needs structurally are keywords; every
# other Python keyword (if, for, while, with, lambda, yield, ...) lexes as an
# Ident and is absorbed by the statement-level atom rules. `self` and `cls`
# are tokens of their own because the `self_keyword` feature refers to them.
KEYWORD KW_def      /def\b/
KEYWORD KW_class    /class\b/
KEYWORD KW_async    /async\b/
KEYWORD KW_import   /import\b/
KEYWORD KW_from     /from\b/
KEYWORD KW_as       /as\b/
KEYWORD KW_return   /return\b/
KEYWORD KW_pass     /pass\b/
KEYWORD KW_self     /self\b/
KEYWORD KW_cls      /cls\b/

# Decorators. `@property` (and the `cached_property` / `.setter` / `.getter`
# / `.deleter` family) gets its own token so a decorated method can be
# classified as a Property by token kind; every other decorator is a plain
# Decorator. Both are tried before Ident so the `@` is never left over.
TOKEN PropertyDecorator /@(?:[A-Za-z_][A-Za-z0-9_]*\.)*(?:cached_)?property\b|@[A-Za-z_][A-Za-z0-9_.]*\.(?:setter|getter|deleter)\b/
TOKEN Decorator /@[A-Za-z_][A-Za-z0-9_.]*/

# Identifiers
TOKEN Ident /[A-Za-z_][A-Za-z0-9_]*/

# Numbers: hex/octal/binary, decimals with underscores, floats with an
# exponent, imaginary literals, and a leading-dot float (`.5`).
TOKEN Number /0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\.[0-9_]*)?(?:[eE][+-]?[0-9_]+)?[jJ]?|\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?[jJ]?/

# Brackets
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/

# Operators. The lexer takes the first rule that matches in definition order,
# so the multi-character forms that begin with `*`, `|`, `=`, `:` or `-`
# (`**=`, `|=`, `==`, `:=`, `->`) must be listed before the single-character
# STAR / PIPE / EQ / COLON tokens the grammar depends on, and ARROW must be
# listed before the `-` inside Operator.
TOKEN ARROW    /->/
TOKEN Operator /\*\*=|\/\/=|>>=|<<=|:=|==|!=|<=|>=|\+=|-=|\*=|\/=|%=|&=|\|=|\^=|@=|\/\/|<<|>>|[+\-\/%<>&^~!;@]/
TOKEN STARSTAR /\*\*/
TOKEN STAR     /\*/
TOKEN PIPE     /\|/
TOKEN EQ       /=/
TOKEN COLON    /:/
TOKEN COMMA    /,/
TOKEN DOT      /\./

# Layout. Both newline kinds carry a line's leading whitespace (NL carries
# none, i.e. column 0), so both are listed. INDENT and DEDENT are synthetic:
# they have no TOKEN rule because no source text matches them; the layout pass
# is what puts them in the stream. Comment-only lines carry no layout (Python
# lets a comment sit at any column), and inside a bracket — a flow collection,
# a multi-line call or parameter list — indentation is not significant at all.
LAYOUT newline=NL_INDENT,NL indent=INDENT dedent=DEDENT comment=Comment open=LPAREN,LBRACKET,LBRACE close=RPAREN,RBRACKET,RBRACE

=== grammar
Module -> ModuleDoc? Item*

# A module docstring may be preceded by comment lines (shebang, encoding,
# license header).
ModuleDoc -> ( Comment NL* )* doc:Docstring

# Every top-level line is one of these. `Other` accepts any single token so
# the module rule never stops early: whatever the declaration rules cannot
# match is skipped one token at a time and parsing resumes at the next line.
# `Suite` appears here because a module-level compound statement (`if
# __name__ == "__main__":`) opens an indented block whose INDENT/DEDENT must
# be consumed like any other.
Item -> LineBreak
     / Comment
     / FunctionDef
     / ClassDef
     / Suite
     / Statement
     / Other

# ---------------------------------------------------------------------------
# Imports
# ---------------------------------------------------------------------------
# `import a.b as c, d` — one ModEntry per imported module so each yields its
# own dependency edge.
ImportStmt -> KW_import ModEntry ( COMMA ModEntry )*
ModEntry -> module:QN ( KW_as Ident )?

# `from ..pkg.mod import (a as b, c)` / `from . import x` / `from m import *`.
# The leading dots are captured separately from the dotted module path so the
# semantics can turn them into the resolver's relative prefixes.
FromImport -> KW_from dots:Dots? module:QN? KW_import Names
Dots -> DOT+
Names -> STAR / LPAREN Ws* NameList Ws* RPAREN / NameList
NameList -> NameEntry ( Ws* COMMA Ws* NameEntry )* ( Ws* COMMA )?
NameEntry -> Ident ( KW_as Ident )?
QN -> Ident ( DOT Ident )*

# ---------------------------------------------------------------------------
# Suites — the indented block that a `:` opens
# ---------------------------------------------------------------------------
# The engine's layout pass (declared by the LAYOUT directive in `=== lex`)
# inserts an INDENT after the newline that opens a deeper line and a DEDENT
# for every level a shallower line closes. A suite is therefore exactly
# `INDENT ... DEDENT`, and nesting is exact at any depth: whatever a nested
# def, class or compound statement contains is inside ITS OWN INDENT/DEDENT
# pair, so it can never be mistaken for a sibling of its parent.
#
# SuiteOpen skips the line breaks and comment-only lines between the header
# and the first body line; the layout pass gives those no INDENT, so they sit
# before it. A suite always ends with DEDENT, including the one the pass emits
# at end of input for a body that runs to the last line of the file.
SuiteOpen -> ( LineBreak / Comment )* INDENT
LineBreak -> NL / NL_INDENT

# A function body: statements, nested declarations and nested blocks. Nested
# defs and classes are consumed WITHOUT being declared (a local function is
# not part of the module's public surface), and their own bodies go with them.
Suite -> SuiteOpen BodyItem* DEDENT
BodyItem -> LineBreak / Comment / Suite / InnerDef / InnerClass / Statement Comment?

# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------
# A decorator line: `@name`, `@name(args...)`, possibly followed by a comment,
# then the newline(s) leading to the next decorator or the def/class.
DecoratorLine -> Decorator Group? Comment? Ws*
PropertyDecoratorLine -> PropertyDecorator Group? Comment? Ws*

# The docstring is the first statement of the body, so it is captured on the
# declaration itself (right after the newline that opens the body, after any
# comment lines). The suite is spelled out inline rather than delegated to a
# rule, because a label bound inside a referenced rule does not leak to the
# caller: `doc:` has to sit in the declaration's own expression for `$doc` to
# reach its semantics block.
FunctionDef -> decorators:DecoratorLine* KW_async? KW_def id:Ident Params ReturnHint? COLON Comment? ( SuiteOpen doc:Docstring? BodyItem* DEDENT / SimpleBody )
InnerDef -> ( DecoratorLine / PropertyDecoratorLine )* KW_async? KW_def Ident Params ReturnHint? COLON Comment? ( Suite / SimpleBody )
InnerClass -> DecoratorLine* KW_class Ident Bases? COLON Comment? ( Suite / SimpleBody )

# A class. ClassHeader fires FIRST, before the body is parsed (a rule's event
# is emitted when the rule completes, and the header completes at the `:`),
# and pushes the scope its members resolve their parent from. ClassDef fires
# LAST, after every event inside the class, and pops it. Together the two make
# nesting exact at any depth: a class inside a class body pushes its own
# scope, its members bind to it, and its pop restores the enclosing class for
# the members that follow it.
ClassDef -> ClassHeader COLON Comment? ( ClassSuite / ClassInlineBody )
ClassHeader -> decorators:DecoratorLine* KW_class id:Ident Bases?
Bases -> Group
ClassSuite -> SuiteOpen doc:Docstring? Member* DEDENT
# Spelled out rather than `-> SimpleBody`: a rule whose whole body is a single
# reference to another rule is an alias and emits no event of its own, so it
# could not carry the declaration below.
ClassInlineBody -> Statement Comment?
Member -> LineBreak / Comment / Suite / MethodDef / NestedClassDef / Statement Comment?

# A method's decorators may include the property family; `prop` is bound only
# when one does, which is what classifies the member as a Property. A method
# body is an ordinary Suite, so a `def` nested inside it is an InnerDef — not
# a sibling method of the class.
MethodDef -> decorators:( DecoratorLine / prop:PropertyDecoratorLine )* KW_async? KW_def id:Ident Params ReturnHint? COLON Comment? ( SuiteOpen doc:Docstring? BodyItem* DEDENT / SimpleBody )

# A class nested in a class body is declared under its parent and is itself a
# class scope, so its own methods are declared under IT and the members that
# follow it in the outer body go back to the outer class.
NestedClassDef -> NestedClassHeader COLON Comment? ( ClassSuite / NestedClassInlineBody )
NestedClassHeader -> decorators:DecoratorLine* KW_class id:Ident Bases?
NestedClassInlineBody -> Statement Comment?

# A one-line body: `def f(): return 1`. No newline, so no INDENT either.
SimpleBody -> Statement Comment?

# Parameters: `self` / `cls`, `*args`, `**kwargs`, the bare `*` keyword-only
# marker, the `/` positional-only marker, annotations and defaults. Parameter
# lists routinely span lines, so whitespace/newline/comment runs (`Ws`) are
# allowed around every element.
Params -> LPAREN Ws* ParamList? Ws* RPAREN
ParamList -> Param ( Ws* COMMA Ws* Param )* ( Ws* COMMA )?
Param -> ( STARSTAR / STAR )? ( id:Ident / KW_self / KW_cls ) TypeHint? Default? / STAR / Operator
Default -> EQ DefaultExpr
DefaultExpr -> ArgAtom+
TypeHint -> COLON Type
ReturnHint -> ARROW Type

# An annotation is any expression that contains no top-level `=`, `,` or `:`
# (the tokens that end a parameter or a header); brackets nest freely.
Type -> TypeAtom+
TypeAtom -> Group / Ident / KW_self / KW_cls / Number / String / Docstring / DOT / STAR / STARSTAR / PIPE / Operator

# ---------------------------------------------------------------------------
# Statements and expressions
# ---------------------------------------------------------------------------
Statement -> ImportStmt / FromImport / Assignment / ExprStmt

# `x = e`, `x: T`, `x: T = e`. A bare identifier is not an assignment.
Assignment -> id:Ident ( TypeHint ( EQ expr:Expr )? / EQ expr:Expr )

# Any other statement: a run of atoms up to the end of the line. Compound
# statement headers (`if x:`, `for t in items:`, `with f() as g:`) are plain
# atom runs too; the Suite alternative that follows them in BodyItem / Member
# / Item consumes the indented block they open.
ExprStmt -> Atom+
Expr -> Atom+

# Atoms never include a newline, so a statement ends at the line end unless
# it is inside brackets: a Group absorbs newlines, comments and anything else
# until its closing bracket.
Atom -> ArgAtom / COMMA / EQ
ArgAtom -> Group / Ident / KW_self / KW_cls / KW_return / KW_pass / KW_as / KW_async / KW_from / KW_import / Number / String / Docstring / DOT / COLON / STAR / STARSTAR / PIPE / ARROW / Operator
Group -> LPAREN Inner* RPAREN / LBRACKET Inner* RBRACKET / LBRACE Inner* RBRACE
Inner -> Atom / Ws / KW_def / KW_class / Decorator / PropertyDecorator
Ws -> NL_INDENT / NL / Comment

# Catch-all for the module level: one token of any kind, including a bracket
# whose partner is missing (an Atom only accepts balanced groups) and a stray
# DEDENT left by a file whose indentation the layout pass could not pair up.
Other -> Atom / KW_def / KW_class / Decorator / PropertyDecorator / LPAREN / RPAREN / LBRACKET / RBRACKET / LBRACE / RBRACE / INDENT / DEDENT

=== attrs
on FunctionDef:  def id kind=Function doc=doc
# A class header opens a scope its members bind their parent in; the matching
# ClassDef / NestedClassDef pops it. Attrs are evaluated before the rule's
# semantics block, and a rule's event fires after every event inside it, so
# the push happens before any member is evaluated and the pop after all of
# them.
on ClassHeader:  def id kind=Class; scope push=class
on NestedClassHeader: def id kind=Class; scope push=class
# ClassDef / NestedClassDef are the last events of a class, so their pop
# restores the enclosing scope only once everything inside has been evaluated.
on ClassDef:          scope pop=class
on NestedClassDef:    scope pop=class
on MethodDef:    def id kind=Method doc=doc
on Assignment:   def id kind=Variable
on Param:        def id kind=Param
on ModuleDoc:    module_doc doc=doc

=== features
function_kinds: Function, Method, Property
function_keyword: KW_def
identifier_kinds: Ident
self_keyword: KW_self
qualifier_separators: DOT
vocabulary_token_kinds: Docstring, String
# NL is insignificant by default; Python additionally emits NL_INDENT for
# indented newlines, which grep should also skip when matching patterns.
insignificant_token_kinds: NL_INDENT

=== semantics
# Module docstring
on ModuleDoc {
  note module_doc payload obj("doc", trim($doc))
}

# `import a.b` — one edge per module entry.
on ModEntry {
  edge moduleDependsOn from $file to $resolve($module_text) attrs obj("via", $module_text, "dep_kind", "value")
}

# `from ..pkg import x` — the leading dots are Python's relative-import
# syntax: one dot is the importing module's own package, each further dot
# climbs one package. They are rewritten into the resolver's relative
# prefixes (`./`, `../`) declared in the resolver section: "" -> "", "." ->
# "./", ".." -> "../", "..." -> "../../", and so on (three characters of the
# "../" ladder per extra dot).
on FromImport {
  let dots = $dots_text
  let parents = slice("../../../../../../../../../../../../", 0, mul(sub(countOccurrences(dots, "."), 1), 3))
  let rel = cond(eq(dots, ""), "", cond(eq(dots, "."), "./", parents))
  edge moduleDependsOn from $file to $resolve(concat(rel, $module_text)) attrs obj("via", concat(dots, $module_text), "dep_kind", "value")
}

# Python has no visibility keyword; every module-level definition is public
# (a leading underscore is convention only), so every declaration is emitted.
on FunctionDef {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Function", "doc", trim($doc), "decorators", trim($decorators_text))
}

# A class header fires before its body is parsed (a rule's event is emitted
# when the rule completes, and the header completes at the `:`), so it is
# where the class is published for the members that follow. Its `scope
# push=class` attribute put a fresh scope on the stack first, so the bindings
# below belong to THIS class; a class nested in this one pushes another scope
# over them and pops it again, which restores this class for the members that
# come after the nested one.
on ClassHeader {
  let sym_id = concat($file, "::", $id)
  bind ns "value" name "current_class" to sym_id
  bind ns "value" name "current_class_name" to $id
  bind ns "value" name "current_class_decorators" to trim($decorators_text)
}

# A class nested in another class body. Its `scope push=class` attribute has
# already run, so the scope on top is empty and `$scope` still sees the
# ENCLOSING class through the stack below it — that is the parent the nested
# class is declared under, and the prefix of its symbol id. Binding
# `current_class` writes into the new top scope, so the nested class's own
# members resolve to it, and the matching `scope pop=class` on NestedClassDef
# restores the enclosing class for the members that follow.
on NestedClassHeader {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, ".", $id)
  bind ns "value" name "current_class" to sym_id
  bind ns "value" name "current_class_name" to $id
  bind ns "value" name "current_class_decorators" to trim($decorators_text)
  bind ns "value" name "current_class_owner" to parent
}

# ClassSuite carries the class docstring and completes while the class scope
# is still open, so it is where the Class declaration is emitted — for a
# top-level class and a nested one alike, since both bound the same three
# names. `current_class_owner` is bound only by NestedClassHeader; without it
# the class belongs to the file.
on ClassSuite when $scope("value", "current_class") {
  let sym_id = $scope("value", "current_class")
  let name = $scope("value", "current_class_name")
  let decorators = $scope("value", "current_class_decorators")
  let owner = $scope("value", "current_class_owner")
  let from = cond(owner, owner, $file)
  edge declares from from to sym_id attrs obj("name", name, "kind", "Class", "doc", trim($doc), "decorators", decorators)
}

# A class whose whole body is on the header line (`class E: pass`) has no
# suite, so no ClassSuite event fires for it and it has no docstring. The
# inline-body rule is the one that fires in that case, and it is a rule of its
# own precisely so it can carry the declaration.
on ClassInlineBody {
  let sym_id = $scope("value", "current_class")
  let name = $scope("value", "current_class_name")
  let decorators = $scope("value", "current_class_decorators")
  edge declares from $file to sym_id attrs obj("name", name, "kind", "Class", "decorators", decorators)
}

on NestedClassInlineBody {
  let sym_id = $scope("value", "current_class")
  let name = $scope("value", "current_class_name")
  let decorators = $scope("value", "current_class_decorators")
  let owner = $scope("value", "current_class_owner")
  edge declares from owner to sym_id attrs obj("name", name, "kind", "Class", "decorators", decorators)
}

on MethodDef when $scope("value", "current_class") {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, ".", $id)
  let kind = cond($prop_text, "Property", "Method")
  edge declares from parent to sym_id attrs obj("name", $id, "kind", kind, "doc", trim($doc), "decorators", trim($decorators_text))
}

=== resolver
relative_prefixes: ./, ../, /
module_path_style: dot
project_config: pyproject.toml
install_cmd: pip install {name}
build_cmd: pip install -e .
resolve:
  - manifest: pyproject.toml @ project.dependencies
  - manifest: setup.py @ install_requires
  - manifest: requirements.txt @ -
  # A directory with `__init__.py` is a package; the package itself is the
  # target of `from . import x` and `import pkg`, so it is probed first.
  - marker: __init__.py, pyproject.toml, setup.py, requirements.txt
  - ext: .py, .pyi
  - fallback: pip:

=== ignore
# Virtual environments
.venv/
venv/
env/
# Cache
__pycache__/
.pytest_cache/
.mypy_cache/
# Build
dist/
build/
*.egg-info/
