kgf 0.6
language: zig
sources: .zig

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - Zig uses /// for documentation
TOKEN DocComment /\/\/\/(.*)/
TOKEN LineComment /\/\/[^\r\n]*/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"|\\\\[^\r\n]*/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?/

# Builtins
TOKEN Builtin /@[a-zA-Z_][a-zA-Z0-9_]*/

# Keywords
KEYWORD KW_const    /const\b/
KEYWORD KW_var      /var\b/
KEYWORD KW_fn       /fn\b/
KEYWORD KW_pub      /pub\b/
KEYWORD KW_extern   /extern\b/
KEYWORD KW_packed   /packed\b/
KEYWORD KW_export   /export\b/
KEYWORD KW_inline   /inline\b/
KEYWORD KW_comptime /comptime\b/
KEYWORD KW_test     /test\b/
KEYWORD KW_struct   /struct\b/
KEYWORD KW_enum     /enum\b/
KEYWORD KW_union    /union\b/
KEYWORD KW_error    /error\b/
KEYWORD KW_if       /if\b/
KEYWORD KW_else     /else\b/
KEYWORD KW_switch   /switch\b/
KEYWORD KW_while    /while\b/
KEYWORD KW_for      /for\b/
KEYWORD KW_return   /return\b/
KEYWORD KW_defer    /defer\b/
KEYWORD KW_try      /try\b/
KEYWORD KW_catch    /catch\b/
KEYWORD KW_orelse   /orelse\b/
KEYWORD KW_anytype  /anytype\b/
KEYWORD KW_volatile /volatile\b/
KEYWORD KW_align    /align\b/

# Built-in types
TOKEN KeywordType /\b(?:void|bool|noreturn|type|anyerror|anytype|anyframe|anyopaque|null|undefined|true|false)\b/
TOKEN PrimitiveType /\b(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f16|f32|f64|f80|f128|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|comptime_int|comptime_float)\b/

# Identifiers
TOKEN TypeIdent /[A-Z][a-zA-Z0-9_]*/
TOKEN Ident /[a-z_][a-zA-Z0-9_]*/

# Operators.
# EQ is defined before Operator so a lone `=` is EQ; Operator would
# otherwise win (first match) and no declaration rule could see an `=`.
TOKEN ARROW   /=>/
TOKEN EQ      /=(?![=>])/
TOKEN Operator /[+\-*\/%&|^~!<>=]+|\+\+|--|\.\.\.|\.\.|\.?\*|\+%|-%-|-%|\*%|<<%|>>%/

# Punctuation
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/

=== grammar
Module -> Item*

Item -> NL
     / StructDecl
     / EnumDecl
     / UnionDecl
     / FnDecl
     / ConstDecl
     / VarDecl
     / TestDecl
     / DocComment
     / Other

# A declared name: Zig has no case rule, so both identifier tokens qualify.
Name -> Ident / TypeIdent

# Doc block
DocBlock -> DocComment ( NL DocComment )*

# Const declaration
ConstDecl -> doc:DocBlock? NL? vis:KW_pub? KW_comptime? KW_const id:Name ( COLON Type )? EQ Expr SEMI

# Var declaration
VarDecl -> doc:DocBlock? NL? vis:KW_pub? KW_var id:Name ( COLON Type )? EQ Expr SEMI

# Function declaration
FnDecl -> doc:DocBlock? NL? vis:KW_pub? KW_export? KW_extern? KW_inline? KW_fn id:Name LPAREN ParamList? RPAREN ( Type )? Body?
ParamList -> Param ( COMMA Param )*
Param -> KW_comptime? param_id:Name COLON ( KW_anytype / Type )

# Struct declaration.
#
# The header is a rule of its own so that it fires BEFORE the body: PEG matches
# it to completion first, so its event -- and the `scope push` in its semantics
# -- precedes every member event of the body. That frame is what attaches each
# field and nested type to the container it belongs to; without it the member
# rules read a `current_struct` / `current_enum` that nothing ever bound, and
# no field or enum value was declared at all.
StructDecl -> StructHeader StructBody SEMI?
StructHeader -> doc:DocBlock? NL? vis:KW_pub? KW_const id:Name EQ KW_extern? KW_packed? KW_struct
StructBody -> LBRACE StructMember* RBRACE
StructMember -> StructDecl / EnumDecl / UnionDecl / FnDecl / ConstDecl / VarDecl / FieldDecl / NL / LineComment / DocComment
FieldDecl -> field_doc:DocBlock? field_id:Name COLON Type ( EQ Expr )? COMMA?
# KW_packed is defined in lex section

# Enum declaration -- same header/body split.
EnumDecl -> EnumHeader EnumBody SEMI?
EnumHeader -> doc:DocBlock? NL? vis:KW_pub? KW_const id:Name EQ KW_enum
EnumBody -> LBRACE EnumMember* RBRACE
EnumMember -> value_doc:DocBlock? value_id:Name ( EQ Expr )? COMMA? / NL / LineComment

# Union declaration -- same header/body split.
UnionDecl -> UnionHeader UnionBody SEMI?
UnionHeader -> doc:DocBlock? NL? vis:KW_pub? KW_const id:Name EQ KW_extern? KW_union
UnionBody -> LBRACE UnionMember* RBRACE
UnionMember -> field_doc:DocBlock? field_id:Name COLON Type COMMA? / NL / LineComment

# Test declaration
TestDecl -> KW_test String Body

# Types
Type -> TypeAtom ( Operator TypeAtom )*
# A pointer/slice/array prefix may carry qualifiers: `[]const u8`, `[]u8`,
# `[N]T`, `*const T`, `?*T`. The qualifiers are keywords, not expressions,
# so they need their own rule rather than being squeezed into Expr.
TypeAtom -> PrimitiveType / KeywordType / TypeIdent / Ident
         / LBRACKET Expr? RBRACKET TypeQual* Type
         / Operator TypeQual* Type
TypeQual -> KW_const / KW_volatile / KW_align

# Body (simplified - balance braces)
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / Atom

# Expressions
Expr -> ( ExprAtom / LBRACE Expr? RBRACE / LBRACKET Expr? RBRACKET )+
ExprAtom -> Ident / TypeIdent / Number / String / Char / PrimitiveType / KeywordType / Builtin / LPAREN / RPAREN / DOT / COMMA / COLON / EQ / ARROW / Operator

Atom -> ExprAtom / NL / DocComment / LineComment / KW_volatile / KW_align / KW_anytype / KW_const / KW_var / KW_fn / KW_pub / KW_extern / KW_export / KW_inline / KW_comptime / KW_test / KW_struct / KW_enum / KW_union / KW_error / KW_if / KW_else / KW_switch / KW_while / KW_for / KW_return / KW_defer / KW_try / KW_catch / KW_orelse / SEMI

# Module-level fallback: a balanced bracket group taken as one opaque unit,
# then any single token including a bracket whose partner is missing, so no
# construct can stop the module parse and silently drop later declarations.
Other -> Atom / OpaqueGroup / LBRACE / RBRACE / LBRACKET / RBRACKET / LPAREN / RPAREN
OpaqueGroup -> LBRACE OpaqueInner* RBRACE / LBRACKET OpaqueInner* RBRACKET / LPAREN OpaqueInner* RPAREN
OpaqueInner -> OpaqueGroup / !LPAREN !RPAREN !LBRACE !RBRACE !LBRACKET !RBRACKET Atom

=== attrs
on FnDecl:      def id kind=Function doc=doc
on ConstDecl:   def id kind=Const doc=doc
on VarDecl:     def id kind=Variable doc=doc
on StructHeader: def id kind=Struct doc=doc
on EnumHeader:   def id kind=Enum doc=doc
on UnionHeader:  def id kind=Union doc=doc
on FieldDecl:   def field_id kind=Field doc=field_doc
on EnumMember:  def value_id kind=EnumValue doc=value_doc
on Param:       def param_id kind=Param

=== features
function_kinds: Function
function_keyword: KW_fn
identifier_kinds: Ident, TypeIdent
qualifier_separators: DOT
vocabulary_token_kinds: DocComment, String

=== semantics
# Zig public declarations (vis:KW_pub? in grammar).
#
# In Zig a container body holds methods and constants as well as fields --
# `pub fn complete(self: *Task) void` inside `const Task = struct { ... }` is a
# method of `Task`, not a file-level function. `StructHeader` / `EnumHeader` /
# `UnionHeader` already publish `current_container` for exactly this, and the
# fields read it; these three did not, so every method and container constant
# was declared a second time at file level under a bare name. `outer` is empty
# at the top level, which is what keeps a genuinely file-level declaration on
# the file.
on FnDecl when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Function", "doc", $doc_text)
}
on ConstDecl when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Const", "doc", $doc_text)
}
on VarDecl when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Variable", "doc", $doc_text)
}

# ---------------------------------------------------------------------------
# Enclosing-container frames
# ---------------------------------------------------------------------------
# A `StructMember` may itself be a `StructDecl`, an `EnumDecl` or a
# `UnionDecl`, so the enclosing container behaves like a stack: a field belongs
# to the container whose body it sits in, and a declaration written AFTER that
# body belongs to whatever enclosed it. `scope push` / `scope pop` are that
# stack -- a bind lands in the innermost frame and `$scope` searches frames
# innermost-first, so popping a container's frame re-exposes the one around it.
#
# Events fire bottom-up, so the frame is opened by the HEADER rule, which
# matches before the body is entered, and closed by the declaration rule, which
# fires after the whole body. The container's own `declares` edge is emitted
# from the header BEFORE the push, so `current_container` there still names the
# ENCLOSING container -- which is both the edge's `from` and the prefix of the
# nested container's symbol id, giving `Outer.Inner` rather than a second
# file-level `Inner`.
#
# The push is unconditional even for a non-`pub` container: an unpublished type
# still owns its fields, and the pushes and pops have to stay balanced.
on StructHeader when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Struct", "doc", $doc_text)
}
on StructHeader {
  let outer = $scope("value", "current_container")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_container" to sym_id
  bind ns "value" name "current_struct" to sym_id
}
on EnumHeader when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Enum", "doc", $doc_text)
}
on EnumHeader {
  let outer = $scope("value", "current_container")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_container" to sym_id
  bind ns "value" name "current_enum" to sym_id
}
on UnionHeader when $vis {
  let outer = $scope("value", "current_container")
  edge declares from cond(outer, outer, $file) to concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id) attrs obj("name", $id, "kind", "Union", "doc", $doc_text)
}
on UnionHeader {
  let outer = $scope("value", "current_container")
  let sym_id = concat(cond(outer, outer, $file), cond(outer, ".", "::"), $id)
  scope push
  bind ns "value" name "current_container" to sym_id
  bind ns "value" name "current_struct" to sym_id
}

# A declaration rule fires after its own body, so it closes the frame its
# header opened.
on StructDecl { scope pop }
on EnumDecl { scope pop }
on UnionDecl { scope pop }

# Struct field
on FieldDecl when cond($field_id, $scope("value", "current_struct")) {
  let parent = $scope("value", "current_struct")
  let sym_id = concat(parent, ".", $field_id)
  edge declares from parent to sym_id attrs obj("name", $field_id, "kind", "Field", "doc", $field_doc_text)
}

# Enum value
on EnumMember when cond($value_id, $scope("value", "current_enum")) {
  let parent = $scope("value", "current_enum")
  let sym_id = concat(parent, ".", $value_id)
  edge declares from parent to sym_id attrs obj("name", $value_id, "kind", "EnumValue", "doc", $value_doc_text)
}

=== resolver
relative_prefixes: ./
module_path_style: slash
resolve:
  - manifest: build.zig.zon @ dependencies
  - marker: build.zig.zon, build.zig
  - ext: .zig
  - fallback: zig:
