kgf 0.6
language: cpp
sources: .cpp, .cc, .cxx, .hpp, .hxx, .h, .hh

=== lex
SKIP /[ \t]+/
TOKEN NL /\r?\n/

# Comments - Doxygen uses /** */ and ///
TOKEN DocComment /\/\/\/(.*)/
TOKEN DocBlockComment /\/\*\*([\s\S]*?)\*\//
TOKEN BlockComment /\/\*[\s\S]*?\*\//
TOKEN LineComment /\/\/[^\r\n]*/

# Preprocessor directives
TOKEN Include /#\s*(include|import)\s*[<"][^>"]+[>"]/
# Preprocessor directive. A directive is one logical line, and a backslash
# immediately before the newline continues it onto the next physical line,
# which is how any non-trivial macro is written. Matching only the first
# physical line left the continuation lines to be lexed as ordinary code
# and the trailing backslash matched nothing at all.
TOKEN Preprocessor /#\s*(define|ifdef|ifndef|endif|if|else|elif|undef|pragma|error|warning)([^\\\r\n]|\\[\s\S])*/

# String/char literals
TOKEN String /"([^"\\]|\\.)*"|R"[^(]*\([^)]*\)[^"]*"/
TOKEN Char /'([^'\\]|\\.)*'/

# Numeric literals
TOKEN Number /0x[0-9a-fA-F]+|0b[01]+|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?[fFlLuU]*/

# Keywords
KEYWORD KW_class     /class\b/
KEYWORD KW_struct    /struct\b/
KEYWORD KW_union     /union\b/
KEYWORD KW_enum      /enum\b/
KEYWORD KW_namespace /namespace\b/
KEYWORD KW_template  /template\b/
KEYWORD KW_typename  /typename\b/
KEYWORD KW_public    /public\b/
KEYWORD KW_private   /private\b/
KEYWORD KW_protected /protected\b/
KEYWORD KW_virtual   /virtual\b/
KEYWORD KW_override  /override\b/
KEYWORD KW_final     /final\b/
KEYWORD KW_const     /const\b/
KEYWORD KW_constexpr /constexpr\b/
KEYWORD KW_static    /static\b/
KEYWORD KW_extern    /extern\b/
KEYWORD KW_inline    /inline\b/
KEYWORD KW_using     /using\b/
KEYWORD KW_typedef   /typedef\b/
KEYWORD KW_friend    /friend\b/
KEYWORD KW_explicit  /explicit\b/
KEYWORD KW_if        /if\b/
KEYWORD KW_else      /else\b/
KEYWORD KW_switch    /switch\b/
KEYWORD KW_case      /case\b/
KEYWORD KW_for       /for\b/
KEYWORD KW_while     /while\b/
KEYWORD KW_return    /return\b/
KEYWORD KW_new       /new\b/
KEYWORD KW_delete    /delete\b/
KEYWORD KW_try       /try\b/
KEYWORD KW_catch     /catch\b/
KEYWORD KW_throw     /throw\b/
KEYWORD KW_noexcept  /noexcept\b/
KEYWORD KW_operator  /operator\b/

# Built-in types
TOKEN KeywordType /\b(?:void|int|char|short|long|float|double|bool|wchar_t|char8_t|char16_t|char32_t|signed|unsigned|auto|size_t)\b/

# Built-in values
TOKEN BoolLit /\b(?:true|false)\b/
TOKEN NullLit /\bnullptr\b/
TOKEN ThisLit /\bthis\b/

# Identifiers
TOKEN TypeIdent /[A-Z][a-zA-Z0-9_]*/
TOKEN Ident /[a-z_][a-zA-Z0-9_]*/

# Multi-char operators (before single-char to avoid splitting)
TOKEN ARROW   /->/
TOKEN SCOPE   /::/

# Punctuation (before Operator to avoid : being consumed by Operator)
TOKEN LBRACE   /\{/
TOKEN RBRACE   /\}/
TOKEN LPAREN   /\(/
TOKEN RPAREN   /\)/
TOKEN LBRACKET /\[/
TOKEN RBRACKET /\]/
TOKEN LT       /</
TOKEN GT       />/
TOKEN SEMI     /;/
TOKEN COMMA    /,/
TOKEN DOT      /\./
TOKEN COLON    /:/
TOKEN STAR     /\*/
TOKEN AMP      /&/

# Operators (after punctuation)
TOKEN Operator /[+\-\/%&|^~!<>=?]+|&&|\|\||<<|>>|\.\.\.|<=>|##/

=== grammar
Module -> Item*

Item -> NL
     / Include
     / Preprocessor
     / NamespaceDecl
     / ClassDecl
     / StructDecl
     / UnionDecl
     / EnumDecl
     / OutOfLineCtorDecl
     / FunctionDecl
     / TemplateDecl
     / UsingDecl
     / TypedefDecl
     / VarDecl
     / DocComment
     / DocBlockComment
     / Other

# Name — matches both lowercase and uppercase identifiers
Name -> Ident / TypeIdent

# Doc block
DocBlock -> DocComment ( NL DocComment )*
          / DocBlockComment

# Namespace declaration
# A namespace may carry a Doxygen block like any other declaration, so it
# captures its own doc rather than referencing a label nothing binds.
# The header is a rule of its own so it fires BEFORE the body, which is what
# lets a nested declaration be attributed to the namespace it sits in.
NamespaceDecl -> NamespaceHeader NamespaceBody
NamespaceHeader -> doc:DocBlock? NL? KW_namespace id:Name?
NamespaceBody -> LBRACE NamespaceMember* RBRACE
# A namespace body holds the same constructs as the top level, so it reuses
# Item. The guard keeps the namespace's own closing brace out of the
# member list: without it Item's bracket fallback would consume the `}`
# and NamespaceDecl could never complete.
NamespaceMember -> !RBRACE Item

# Class declaration.
#
# The header is a rule of its own so that it fires BEFORE the body: PEG matches
# it to completion first, so its event -- and the `scope push` in its semantics
# -- precedes every member event of the body. That frame is what attaches each
# method, field and nested type to the type it belongs to; without it the
# member rules read a `current_class` that nothing ever bound, and no method or
# field was declared at all.
ClassDecl -> ClassHeader ClassBody SEMI
ClassHeader -> doc:DocBlock? NL? KW_class id:Name ( KW_final )? InheritanceClause?
InheritanceClause -> COLON AccessSpec? QualifiedName ( COMMA AccessSpec? QualifiedName )*
AccessSpec -> KW_public / KW_private / KW_protected
ClassBody -> LBRACE ClassMember* RBRACE
ClassMember -> AccessLabel / ConstructorDecl / DestructorDecl / MethodDecl / FieldDecl / ClassDecl / StructDecl / EnumDecl / TypedefDecl / UsingDecl / FriendDecl / NL / LineComment / BlockComment
AccessLabel -> AccessSpec COLON

# Struct declaration -- same header/body split. The typedef form names the type
# only AFTER the body, so its trailing name stays on the declaration rule.
StructDecl -> StructTypedefHeader StructBody tag:Name SEMI
            / StructHeader StructBody SEMI
StructTypedefHeader -> doc:DocBlock? NL? KW_typedef KW_struct id:Name?
StructHeader -> doc:DocBlock? NL? KW_struct id:Name ( KW_final )? InheritanceClause?
StructBody -> LBRACE StructMember* RBRACE
StructMember -> AccessLabel / ConstructorDecl / MethodDecl / FieldDecl / NL / LineComment / BlockComment

# Union declaration -- same header/body split.
UnionDecl -> UnionTypedefHeader UnionBody tag:Name SEMI
           / UnionHeader UnionBody SEMI
UnionTypedefHeader -> doc:DocBlock? NL? KW_typedef KW_union id:Name?
UnionHeader -> doc:DocBlock? NL? KW_union id:Name
UnionBody -> LBRACE UnionMember* RBRACE
UnionMember -> field_doc:DocBlock? Type field_id:Name SEMI / NL / LineComment / BlockComment

# Enum declaration -- same header/body split.
EnumDecl -> EnumTypedefHeader EnumBody tag:Name SEMI
          / EnumHeader EnumBody SEMI
EnumTypedefHeader -> doc:DocBlock? NL? KW_typedef KW_enum id:Name?
EnumHeader -> doc:DocBlock? NL? KW_enum ( KW_class / KW_struct )? id:Name ( COLON Type )?
EnumBody -> LBRACE EnumValue* RBRACE
EnumValue -> value_doc:DocBlock? value_id:Name ( Operator Expr )? COMMA? / NL / LineComment / BlockComment

# Constructor/Destructor
ConstructorDecl -> doc:DocBlock? NL? Modifier* id:Name LPAREN ParamList? RPAREN Initializers? ( Body / SEMI )
DestructorDecl -> doc:DocBlock? NL? Modifier* SCOPE? Operator id:Name LPAREN RPAREN Modifier* ( Body / SEMI )
Initializers -> COLON Initializer ( COMMA Initializer )*
Initializer -> Ident LPAREN ( Expr ( COMMA Expr )* )? RPAREN / Ident LBRACE ( Expr ( COMMA Expr )* )? RBRACE

# Method declaration
MethodDecl -> doc:DocBlock? NL? Modifier* Type AMP? method_id:Name LPAREN ParamList? RPAREN Modifier* ( Body / SEMI / Operator Expr SEMI )

# Function declaration.
# Covers both a plain function and an out-of-line member definition, where
# the name is qualified (`Config::load`); owner captures the class so the
# member can be attached to its type rather than to the file.
FunctionDecl -> doc:DocBlock? NL? Modifier* Type AMP? STAR* ( owner:Name SCOPE )* func_id:Name LPAREN ParamList? RPAREN Modifier* Initializers? ( Body / SEMI )

# Out-of-line constructor/destructor definition: `S::S(...) : init(...) {}`.
# It has no return type, so it cannot match FunctionDecl.
OutOfLineCtorDecl -> doc:DocBlock? NL? Modifier* owner:Name SCOPE Operator? ctor_id:Name LPAREN ParamList? RPAREN Modifier* Initializers? ( Body / SEMI )

# Template declaration
TemplateDecl -> doc:DocBlock? NL? KW_template LT TemplateParams GT ( ClassDecl / StructDecl / FunctionDecl )
TemplateParams -> TemplateParam ( COMMA TemplateParam )*
TemplateParam -> ( KW_typename / KW_class ) Ident? / Type Ident?

# Field declaration
FieldDecl -> doc:DocBlock? NL? Modifier* Type AMP? field_id:Name ArrayDims? ( Operator Expr )? SEMI

# Variable declaration
VarDecl -> doc:DocBlock? NL? Modifier* Type AMP? var_id:Name ArrayDims? ( Operator Expr )? SEMI

# Using declaration
UsingDecl -> KW_using ( KW_namespace QualifiedName / id:Name Operator Type / QualifiedName ) SEMI

# Typedef declaration
TypedefDecl -> doc:DocBlock? NL? KW_typedef Type id:Name SEMI

# Friend declaration
FriendDecl -> KW_friend ( KW_class Ident / Type Ident LPAREN ParamList? RPAREN ) SEMI

# Modifiers
Modifier -> KW_const / KW_constexpr / KW_static / KW_extern / KW_inline / KW_virtual / KW_override / KW_final / KW_explicit / KW_noexcept

# Parameters
ParamList -> Param ( COMMA Param )*
Param -> Type AMP? STAR* param_id:Name? ArrayDims? ( Operator Expr )?
ArrayDims -> ( LBRACKET ArraySize? RBRACKET )+
ArraySize -> ( Ident / TypeIdent / Number / Operator / STAR )+

# Types
Type -> TypeQual* TypeAtom STAR* AMP*
TypeQual -> KW_const
TypeAtom -> QualifiedName TemplateArgs? / KeywordType+
QualifiedName -> ( SCOPE )? Name ( SCOPE Name )*
TemplateArgs -> LT Type ( COMMA Type )* GT

# Body (simplified - balance braces)
Body -> LBRACE BodyContent* RBRACE
BodyContent -> LBRACE BodyContent* RBRACE / LPAREN BodyContent* RPAREN / LBRACKET BodyContent* RBRACKET / Atom

# Expressions
Expr -> ( ExprAtom / LPAREN Expr? RPAREN / LBRACKET Expr? RBRACKET )+
ExprAtom -> Ident / TypeIdent / Number / String / Char / BoolLit / NullLit / ThisLit / KeywordType / DOT / COMMA / COLON / SCOPE / ARROW / LT / GT / STAR / AMP / Operator

Atom -> ExprAtom / NL / DocComment / DocBlockComment / LineComment / BlockComment / Include / Preprocessor / KW_class / KW_struct / KW_union / KW_enum / KW_namespace / KW_template / KW_typename / KW_public / KW_private / KW_protected / KW_virtual / KW_override / KW_final / KW_const / KW_constexpr / KW_static / KW_extern / KW_inline / KW_using / KW_typedef / KW_friend / KW_explicit / KW_if / KW_else / KW_switch / KW_case / KW_for / KW_while / KW_return / KW_new / KW_delete / KW_try / KW_catch / KW_throw / KW_noexcept / KW_operator / SEMI

# Module-level fallback: a balanced bracket group taken as one opaque unit,
# then any single token including a bracket whose partner is missing, so no
# construct can stop the module parse and silently drop later declarations.
Other -> Atom / OpaqueGroup / LBRACE / RBRACE / LBRACKET / RBRACKET / LPAREN / RPAREN
OpaqueGroup -> LBRACE OpaqueInner* RBRACE / LBRACKET OpaqueInner* RBRACKET / LPAREN OpaqueInner* RPAREN
OpaqueInner -> OpaqueGroup / !LPAREN !RPAREN !LBRACE !RBRACE !LBRACKET !RBRACKET Atom

=== attrs
on ClassHeader:     def id kind=Class doc=doc
on StructHeader:    def id kind=Struct doc=doc
on UnionHeader:     def id kind=Union doc=doc
on EnumHeader:      def id kind=Enum doc=doc
on NamespaceHeader: def id kind=Namespace doc=doc
on FunctionDecl:    def func_id kind=Function doc=doc
on MethodDecl:      def method_id kind=Method doc=doc
on ConstructorDecl: def id kind=Constructor doc=doc
on FieldDecl:       def field_id kind=Field doc=doc
on VarDecl:         def var_id kind=Variable doc=doc
on TypedefDecl:     def id kind=Typedef doc=doc
on EnumValue:       def value_id kind=EnumValue doc=value_doc
on Param:           def param_id kind=Param

=== features
function_kinds: Function
identifier_kinds: Ident, TypeIdent
qualifier_separators: DOT, SCOPE, ARROW
vocabulary_token_kinds: DocComment, DocBlockComment, String

=== semantics
# ---------------------------------------------------------------------------
# Enclosing-scope frames
# ---------------------------------------------------------------------------
# C++ nests: a `ClassMember` may itself be a `ClassDecl`, a `StructDecl` or an
# `EnumDecl`, and a namespace body holds the whole top level again. So the
# enclosing scope behaves like a stack: a member belongs to the type or
# namespace whose body it sits in, and a declaration written AFTER that body
# belongs to whatever enclosed it. `scope push` / `scope pop` are that stack --
# a bind lands in the innermost frame and `$scope` searches frames
# innermost-first, so popping a body's frame re-exposes the one around it.
#
# Events fire bottom-up, so the frame is opened by the HEADER rule, which
# matches before the body is entered, and closed by the declaration rule, which
# fires after the whole body. The declaration's own `declares` edge is emitted
# from the header BEFORE the push, so `current_scope` there still names the
# ENCLOSING scope -- which is both the edge's `from` and the prefix of the
# nested declaration's symbol id, giving `Outer::Inner` rather than a second
# file-level `Inner`.
#
# `current_class` is what the member rules read, and it is bound only by a
# type header, never by a namespace: a namespace holds declarations, not
# members, so a function inside one stays a Function.
on NamespaceHeader when $id {
  let outer = $scope("value", "current_scope")
  let sym_id = concat(cond(outer, outer, $file), "::", $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Namespace", "doc", $doc_text)
  scope push
  bind ns "value" name "current_scope" to sym_id
} else {
  # An anonymous namespace still opens a body, so it opens a transparent frame:
  # it binds nothing, `$scope` falls through to whatever encloses it, and the
  # pushes and pops stay balanced.
  scope push
}
on NamespaceDecl { scope pop }

on ClassHeader {
  let outer = $scope("value", "current_scope")
  let sym_id = concat(cond(outer, outer, $file), "::", $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Class", "doc", $doc_text)
  scope push
  bind ns "value" name "current_scope" to sym_id
  bind ns "value" name "current_class" to sym_id
}
on StructHeader {
  let outer = $scope("value", "current_scope")
  let sym_id = concat(cond(outer, outer, $file), "::", $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Struct", "doc", $doc_text)
  scope push
  bind ns "value" name "current_scope" to sym_id
  bind ns "value" name "current_class" to sym_id
}
on UnionHeader {
  let outer = $scope("value", "current_scope")
  let sym_id = concat(cond(outer, outer, $file), "::", $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Union", "doc", $doc_text)
  scope push
  bind ns "value" name "current_scope" to sym_id
  bind ns "value" name "current_class" to sym_id
}
on EnumHeader {
  let outer = $scope("value", "current_scope")
  let sym_id = concat(cond(outer, outer, $file), "::", $id)
  edge declares from cond(outer, outer, $file) to sym_id attrs obj("name", $id, "kind", "Enum", "doc", $doc_text)
  scope push
  bind ns "value" name "current_enum" to sym_id
}

# The typedef forms name the type only AFTER the body, so their header binds
# nothing and the declaration rule publishes the trailing name. The members of
# such a body are unreachable either way: nothing names the type until the body
# is over.
on StructTypedefHeader {
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
on UnionTypedefHeader {
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
on EnumTypedefHeader {
  scope push
  bind ns "value" name "pending_doc" to $doc_text
}
on StructDecl when $tag {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Struct", "doc", $scope("value", "pending_doc"))
}
on UnionDecl when $tag {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Union", "doc", $scope("value", "pending_doc"))
}
on EnumDecl when $tag {
  edge declares from $file to concat($file, "::", $tag) attrs obj("name", $tag, "kind", "Enum", "doc", $scope("value", "pending_doc"))
}

# A declaration rule fires after its own body, so it closes the frame its
# header opened.
on ClassDecl { scope pop }
on StructDecl { scope pop }
on UnionDecl { scope pop }
on EnumDecl { scope pop }
on FunctionDecl {
  edge declares from $file to concat($file, "::", $func_id) attrs obj("name", $func_id, "kind", "Function", "doc", $doc_text)
}
on VarDecl {
  edge declares from $file to concat($file, "::", $var_id) attrs obj("name", $var_id, "kind", "Variable", "doc", $doc_text)
}
on TypedefDecl {
  edge declares from $file to concat($file, "::", $id) attrs obj("name", $id, "kind", "Typedef", "doc", $doc_text)
}


# Method in class
on MethodDecl when cond($method_id, $scope("value", "current_class")) {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, "::", $method_id)
  edge declares from parent to sym_id attrs obj("name", $method_id, "kind", "Method", "doc", $doc_text)
}

# Constructor
on ConstructorDecl when cond($id, $scope("value", "current_class")) {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, "::", $id)
  edge declares from parent to sym_id attrs obj("name", $id, "kind", "Constructor", "doc", $doc_text)
}

# Field in class
on FieldDecl when cond($field_id, $scope("value", "current_class")) {
  let parent = $scope("value", "current_class")
  let sym_id = concat(parent, "::", $field_id)
  edge declares from parent to sym_id attrs obj("name", $field_id, "kind", "Field", "doc", $doc_text)
}

# Enum value
on EnumValue when cond($value_id, $scope("value", "current_enum")) {
  let parent = $scope("value", "current_enum")
  let sym_id = concat(parent, "::", $value_id)
  edge declares from parent to sym_id attrs obj("name", $value_id, "kind", "EnumValue", "doc", $value_doc_text)
}

=== resolver
relative_prefixes: ./, ../
module_path_style: slash
resolve:
  - ext: .hpp, .hxx, .h, .hh, .cpp, .cc, .cxx
  - fallback: system:
