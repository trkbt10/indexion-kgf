kgf 0.6
language: cargo-toml
sources: Cargo.toml

# KGF spec for Rust Cargo.toml manifest files.
#
# Structure: a Cargo.toml is an ordinary TOML document, so the backbone here is
# generic TOML — a document is a preamble of key/value lines followed by tables,
# and every table (known or not) is a header plus a run of key/value lines. The
# Cargo-specific behaviour is layered on top by *classifying the table header*
# in the semantics rather than by giving each interesting table its own grammar
# rule. That keeps real-world manifests parsing whole: `[lib]`, `[[bin]]`,
# `[profile.release]`, `[target.'cfg(unix)'.dependencies]` and any future table
# are all just tables.
#
# Emits: projectName, projectVersion, projectDescription, projectLicense,
# projectRepository, projectKeyword, dependsOn.

=== lex
SKIP        /[ \t]+/
TOKEN NL            /\r?\n/
TOKEN Comment       /#[^\r\n]*/

# Table headers. These are anchored to the start of a line with `^` (which
# matches at the start of the input or just after a newline). The anchor is
# essential, not cosmetic: without it a bracketed array *value* such as
# `keywords = ["cli", "tool"]` lexes as a TableHeader, because a context-free
# lexer cannot otherwise tell `[...]` as a header from `[...]` as an array.
# A TOML table header is by definition the first thing on its line, so the
# anchor is exactly the distinguishing fact.
#
# `[[array.of.tables]]` must precede `[table]` so the double-bracket form is
# not mis-lexed as a table whose name starts with a bracket. The header body
# accepts anything but a newline or a closing bracket, which covers quoted and
# dotted table keys such as `[target.'cfg(windows)'.dependencies]`.
TOKEN ArrayTableHeader /^\[\[[^\]\r\n]*\]\]/
TOKEN TableHeader      /^\[[^\]\r\n]*\]/

# Values. MultiString must precede StringLit so `"""..."""` is not lexed as an
# empty string followed by stray content.
TOKEN MultiString   /"""[\s\S]*?"""|'''[\s\S]*?'''/
TOKEN StringLit     /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/
TOKEN DateTime      /[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})?)?/
TOKEN NumberLit     /[+-]?(?:0[xXoObB][0-9a-fA-F_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?|inf|nan)/
KEYWORD KW_true       /true\b/
KEYWORD KW_false      /false\b/

# Punctuation
TOKEN EQUALS        /=/
TOKEN LBRACE        /\{/
TOKEN RBRACE        /\}/
TOKEN LBRACKET      /\[/
TOKEN RBRACKET      /\]/
TOKEN COMMA         /,/
TOKEN DOT           /\./

# Bare keys. TOML bare keys are letters, digits, underscore and hyphen; Cargo
# uses hyphenated keys (`dev-dependencies`, `default-features`) constantly.
#
# NOTE: there are deliberately NO keyword tokens for key names such as `name`
# or `version`. The lexer matches first-in-definition-order and has no context,
# so a KEYWORD `name` would turn *every* key called `name` into KW_name —
# including the one in `[lib]`, in `[[bin]]`, and inside an inline table —
# and every generic key/value rule would then fail on it. Which keys are
# interesting is a semantic question, decided in the semantics section by
# comparing the key text, not a lexical one.
TOKEN Key           /[A-Za-z0-9_-]+/

=== grammar
TomlFile     -> Preamble Table*

# Key/value lines before the first table header belong to the document root.
Preamble     -> Line*

# A table is its header plus every line up to the next header. This single
# rule covers [package], [dependencies], [lib], [[bin]], [profile.release]
# and anything else, so an unknown table is still parsed as a table.
#
# The header is a rule of its own (TableMark) rather than a label on Table,
# because events fire bottom-up: a Table's event arrives *after* the Pair
# events of its own lines, so a label on Table could never tell those Pairs
# which table they are in. TableMark fires before them and publishes the
# header into scope, which is exactly the "declare before the body" pattern.
Table        -> TableMark Line*
TableMark    -> header:TableHeader / header:ArrayTableHeader

Line         -> Pair / NL / Comment

# A key/value pair. The key may be dotted (`version.workspace = true`,
# `package.edition`), so it is a dotted path; `$key_text` is the whole path.
#
# KeyPath is matched (and so fires) before the value, which is what lets an
# array element know which key it belongs to: KeyPath publishes the key into
# scope, and ArrayItem reads it. Without that, bottom-up ordering would give
# the elements of `keywords = [...]` no way to distinguish themselves from
# the elements of `members = [...]`.
Pair         -> key:KeyPath EQUALS value:Value

KeyPath      -> key:KeySeg ( DOT key:KeySeg )*
KeySeg       -> Key / StringLit / NumberLit / KW_true / KW_false

# A value is a scalar, an inline table, or an array. Arrays and inline tables
# routinely span lines in real manifests (`members = [\n  "a",\n]`), so both
# allow newline/comment runs anywhere inside via Sep.
Value        -> Scalar / InlineTable / ArrayValue

Scalar       -> MultiString / StringLit / DateTime / NumberLit / KW_true / KW_false

ArrayValue   -> LBRACKET Sep* ( ArrayItem Sep* ( COMMA Sep* ArrayItem Sep* )* ( COMMA Sep* )? )? RBRACKET
# Array elements are a rule of their own so `keywords = ["a", "b"]` yields one
# event per element; the semantics turn those into projectKeyword edges when
# the enclosing pair is the [package] keywords list.
ArrayItem    -> value:Value
# The entries of an inline table are InlineEntry, NOT Pair. They must not fire
# the Pair event: `clap = { version = "4.0", features = ["derive"] }` contains
# the pairs `version` and `features`, and if those were Pair events they would
# each be reported as a dependency of the enclosing [dependencies] table (and
# `version` inside [package] would be read as the crate version). An inline
# table's contents describe the *value* of its pair, not new pairs.
InlineTable  -> LBRACE Sep* ( InlineEntry Sep* ( COMMA Sep* InlineEntry Sep* )* ( COMMA Sep* )? )? RBRACE
InlineEntry  -> InlineKey EQUALS InlineVal
InlineKey    -> KeySeg ( DOT KeySeg )*
InlineVal    -> Scalar / InlineTable / InlineArray
InlineArray  -> LBRACKET Sep* ( InlineVal Sep* ( COMMA Sep* InlineVal Sep* )* ( COMMA Sep* )? )? RBRACKET
Sep          -> NL / Comment

=== attrs
on TableMark: note fieldKey payload=header
on Pair:  note fieldKey payload=key

=== semantics
# `Value` is `Scalar / InlineTable / ArrayValue`, so it can span many tokens
# and the bare `$value` keeps only the last one — for an inline table that is
# the closing brace. Every read below is of a scalar in practice, where the
# accumulated `$value_text` is the same single token, so reading `_text`
# throughout is both correct for the scalar case and truthful about the rest.
# TableMark fires before the Pair events of the lines it introduces, so the
# current table header is available to every Pair through the scope map.
# `$header` still carries its brackets (e.g. "[dev-dependencies]"), which is
# what the containsStr tests below match against.
on TableMark {
  bind ns "value" name "table" to $header
}

# Publish the key currently being read, for the array elements of its value.
on KeyPath {
  bind ns "value" name "key" to $_text
}

# Project metadata, valid only inside `[package]`. Gating on the table header
# is what keeps `[lib] name = "example_cli"` and `[[bin]] name = "example-cli"`
# from overwriting the crate name, and `[dependencies] version = ...` out of
# projectVersion — the exact confusion that the old keyword tokens invited.
#
# `when` takes one expression and there is no infix `and`, so a two-part guard
# is a nested cond(): cond(A, B, "") is true only when A and B both are.
on Pair when cond(eq($scope("value", "table"), "[package]"), eq($key_text, "name"), "") {
  edge projectName from $file to stripQuotes($value_text) attrs obj("raw", $value_text)
}
on Pair when cond(eq($scope("value", "table"), "[package]"), eq($key_text, "version"), "") {
  edge projectVersion from $file to stripQuotes($value_text) attrs obj("raw", $value_text)
}
on Pair when cond(eq($scope("value", "table"), "[package]"), eq($key_text, "description"), "") {
  edge projectDescription from $file to stripQuotes($value_text)
}
on Pair when cond(eq($scope("value", "table"), "[package]"), eq($key_text, "license"), "") {
  edge projectLicense from $file to stripQuotes($value_text)
}
on Pair when cond(eq($scope("value", "table"), "[package]"), eq($key_text, "repository"), "") {
  edge projectRepository from $file to stripQuotes($value_text)
}

# `keywords = ["a", "b", "c"]` in [package]: one edge per array element,
# recognised by the key that KeyPath published before the array was walked.
on ArrayItem when cond(eq($scope("value", "table"), "[package]"), eq($scope("value", "key"), "keywords"), "") {
  edge projectKeyword from $file to stripQuotes($value_text)
}

# Dependencies. Every table whose header ends in `dependencies]` is a
# dependency table: [dependencies], [dev-dependencies], [build-dependencies],
# [workspace.dependencies] and [target.'cfg(unix)'.dependencies] all qualify.
# The dependency name is the key; its value may be a version string or an
# inline table, and neither is inspected here beyond recording the entry.
#
# `dep_kind` distinguishes the dev/build tables from the runtime one so
# consumers can filter; previously every entry was reported as "runtime".
# The crate name is the FIRST segment of the key path: `tracing.workspace =
# true` is the crate `tracing` inheriting the workspace entry, not a crate
# called "tracing.workspace". A plain `serde = "1.0"` has no dot, and
# beforeFirst returns it unchanged.
on Pair when containsStr($scope("value", "table"), "dependencies]") {
  let crate_name = beforeFirst($key_text, ".")
  let table = $scope("value", "table")
  let kind = cond(containsStr(table, "dev-dependencies]"), "dev", cond(containsStr(table, "build-dependencies]"), "build", "runtime"))
  edge dependsOn from $file to concat("crate:", crate_name) attrs obj("dep_kind", kind)
}

=== features
content_type: config
manifest_role: package
identity_edge: projectName
# Cargo convention: sources live under `src/` relative to the Cargo.toml.
# Enrichment uses this to map internal use paths (e.g. `crate::cli`, or a
# re-export `use cli::Cli` that turns out to be a sibling module) back to
# on-disk files such as `<root>/src/cli.rs`.
source_dir_default: src

=== resolver
relative_prefixes:
exts: .toml
indexes:
bare_prefix: crate:
module_path_style: double_colon
