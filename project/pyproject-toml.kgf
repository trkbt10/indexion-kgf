kgf 0.6
language: pyproject-toml
sources: pyproject.toml

# KGF spec for Python pyproject.toml manifest files.
#
# A pyproject.toml is an ordinary TOML document, so the backbone here is
# generic TOML — a document is a preamble of key/value lines followed by
# tables, and every table (known or not) is a header plus a run of key/value
# lines. The Python meaning is layered on top by classifying the table header
# and key in the semantics rather than by giving each interesting table and
# field its own grammar rule.
#
# That matters because the interesting tables are open-ended: [project],
# [build-system], [tool.ruff], [tool.hatch.build.targets.wheel],
# [project.optional-dependencies], [dependency-groups] and whatever the next
# tool adds are all just tables.
#
# Emits: projectName, projectVersion, projectDescription, projectLicense,
# projectKeyword, dependsOn.

=== lex
SKIP        /[ \t]+/
TOKEN NL            /\r?\n/
TOKEN Comment       /#[^\r\n]*/

# Table headers, anchored to the start of a line with `^` (which matches at
# the start of the input or just after a newline). The anchor is essential:
# without it a bracketed array VALUE such as `keywords = ["api", "sdk"]` lexes
# as a table header, because a context-free lexer cannot otherwise tell
# `[...]` as a header from `[...]` as an array.
TOKEN ArrayTableHeader /^\[\[[^\]\r\n]*\]\]/
TOKEN TableHeader      /^\[[^\]\r\n]*\]/

# Values. MultiString must precede StringLit so `"""..."""` is not lexed as
# an empty string followed by stray content. A long description written as a
# multi-line string is common in pyproject.toml.
TOKEN MultiString   /"""[\s\S]*?"""|'''[\s\S]*?'''/
TOKEN StringLit     /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/
TOKEN DateTime      /[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})?)?/
TOKEN NumberLit     /[+-]?(?:0[xXoObB][0-9a-fA-F_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?|inf\b|nan\b)/
KEYWORD KW_true       /true\b/
KEYWORD KW_false      /false\b/

# Punctuation
TOKEN EQUALS        /=/
TOKEN LBRACE        /\{/
TOKEN RBRACE        /\}/
TOKEN LBRACKET      /\[/
TOKEN RBRACKET      /\]/
TOKEN COMMA         /,/
TOKEN DOT           /\./

# Bare keys. Python packaging uses hyphenated keys constantly
# (`requires-python`, `build-backend`, `optional-dependencies`).
#
# NOTE: there are deliberately NO keyword tokens for key names such as `name`
# or `version`. The lexer matches first-in-definition-order and has no
# context, so a KEYWORD `name` would turn EVERY key called `name` into
# KW_name — including the one inside an author's inline table
# (`{ name = "...", email = "..." }`) — and every generic key/value rule
# would then fail on it. Which keys are interesting is a semantic question,
# decided in the semantics by comparing the key text.
TOKEN Key           /[A-Za-z0-9_-]+/

=== grammar
TomlFile     -> Preamble Table*

# Key/value lines before the first table header belong to the document root.
Preamble     -> Line*

# A table is its header plus every line up to the next header. This single
# rule covers [project], [build-system], [tool.ruff] and anything else, so an
# unknown table is still parsed as a table.
#
# The header is a rule of its own (TableMark) rather than a label on Table,
# because events fire bottom-up: a Table's event arrives AFTER the Pair
# events of its own lines, so a label on Table could never tell those Pairs
# which table they are in. TableMark fires before them and publishes the
# header into scope.
Table        -> TableMark Line*
TableMark    -> header:TableHeader / header:ArrayTableHeader

Line         -> Pair / NL / Comment

# A key/value pair. The key may be dotted (`tool.ruff.line-length = 100`).
#
# KeyPath is matched (and so fires) before the value, which is what lets an
# array element know which key it belongs to: KeyPath publishes the key into
# scope, and ArrayItem reads it. Without that, bottom-up ordering would give
# the elements of `keywords = [...]` no way to distinguish themselves from
# the elements of `dependencies = [...]`.
Pair         -> key:KeyPath EQUALS value:Value

KeyPath      -> key:KeySeg ( DOT key:KeySeg )*
KeySeg       -> Key / StringLit / NumberLit / KW_true / KW_false

# A value is a scalar, an inline table, or an array. Arrays and inline tables
# routinely span lines in real manifests, so both allow newline/comment runs
# anywhere inside via Sep.
Value        -> Scalar / InlineTable / ArrayValue

Scalar       -> MultiString / StringLit / DateTime / NumberLit / KW_true / KW_false

ArrayValue   -> LBRACKET Sep* ( ArrayItem Sep* ( COMMA Sep* ArrayItem Sep* )* ( COMMA Sep* )? )? RBRACKET
# Array elements are a rule of their own so `dependencies = [...]` yields one
# event per element.
ArrayItem    -> value:Value

# The entries of an inline table are InlineEntry, NOT Pair. They must not fire
# the Pair event: `{ name = "Example Inc", email = "dev@example.com" }` in the
# authors list contains the key `name`, and if that were a Pair event it would
# be read as the project's own name.
InlineTable  -> LBRACE Sep* ( InlineEntry Sep* ( COMMA Sep* InlineEntry Sep* )* ( COMMA Sep* )? )? RBRACE
InlineEntry  -> InlineKey EQUALS InlineVal
InlineKey    -> KeySeg ( DOT KeySeg )*
InlineVal    -> Scalar / InlineTable / InlineArray
InlineArray  -> LBRACKET Sep* ( InlineVal Sep* ( COMMA Sep* InlineVal Sep* )* ( COMMA Sep* )? )? RBRACKET
Sep          -> NL / Comment

=== attrs
on TableMark: note fieldKey payload=header
on Pair:      note fieldKey payload=key

=== semantics
# TableMark fires before the Pair events of the lines it introduces, so the
# current table header is available to every Pair through the scope map.
# `$header` keeps its brackets (e.g. "[project]").
on TableMark {
  bind ns "value" name "table" to $header
}

# Publish the key currently being read, for the array elements of its value.
on KeyPath {
  bind ns "value" name "key" to $_text
}

# Project metadata, valid only inside `[project]`. Gating on the table header
# keeps `[tool.poetry] name = ...` and the `name` of an author's inline table
# out of projectName.
#
# `when` takes one expression and there is no infix `and`, so a two-part guard
# is a nested cond(): cond(A, B, "") is true only when A and B both are.
on Pair when cond(eq($scope("value", "table"), "[project]"), eq($key_text, "name"), "") {
  edge projectName from $file to stripQuotes($value) attrs obj("raw", $value)
}
on Pair when cond(eq($scope("value", "table"), "[project]"), eq($key_text, "version"), "") {
  edge projectVersion from $file to stripQuotes($value) attrs obj("raw", $value)
}
on Pair when cond(eq($scope("value", "table"), "[project]"), eq($key_text, "description"), "") {
  edge projectDescription from $file to stripQuotes($value)
}
# PEP 621 allows `license` to be a SPDX string (`license = "BSD-3-Clause"`)
# or a table (`license = { file = "LICENSE" }` / `{ text = "..." }`). The
# string form carries the licence identifier and is emitted as-is; the table
# form has no single value here, and its `file`/`text` key is handled by the
# InlineEntry rule below so the reference is still recorded.
#
# The previous spec emitted the literal string "see-file" for BOTH forms, so
# a manifest that plainly stated its licence reported a placeholder instead.
on Pair when cond(eq($scope("value", "table"), "[project]"), eq($key_text, "license"), "") {
  edge projectLicense from $file to stripQuotes($value)
}

# `keywords = ["a", "b"]` in [project]: one edge per array element.
on ArrayItem when cond(eq($scope("value", "table"), "[project]"), eq($scope("value", "key"), "keywords"), "") {
  edge projectKeyword from $file to stripQuotes($value)
}

# `dependencies = ["httpx>=0.25.0", ...]` in [project]. The requirement
# string is kept whole (name plus version specifier), which is what the
# previous spec emitted and what the `pypi:` resolver prefix expects.
on ArrayItem when cond(eq($scope("value", "table"), "[project]"), eq($scope("value", "key"), "dependencies"), "") {
  edge dependsOn from $file to concat("pypi:", stripQuotes($value)) attrs obj("dep_kind", "runtime")
}

# `[project.optional-dependencies]` and `[dependency-groups]` hold named
# extras, each a key whose value is an array of requirement strings. The
# extra's name is the key, so the group is recorded as the dep_kind.
on ArrayItem when eq($scope("value", "table"), "[project.optional-dependencies]") {
  edge dependsOn from $file to concat("pypi:", stripQuotes($value)) attrs obj("dep_kind", $scope("value", "key"))
}
on ArrayItem when eq($scope("value", "table"), "[dependency-groups]") {
  edge dependsOn from $file to concat("pypi:", stripQuotes($value)) attrs obj("dep_kind", $scope("value", "key"))
}

=== features
content_type: config
manifest_role: project
identity_edge: projectName

=== resolver
relative_prefixes:
exts: .toml
indexes:
bare_prefix: pypi:
module_path_style: dot
