kgf 0.6
language: build-gradle-kts
sources: build.gradle.kts

# KGF spec for Kotlin Gradle build scripts (build.gradle.kts).
#
# A build.gradle.kts is a Kotlin program, so enumerating the block names that
# happen to appear in one sample cannot work — the next script uses different
# ones. The backbone here is generic Kotlin-ish script structure: a script is
# a sequence of statements; a statement is a (possibly dotted, possibly
# generic, possibly parenthesised) call that may be followed by a trailing
# lambda block; blocks nest. The Gradle meaning is layered on top by matching
# the *call name* in the semantics.
#
# Emits: projectGroup, projectVersion, dependsOn.

=== lex
SKIP        /[ \t]+/
TOKEN NL            /\r?\n/
TOKEN Comment       /\/\/[^\r\n]*/
TOKEN BlockComment  /\/\*[\s\S]*?\*\//

# Keywords. Only `version`, used infix in `id("x") version "1.0"`, needs to be
# distinguishable, and only because the plugin DSL writes it without a dot.
#
# NOTE: `plugins`, `dependencies`, `repositories`, `kotlin`, `tasks`,
# `implementation` and the rest are NOT keywords. They are ordinary method
# names; a KEYWORD for each one means every block whose name is not on the
# list fails to parse, which is what stopped this file at `tasks.withType`.
# Which call is interesting is decided in the semantics, from the call name.
KEYWORD KW_version    /version\b/
KEYWORD KW_val        /val\b/
KEYWORD KW_true       /true\b/
KEYWORD KW_false      /false\b/

# Literals. The raw (triple-quoted) form must precede the ordinary one.
TOKEN RawString     /"""[\s\S]*?"""/
TOKEN StringLit     /"([^"\\]|\\.)*"/
TOKEN CharLit       /'([^'\\]|\\.)'/
TOKEN NumberLit     /[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9]+)?[fFlLdD]?/

# Punctuation. ARROW precedes the angle brackets so a lambda arrow is not
# split into `=` and `>`.
#
# LANGLE / RANGLE are what `tasks.withType<Test>` needs: the previous spec had
# no token for `<` or `>` at all, so a generic type argument produced two
# "unrecognized input" lexer errors and the statement could not be parsed.
TOKEN ARROW         /->/
TOKEN LPAREN        /\(/
TOKEN RPAREN        /\)/
TOKEN LBRACE        /\{/
TOKEN RBRACE        /\}/
TOKEN LBRACKET      /\[/
TOKEN RBRACKET      /\]/
TOKEN LANGLE        /</
TOKEN RANGLE        />/
TOKEN COMMA         /,/
TOKEN DOT           /\./
TOKEN COLON         /:/
TOKEN EQUALS        /=/
TOKEN Operator      /[!%&*+\-\/?^|~@$]+/

# Identifiers
TOKEN Ident         /[A-Za-z_][A-Za-z0-9_]*/

=== grammar
GradleFile      -> Statement*

# `Other` last: a single token of any kind, so an unfamiliar construct costs
# only itself instead of truncating everything after it.
Statement       -> Assignment / CallStmt
                 / NL / Comment / BlockComment / Other

# `group = "com.example"`, `version = "0.0.1"`, `val x = ...`
Assignment      -> KW_val? target:Name EQUALS value:Expr

# A call statement: a dotted name, optional type arguments, optional argument
# list, optional infix `version "..."`, optional trailing lambda.
#
#   implementation("org:artifact")
#   kotlin("jvm") version "1.9.21"
#   tasks.withType<Test> { ... }
#   repositories { mavenCentral() }
# The first alternative matches a call whose sole argument is one string
# literal, and labels that literal ON CallStmt. The label has to live on this
# rule: a label bound inside a sub-rule (ArgList) stays on that sub-rule's own
# event and is not visible to the parent, so `lit` would never reach the
# semantics if ArgList carried it.
#
# That shape is exactly every Gradle dependency declaration
# (`implementation("org:artifact")`) and the plugin DSL (`id("org.x")`,
# `kotlin("jvm")`). The second alternative is the general call.
CallStmt        -> name:Name TypeArgs? LPAREN Sep* lit:StringLit Sep* RPAREN InfixVersion? Lambda?
                 / name:Name TypeArgs? ArgList? InfixVersion? Lambda?
InfixVersion    -> KW_version value:Expr

# A dotted name. `$name_text` is the whole path and `$name` its last segment,
# so the semantics can match either `implementation` or `tasks.withType`.
Name            -> NameSeg ( DOT NameSeg )*
NameSeg         -> Ident / KW_version / KW_val

# Generic type arguments: `<Test>`, `<Map<String, Int>>`, `<*>`.
TypeArgs        -> LANGLE TypeArgInner* RANGLE
TypeArgInner    -> TypeArgs / Ident / COMMA / DOT / COLON / Operator
                 / KW_version / KW_val / NumberLit / LPAREN / RPAREN

ArgList         -> LPAREN Sep* ( Arg ( Sep* COMMA Sep* Arg )* ( Sep* COMMA )? )? Sep* RPAREN
Arg             -> NamedArg / Expr
NamedArg        -> Ident EQUALS Sep* Expr

# A trailing lambda is a brace block whose body is itself statements, which is
# what makes `dependencies { ... }` and any nested block parse uniformly.
Lambda          -> LBRACE LambdaParams? Statement* RBRACE
LambdaParams    -> Ident ( COMMA Ident )* ARROW

Expr            -> Term ( Sep* ( Operator / DOT / EQUALS ) Sep* Term )*
Term            -> RawString / StringLit / CharLit / NumberLit
                 / KW_true / KW_false
                 / CallStmt / ListLit / Paren
ListLit         -> LBRACKET Sep* ( Expr ( Sep* COMMA Sep* Expr )* ( Sep* COMMA )? )? Sep* RBRACKET
Paren           -> LPAREN Sep* Expr? Sep* RPAREN

Sep             -> NL / Comment / BlockComment

Other           -> RawString / StringLit / CharLit / NumberLit / Ident
                 / KW_version / KW_val / KW_true / KW_false
                 / Operator / ARROW / COMMA / DOT / COLON / EQUALS
                 / LANGLE / RANGLE
                 / LPAREN / RPAREN / LBRACE / RBRACE / LBRACKET / RBRACKET

=== attrs
on Assignment: note fieldKey payload=target

=== semantics
# `group = "..."` / `version = "..."` at any level. A build script sets these
# on the project object, so the assignment target name is what identifies them.
#
# `value` is bound to `Expr`, which is `Term ( op Term )*` and so can span
# many tokens; the bare `$value_text` would keep only the last one and turn
# `version = "1.0" + suffix` into `suffix`. `$value_text` is the expression as
# written, and for the ordinary single-literal case it is that same literal.
on Assignment when eq($target_text, "group") {
  edge projectGroup from $file to stripQuotes($value_text) attrs obj("raw", $value_text)
}
on Assignment when eq($target_text, "version") {
  edge projectVersion from $file to stripQuotes($value_text) attrs obj("raw", $value_text)
}

# Dependency declarations. Every Gradle configuration is a method taking the
# dependency notation, so the call name IS the dependency kind: implementation,
# testImplementation, api, compileOnly, runtimeOnly, annotationProcessor,
# ksp, and any custom configuration a build defines. Recording the name as
# `dep_kind` keeps this open-ended instead of enumerating a fixed list — the
# previous spec dropped every configuration it had not been taught.
#
# `$lit` is bound only when the call takes exactly one string literal, which
# is the dependency-notation shape. A call with no arguments
# (`mavenCentral()`), with a block (`repositories { ... }`), or with a version
# catalog accessor (`implementation(libs.spring.boot)`) leaves it unbound and
# produces no edge.
#
# The plugin DSL uses the same shape, so `id("...")` and `kotlin("...")` are
# excluded by name: a plugin is not a dependency of the built artifact. This
# matches the previous spec, which never emitted edges for plugin lines.
on CallStmt when cond($lit, cond(eq($name_text, "id"), "", cond(eq($name_text, "kotlin"), "", "y")), "") {
  edge dependsOn from $file to concat("maven:", stripQuotes($lit)) attrs obj("dep_kind", $name_text)
}

=== features
content_type: config

=== resolver
relative_prefixes:
exts: .gradle.kts
indexes:
bare_prefix: maven:
module_path_style: colon
