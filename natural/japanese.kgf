kgf 0.6
language: japanese
sources: .txt, .md, .text

# mikan.js-style regex-based word segmentation for Japanese text
# Reference: https://github.com/trkbt10/mikan.js

=== lex
SKIP /[ \t　]+/
TOKEN NL /\r?\n+/

# Punctuation: periods, commas, exclamation, question marks
TOKEN Punct /[\.\,。、！\!？\?]+/

# Brackets (opening)
TOKEN BracketOpen /[〈《「『｢（(\[【〔〚〖〘❮❬❪❨(<{❲❰｛❴]/

# Brackets (closing)
TOKEN BracketClose /[〉》」』｣)）\]】〕〗〙〛}>\)❩❫❭❯❱❳❵｝]/

# Japanese particles (joshi) - ordered from longest to shortest for proper matching
TOKEN Joshi /(でなければ|について|かしら|くらい|けれど|なのか|ばかり|ながら|ことよ|こそ|こと|さえ|しか|した|たり|だけ|だに|だの|つつ|ても|てよ|でも|とも|から|など|なり|ので|のに|ほど|まで|もの|やら|より|って|で|と|な|に|ね|の|も|は|ば|へ|や|わ|を|か|が|さ|し|ぞ|て)/

# CJK numerals (must come before Kanji to get priority)
TOKEN CjkNumber /[零一二三四五六七八九十百千万億兆]+/

# Units (for numbers)
TOKEN Unit /(px|point|＄|\$|€|￥|ノット|ユーロ|ドル|円|里|㌫|％|\%|cm|m|km|㌢|㍍|㌖|センチメートル|メートル|キロ|キロメートル|度|ℓ|リットル|mℓ|ミリリットル|マイル|フィート)/

# Arabic numbers
TOKEN Number /[0-9０-９]+/

# Kanji words (excluding CJK numerals - use negative lookahead)
TOKEN Kanji /(?:(?![零一二三四五六七八九十百千万億兆])[\u4e00-\u9fff々〆ヵヶゝ])+/

# Hiragana words (excluding particles which are matched separately)
TOKEN Hiragana /[ぁ-んゝ]+/

# Katakana words
TOKEN Katakana /[ァ-ヴー]+/

# Latin alphanumeric and domains
TOKEN Alnum /[a-zA-Z0-9]+\.[a-z]{2,}|[a-zA-Z0-9]+|[ａ-ｚＡ-Ｚ０-９]+/

# Non-breaking space entity
TOKEN Nbsp /\&nbsp;/

# Catch-all for other characters
TOKEN Other /[^\s\.\,。、！\!？\?〈《「『｢（(\[【〔〚〖〘❮❬❪❨(<{❲❰｛❴〉》」』｣)）\]】〕〗〙〛}>\)❩❫❭❯❱❳❵｝a-zA-Z0-9０-９ａ-ｚＡ-Ｚぁ-んゝァ-ヴー一-龠々〆ヵヶ]+/

=== grammar
Doc  -> Line*
Line -> Segment* NL?

# A segment is one word-ish unit plus the particle and punctuation that
# trail it. Every alternative ends in `Loose`, which accepts any single
# token kind declared in `=== lex` other than NL, so a line that starts with
# a particle (`でも、…`), a bracket or a stray character is still consumed
# and the parse reaches the end of the text. Before that the parse stopped
# at the first such line and every word after it was dropped.
Segment -> BracketOpen Content BracketClose
         / w:Word Joshi? Punct?
         / n:CjkNumber Unit? Punct?
         / n:Number Unit? Punct?
         / Punct
         / Loose

# Quoted speech contains ordinary running text, particles included.
Content -> ( !BracketClose !NL ( Word / Joshi / Punct / CjkNumber / Number
           / Unit / BracketOpen ) )*

# A CJK numeral is a number, not a word: `十` and `10` are the same thing
# written two ways, so both feed the number alternative above. The token was
# defined in `=== lex` but no rule consumed it, which stopped the parse on
# any text containing a CJK numeral.
Word -> Kanji / Hiragana / Katakana / Alnum / Nbsp / Other

Loose -> Joshi / BracketOpen / BracketClose / Unit / CjkNumber / Number
       / Kanji / Hiragana / Katakana / Alnum / Nbsp / Other / Punct

=== attrs
on Segment: def id=w kind=Word
on Segment: def id=n kind=Number

=== features
detection_scope: overlay
# Kinds whose text becomes a vocab term when this spec is invoked from
# `sub_tokenize_vocab_via_kgfs`. Native-script kinds only — Latin/ASCII
# (Alnum) is handled by english.kgf, so listing Alnum here would
# double-count on mixed-language docs. Joshi/Punct/Bracket*/Unit/Nbsp/Other
# are dropped by kind.
content_token_kinds: Kanji, Hiragana, Katakana, Number

=== semantics
on Segment when $scope("value", "last_word") {
  let cur = $scope("value", $w)
  edge nextWord from $scope("value", "last_word") to cur attrs obj("rel", "word->word")
}
on Segment when $w {
  let cur = $scope("value", $w)
  edge contains from $file to cur attrs obj("rel", "file->word")
  bind ns "value" name "last_word" to cur
}
on Segment when $n {
  let cur = $scope("value", $n)
  edge contains from $file to cur attrs obj("rel", "file->number")
  bind ns "value" name "last_word" to cur
}

=== resolver
relative_prefixes: ./, ../
exts: .txt, .md, .text,
indexes:
bare_prefix:
module_path_style: slash
